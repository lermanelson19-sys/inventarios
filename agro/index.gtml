  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  save: '<path d="M5 3h11l3 3v15H5z"/><path d="M8 3v5h7V3M8 21v-7h8v7"/>'
});

/* ---------- Parámetros ---------- */
const ST = ARK.store('agro_inv1_');
const DEF_P = {
  empresa: 'Agrococorollo', nit: '', bodega: 'PV001', bodDesc: 'PUNTO DE VENTA AGROCOCOROLLO',
  clave: '', excluir: 'INAC*, BLOQUEADO, BLOQUEADA, NO USAR', cia: 1, itemLen: 7,
  tolUnd: 0, tolDec: 0.05, difGrande: 300000, r3Crit: 'teo', maxEdits: 3, inactMin: 30,
  co: '001', tipoSal: 'CIS', tipoEnt: 'CEA', motSal: '01', motEnt: '01', un: '', estado: '0', num: 1, fecha: '', ffmt: 'AAAAMMDD', notas: 'AJUSTE POR INVENTARIO FISICO', resp: '',
  firma1n: '', firma1c: 'Auditor · Área de Control', firma2n: '', firma2c: 'Encargado del inventario', firma3n: '', firma3c: 'Gerencia Agrococorollo',
  servidor: ''
};
/* URL del servidor compartido (Google Apps Script). Va fija en el archivo para que todos los
   dispositivos —celulares de los operadores y centro de control— usen la misma base. */
const SERVIDOR_FIJO = 'https://script.google.com/macros/s/AKfycbzUgCYwbef2LwDMYPdhQkRwA6RWbUPsy12CWYVXHupoe8cjAkl4FUeNorB8trNJdK-93w/exec';
let P = Object.assign({}, DEF_P, ST.get('p', {}));
['cero', 'r2Pend', 'final'].forEach(k => delete P[k]);   // reglas retiradas en la v3: nada queda sin contar y manda el último conteo
if (P.excluir === 'INACTIVO, BLOQUEADO') P.excluir = DEF_P.excluir;   // v3 reconoce también INACT., INAC., INACIVO y NO USAR
P.servidor = SERVIDOR_FIJO;
const saveP = () => { ST.set('p', P); };

/* ---------- Modelo del centro de control ----------
   Los conteos llegan del servidor como filas (una por registro, solo se agregan):
   [hora, ronda, ítem, cantidad, operador, observación, fuera, nuevo, descripción, id].
   «cont» (último conteo por ronda e ítem) y «log» (historial) se arman aplicando esas filas en orden. */
const DB_VACIA = () => ({
  inv: null,        // {id, nombre, fecha, creado, estado, ronda, rondas:{1:{estado,abierta,cerrada},2:{estado,items,tipo},3:{…}}}
  items: {},        // código sin ceros → {item, cod (con ceros, solo para el plano), ref, desc, sub, grupo, linea, um, teo, cp, bods, inact}
  excl: [],         // ítems dejados por fuera y por qué
  ops: [],          // {id, nombre, pin, creado}
  asig: { 1: {}, 2: {}, 3: {} },   // ronda → bloque (subgrupo, o «FALTANTES · subgrupo» / «SOBRANTES · subgrupo») → [opId]
  rep: { 1: {}, 2: {}, 3: {} },    // (v7) ronda → bloque → {código: opId} cambios manuales al reparto de un bloque con varios operadores
  cont: { 1: {}, 2: {}, 3: {} },   // ronda → código → {q, op, ts, n, obs, nuevo, desc, fuera}
  log: [],          // {ts, r, item, q, prev, op}
  filas: [],        // filas crudas del servidor (para el respaldo)
  corte: '', ver: '', iver: '', fila: 1
});
let DB = DB_VACIA();
function aplicarFila(f) {
  const [ts, r, item, q, op, obs, fuera, nuevo, desc] = f;
  const c = DB.cont[r] || (DB.cont[r] = {}), prev = c[item];
  if (q == null) delete c[item];
  else c[item] = { q, op, ts, n: prev ? (prev.q !== q ? (prev.n || 1) + 1 : (prev.n || 1)) : 1, obs: obs || '', fuera: !!fuera, nuevo: !!nuevo, desc: desc || (prev && prev.desc) || '' };
  DB.log.push({ ts, r, item, q, prev: prev ? prev.q : null, op });
  DB.filas.push(f);
}
/** Foto completa del servidor (al entrar al centro de control). */
function cargarFoto(d) {
  DB = DB_VACIA();
  ['inv', 'items', 'excl', 'ops', 'asig', 'rep', 'corte', 'ver', 'iver', 'fila'].forEach(k => { if (d[k] !== undefined && d[k] !== null) DB[k] = d[k]; });
  DB.srvRep = d.rep !== undefined;   // el servidor v4 sabe repartir un bloque entre varios operadores
  (d.filas || []).forEach(aplicarFila);
}
/** Novedades desde la última lectura. Devuelve true si algo cambió. */
function aplicarDelta(d, conEstado) {
  let cambio = false;
  if (conEstado && d.inv !== undefined) { ['inv', 'ops', 'asig', 'rep', 'excl', 'corte'].forEach(k => { if (d[k] !== undefined) DB[k] = d[k] === null ? DB_VACIA()[k] : d[k]; }); cambio = true; }
  if (conEstado && d.items) { DB.items = d.items; cambio = true; }
  if (conEstado) { DB.ver = d.ver; DB.iver = d.iver; }
  if (d.filas && d.filas.length) { d.filas.forEach(aplicarFila); cambio = true; }
  if (d.fila) DB.fila = d.fila;
  return cambio;
}

/* ---------- Bloques de conteo (iguales en la app y en el servidor) ----------
   Ronda 1: un bloque por subgrupo. Rondas 2 y 3: «FALTANTES · subgrupo» y «SOBRANTES · subgrupo». */
const hojaDeD = (d, r) => { if (!d.inv) return []; if (+r === 1) return Object.keys(d.items); return (d.inv.rondas[r] && d.inv.rondas[r].items) || []; };
function blkDe(d, c, r) {
  const it = d.items[c], s = it ? subCorta(it.sub) : SIN_SUB;
  if (+r === 1) return s;
  const rd = d.inv && d.inv.rondas[r], t = rd && rd.tipo && rd.tipo[c];
  return t ? (t === 'S' ? 'SOBRANTES · ' : 'FALTANTES · ') + s : s;
}
const tipoBlk = b => /^FALTANTES · /.test(b) ? 'F' : /^SOBRANTES · /.test(b) ? 'S' : '';
const subDeBlk = b => String(b).replace(/^(FALTANTES|SOBRANTES) · /, '');
/** Orden de los subgrupos = su código en SIESA («1100 - …», «1200 - …»); SIN SUBGRUPO al final. */
const cmpS = (x, y) => x < y ? -1 : x > y ? 1 : 0;
function ordenSubs(d) { const o = {}; Object.values(d.items || {}).forEach(it => { const s = subCorta(it.sub), k = it.sub ? String(it.sub) : ' ' + s; if (o[s] == null || k < o[s]) o[s] = k; }); return o; }
const llaveSub = (o, s) => o[s] || ' ' + s;
function compararBlk(o) { const rt = { '': 0, F: 1, S: 2 }; return (a, b) => (rt[tipoBlk(a)] - rt[tipoBlk(b)]) || cmpS(llaveSub(o, subDeBlk(a)), llaveSub(o, subDeBlk(b))); }

/* ---------- SYNC · servidor compartido (Google Apps Script) ----------
   Contrato v3. Centro de control (con clave): login · pull · pullDelta · push · nuevoInventario · cargarFilas.
   Operadores: opLista · opEntrar · opRefrescar · opGuardar · opMaestra. */
const SYNC = (() => {
  const call = async (accion, datos, ms) => {
    if (!P.servidor || /^__/.test(P.servidor)) throw new Error('Este archivo no tiene configurado el servidor compartido.');
    const ctl = typeof AbortController !== 'undefined' ? new AbortController() : null, t = ctl ? setTimeout(() => ctl.abort(), ms || 45000) : null;
    try {
      const r = await fetch(P.servidor, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(Object.assign({ accion, clave: P.clave }, datos || {})), signal: ctl ? ctl.signal : undefined });
      if (!r.ok) throw new Error('Servidor: ' + r.status);
      const j = await r.json();
      if (j && j.error) { const e = new Error(/Acción desconocida/.test(j.error) ? 'El servidor todavía tiene la versión anterior: pegue el código del servidor v3 en Apps Script y publique una nueva versión.' : j.error); e.servidor = true; e.ocupado = !!j.ocupado; throw e; }
      return j;
    } catch (e) { if (e.name === 'AbortError') throw new Error('El servidor tardó demasiado en responder.'); throw e; }
    finally { if (t) clearTimeout(t); }
  };
  return {
    modo: 'remoto',
    login: clave => call('login', { clave }),
    pull: () => call('pull', {}, 90000),
    pullDelta: (ver, iver, fila) => call('pullDelta', { ver, iver, fila }),
    push: parts => call('push', { parts }, 90000),
    nuevoInventario: (inv, asig) => call('nuevoInventario', { inv, asig }),
    cargarFilas: filas => call('cargarFilas', { filas }, 90000),
    opLista: () => call('opLista'),
    opEntrar: (id, pin) => call('opEntrar', { id, pin }, 60000),
    opRefrescar: (id, ver, fila) => call('opRefrescar', { id, ver, fila }, 25000),
    opGuardar: (opId, regs) => call('opGuardar', { opId, regs }, 30000),
    opMaestra: () => call('opMaestra', {}, 60000)
  };
})();
/* Cada cambio del centro de control marca una «generación»: una lectura que salió antes de un cambio
   propio no reemplaza el estado (solo aporta los conteos nuevos), para que una foto vieja no deshaga lo guardado. */
let PUSH_GEN = 0, PUSHING = 0;
async function guardarServidor(parts) {
  PUSH_GEN++; PUSHING++;
  try { const r = await SYNC.push(parts); if (r && r.ver) { DB.ver = r.ver; DB.iver = r.iver; } return r; }
  finally { PUSHING--; PUSH_GEN++; }
}
async function iniciarInventarioServidor(inv, asig) {
  PUSH_GEN++; PUSHING++;
  try { const r = await SYNC.nuevoInventario(inv, asig); DB.cont = { 1: {}, 2: {}, 3: {} }; DB.log = []; DB.filas = []; DB.fila = r.fila || 1; DB.ver = r.ver; DB.iver = r.iver; return r; }
  finally { PUSHING--; PUSH_GEN++; }
}

/* ---------- Lectura de la consulta de existencias (reconoce el archivo por contenido) ---------- */
const COLS = {
  item: ['ITEM', 'CODIGO', 'COD', 'COD ITEM', 'COD. ITEM', 'CODIGO ITEM', 'CODIGO DEL ITEM', 'ARTICULO', 'CODIGO ARTICULO', 'ID ITEM', 'PRODUCTO', 'CODIGO PRODUCTO', 'SKU', 'PLU'],
  ref: ['REFERENCIA', 'REF', 'REFERENCIA ITEM', 'REF. ITEM'],
  desc: ['DESC. ITEM', 'DESC ITEM', 'DESCRIPCION', 'DESCRIPCION ITEM', 'DESCRIPCION DEL ITEM', 'NOMBRE', 'NOMBRE ITEM', 'NOMBRE DEL ITEM', 'DESC. ARTICULO', 'DESCRIPCION ARTICULO', 'DESCRIPCION PRODUCTO', 'DESC', 'DETALLE'],
  sub: ['SUBGRUPO', 'SUB GRUPO', 'SUBGRUPO ITEM', 'SUB-GRUPO', 'DESC. SUBGRUPO', 'DESC SUBGRUPO', 'NOMBRE SUBGRUPO', 'SUBCATEGORIA', 'SUB CATEGORIA'],
  grupo: ['GRUPO', 'GRUPO ITEM', 'DESC. GRUPO', 'DESC GRUPO', 'NOMBRE GRUPO', 'CATEGORIA', 'FAMILIA'],
  linea: ['LINEA', 'LÍNEA', 'LINEA ITEM', 'DESC. LINEA', 'DESC LINEA', 'NOMBRE LINEA', 'MARCA'],
  bod: ['BODEGA', 'COD BODEGA', 'CODIGO BODEGA', 'COD. BODEGA', 'ALMACEN', 'SEDE'], bodDesc: ['DESC. BODEGA', 'DESC BODEGA', 'NOMBRE BODEGA', 'DESCRIPCION BODEGA'],
  um: ['U.M.', 'UM', 'U.M', 'UNIDAD', 'UNIDAD MEDIDA', 'UNIDAD DE MEDIDA', 'UND MEDIDA', 'U. MEDIDA', 'UNID'],
  teo: ['EXISTENCIA', 'EXISTENCIAS', 'EXISTENCIA ACTUAL', 'SALDO', 'SALDO ACTUAL', 'SALDO CANTIDAD', 'CANTIDAD', 'CANT', 'CANT.', 'STOCK', 'DISPONIBLE', 'CANTIDAD DISPONIBLE', 'INVENTARIO', 'EXIST', 'EXIST.', 'SALDO FINAL', 'CANTIDAD FINAL', 'TEORICO'],
  cpIns: ['COSTO PROM. UNIT. (INS)', 'COSTO PROM UNIT (INS)', 'COSTO UNIT INS', 'COSTO UNIT. (INS)', 'COSTO PROMEDIO UNITARIO (INS)', 'COSTO UNITARIO (INS)', 'COSTO UNIT (INS)', 'COSTO PROM. UNI. (INS)'],
  cp: ['COSTO PROM. UNI.', 'COSTO PROM UNI', 'COSTO PROM. UNIT.', 'COSTO PROM UNIT', 'COSTO PROMEDIO', 'COSTO PROMEDIO UNITARIO', 'COSTO UNITARIO', 'COSTO UNIT', 'COSTO UNIT.', 'COSTO UNI', 'COSTO', 'COSTO PROM', 'CTO UNITARIO', 'PRECIO COSTO', 'COSTO ULTIMO', 'ULTIMO COSTO'],
  periodo: ['PERIODO', 'PERÍODO', 'FECHA', 'FECHA CORTE', 'CORTE']
};
const NOMBRE_COL = { item: 'Ítem', ref: 'Referencia', desc: 'Descripción', sub: 'Subgrupo', grupo: 'Grupo', linea: 'Línea', bod: 'Bodega', bodDesc: 'Nombre bodega', um: 'U.M.', teo: 'Existencia', cpIns: 'Costo (ins)', cp: 'Costo', periodo: 'Período' };
/** Marcas de inactivo en la descripción. Cada marca va como palabra («NO USAR», «BLOQUEADO»); con * al final es un
    comienzo de palabra («INAC*» = INACTIVO, INACT., INAC., INACIVO…). Así «ESPINACA», «BLOQUE» o «BLOQUEADOR» no cuentan. */
function regexInactivos(txt) {
  const t = String(txt || '').split(',').map(s => norm(s).trim()).filter(Boolean).map(s => { const pre = s.endsWith('*'); s = s.replace(/\*$/, '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); return pre ? s + '[A-Z0-9]*\\.?' : s + '(?![A-Z0-9])'; });
  return t.length ? new RegExp('(?:^|[^A-Z0-9])((?:' + t.join('|') + '))') : /$^/;
}
/** Busca en las primeras filas la que mejor se parece a un encabezado y mapea cada campo a su columna. */
function mapearEncabezado(matriz) {
  const N = s => norm(s).replace(/\s+/g, ' ').replace(/[:*]/g, '').trim();
  const AL = Object.fromEntries(Object.entries(COLS).map(([k, a]) => [k, a.map(N)]));
  let mejor = { fila: -1, map: {}, score: -1 };
  for (let i = 0; i < Math.min(40, matriz.length); i++) {
    const row = (matriz[i] || []).map(N); if (row.filter(Boolean).length < 3) continue;
    const map = {}, usadas = new Set();
    const tomar = (k, pred) => { if (map[k] != null) return; const j = row.findIndex((h, idx) => h && !usadas.has(idx) && pred(h)); if (j >= 0) { map[k] = j; usadas.add(j); } };
    for (const k of Object.keys(COLS)) tomar(k, h => AL[k].includes(h));                                   // 1) exacto
    for (const k of ['cpIns', 'teo', 'desc', 'sub', 'grupo', 'linea', 'um', 'bod']) tomar(k, h => AL[k].some(a => a.length > 3 && h.startsWith(a)));  // 2) empieza igual
    if (map.cpIns == null) tomar('cpIns', h => /COSTO/.test(h) && /\(INS\)|INS$/.test(h) && !/TOT/.test(h));
    if (map.cp == null) tomar('cp', h => /COSTO/.test(h) && /UNI|PROM/.test(h) && !/TOT/.test(h));
    if (map.teo == null) tomar('teo', h => /^(EXIST|SALDO|STOCK|CANT)/.test(h) && !/VALOR|COSTO|\$/.test(h));
    if (map.desc == null) tomar('desc', h => /^DESC/.test(h) && !/BODEGA|GRUPO|LINEA|SUB/.test(h));
    const score = (map.item != null ? 3 : 0) + (map.ref != null ? 2 : 0) + (map.desc != null ? 3 : 0) + (map.teo != null ? 3 : 0) + (map.cpIns != null ? 2 : 0) + (map.cp != null ? 1 : 0) + (map.sub != null ? 1 : 0) + (map.um != null ? 1 : 0) + (map.bod != null ? .5 : 0);
    if (score > mejor.score) mejor = { fila: i, map, score };
  }
  return mejor;
}
function leerExistencias(matriz) {
  const { fila: hr, map } = mapearEncabezado(matriz);
  const tieneCod = map.item != null || map.ref != null;
  if (hr < 0 || !tieneCod || map.desc == null || map.teo == null) throw new Error('No reconocí el archivo: necesito al menos una columna de código (Ítem o Referencia), la descripción y la existencia o saldo.');
  const colCod = map.item != null ? map.item : map.ref, colRef = map.ref != null ? map.ref : colCod;
  const colCp = map.cpIns != null ? map.cpIns : map.cp;
  const colGrupo = map.sub != null ? 'sub' : map.grupo != null ? 'grupo' : map.linea != null ? 'linea' : null;   // cómo se arman las hojas de conteo
  const exclRe = regexInactivos(P.excluir);
  const items = {}, excl = []; let corte = '', filas = 0; const largos = {};
  for (let i = hr + 1; i < matriz.length; i++) {
    const r = matriz[i] || []; const raw = r[colCod]; const code = clean(typeof raw === 'number' ? String(Math.round(raw)) : raw); if (!code) continue;
    const desc = clean(r[map.desc]); if (!desc && !num(r[map.teo])) continue; const descN = norm(desc);
    if (/^TOTAL/i.test(code) || /^TOTAL/i.test(desc)) continue;
    filas++;
    const bod = map.bod != null ? clean(r[map.bod]) : '', bodDesc = map.bodDesc != null ? clean(r[map.bodDesc]) : '', teo = num(r[map.teo]) || 0;
    const cp = colCp != null ? (num(r[colCp]) || 0) : 0;
    if (!corte && map.periodo != null) corte = clean(r[map.periodo]);
    const cod = String(code).replace(/\.0+$/, ''), key = cod.replace(/^0+(?=\d)/, '');
    if (/^0\d+$/.test(cod)) largos[cod.length] = (largos[cod.length] || 0) + 1;
    const mI = descN.match(exclRe), marcaInact = mI ? 'Descripción marcada «' + mI[1].trim() + '»' : '';
    const bodInact = /^INACT/i.test(bod) || /^INACT/i.test(bodDesc);
    // Inactivos/bloqueados: sin existencia quedan fuera (SIESA les asigna cero); con existencia entran al conteo marcados
    if (bodInact || (marcaInact && !teo)) { excl.push({ item: key, cod, desc, sub: clean(colGrupo ? r[map[colGrupo]] : ''), bod: bod || bodDesc, teo, motivo: bodInact ? 'Bodega ' + (bod || bodDesc) + ' (no hace parte de la toma)' : marcaInact + ' sin existencia' }); continue; }
    const it = items[key] || (items[key] = { item: key, cod, ref: clean(r[colRef]) || key, desc, sub: clean(colGrupo ? r[map[colGrupo]] : '') || '', grupo: clean(map.grupo != null ? r[map.grupo] : ''), linea: clean(map.linea != null ? r[map.linea] : ''), um: (clean(map.um != null ? r[map.um] : '') || 'UND').toUpperCase(), teo: 0, cp: 0, bods: [] });
    if (marcaInact) { it.inact = true; it.motInact = marcaInact; }
    it.teo = r3(it.teo + teo); if (cp && (!it.cp || teo > 0)) it.cp = cp; const b = bod || bodDesc; if (b && !it.bods.includes(b)) it.bods.push(b);
  }
  const n = Object.keys(items).length; if (!n) throw new Error('El archivo no trae ítems activos.');
  // Código completo para el plano de SIESA: si la consulta trae códigos con ceros a la izquierda, se completan todos al mismo largo
  const L = +(Object.entries(largos).sort((a, b) => b[1] - a[1])[0] || [0])[0] || (+P.itemLen || 0);
  if (L) Object.values(items).concat(excl).forEach(it => { if (/^\d+$/.test(it.cod || '') && it.cod.length < L) it.cod = it.cod.padStart(L, '0'); });
  const encabezado = (matriz[hr] || []);
  const mapa = Object.entries(map).map(([k, j]) => ({ campo: NOMBRE_COL[k] || k, col: clean(encabezado[j]) }));
  const avisos = [];
  if (colCp == null) avisos.push('No encontré columna de costo: las diferencias no se valorizan.'); else if (map.cpIns == null) avisos.push('No hay «Costo prom. unit. (ins)»: uso ' + clean(encabezado[colCp]) + '.');
  if (!colGrupo) avisos.push('No hay subgrupo, grupo ni línea: toda la hoja de conteo queda en un solo bloque «SIN SUBGRUPO».'); else if (colGrupo !== 'sub') avisos.push('No hay columna SUBGRUPO: las hojas se arman por ' + NOMBRE_COL[colGrupo].toUpperCase() + '.');
  if (map.item == null) avisos.push('No hay columna Ítem: uso la Referencia como código.');
  const nInact = Object.values(items).filter(i => i.inact).length;
  if (nInact) avisos.push(nInact + ' ítems inactivos o bloqueados tienen existencia: entran a las hojas de conteo marcados INACTIVO (si no se cuentan, SIESA los dejaría en cero).');
  const bods = [...new Set(Object.values(items).flatMap(i => i.bods))];
  if (bods.length > 1) avisos.push('La consulta trae varias bodegas (' + bods.join(', ') + '): el conteo y el plano se arman como una sola toma.');
  return { items, excl, corte, mapa, avisos, filas, agrupa: colGrupo ? NOMBRE_COL[colGrupo] : 'ninguno', largo: L };
}
/** Lee todas las hojas del archivo y se queda con la que mejor parece una consulta de existencias. */
async function leerMejorHoja(file) {
  const nombre = (file.name || '').toLowerCase();
  if (!/\.(csv|txt)$/.test(nombre) && typeof XLSX === 'undefined') await LIBS.cargar();
  if (/\.(csv|txt)$/.test(nombre) || typeof XLSX === 'undefined') return { hoja: '', matriz: await ARK.leerArchivo(file) };
  const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
  let mejor = null;
  for (const h of wb.SheetNames) {
    const m = XLSX.utils.sheet_to_json(wb.Sheets[h], { header: 1, defval: '', raw: true }); if (m.length < 2) continue;
    const sc = mapearEncabezado(m).score + Math.min(2, m.length / 1000);
    if (!mejor || sc > mejor.sc) mejor = { hoja: h, matriz: m, sc };
  }
  if (!mejor) throw new Error('El archivo no tiene hojas con datos.');
  return mejor;
}

/* ---------- (v7) reparto de un bloque entre varios operadores: mismas reglas que el servidor ---------- */
/** Orden canónico de los ítems: numérico cuando el código es número, si no alfabético. */
function cmpCod(a, b) { const x = Number(a), y = Number(b), nx = a !== '' && isFinite(x), ny = b !== '' && isFinite(y); if (nx && ny) return x - y; if (nx) return -1; if (ny) return 1; return a < b ? -1 : a > b ? 1 : 0; }
/** Dueño automático: partes iguales y contiguas en el orden del bloque. */
function duenoAuto(i, n, ops) { const tam = Math.ceil(n / ops.length); return ops[Math.min(ops.length - 1, Math.floor(i / tam))]; }
/* ---------- Carga y respaldo ---------- */
const busy = (on, txt) => { $('#busy').hidden = !on; if (txt) $('#busyTxt').textContent = txt; };
async function cargarExistencias(file) {
  busy(true, 'Leyendo ' + file.name + '…');
  try {
    const { hoja, matriz } = await leerMejorHoja(file);
    const { items, excl, corte, mapa, avisos, filas, agrupa, largo } = leerExistencias(matriz);
    const antes = Object.keys(DB.items).length, contados = Object.values(DB.cont).reduce((a, c) => a + Object.keys(c).length, 0);
    const nuevos = Object.keys(items).filter(k => !DB.items[k]).length, salen = Object.keys(DB.items).filter(k => !items[k]).length;
    busy(false);
    const mapaHtml = `<details class="small" style="margin-top:8px"><summary class="muted" style="cursor:pointer">Columnas reconocidas (${mapa.length}) · hojas de conteo por ${esc(agrupa)}${hoja ? ' · hoja «' + esc(hoja) + '»' : ''}</summary><div class="kv2" style="margin-top:6px">${mapa.map(m => `<span>${esc(m.campo)}</span><b>${esc(m.col)}</b>`).join('')}</div></details>${avisos.map(a => `<p class="small" style="margin:6px 0 0;color:var(--warn)">⚠ ${esc(a)}</p>`).join('')}`;
    const resumen = `<div class="kv2"><span>Ítems activos</span><b>${fmtN(Object.keys(items).length)}</b><span>Con existencia &gt; 0</span><b>${fmtN(Object.values(items).filter(i => i.teo > 0).length)}</b><span>Subgrupos</span><b>${fmtN(new Set(Object.values(items).map(i => subCorta(i.sub))).size)}</b><span>Valor a costo (ins)</span><b>${fmt$(Object.values(items).reduce((a, i) => a + i.teo * i.cp, 0))}</b><span>Filas leídas</span><b>${fmtN(filas)}</b><span>Inactivos con existencia (se cuentan)</span><b>${fmtN(Object.values(items).filter(i => i.inact).length)}</b><span>Dejados por fuera</span><b>${fmtN(excl.length)}</b><span>Código del ítem en el plano</span><b>${esc((Object.values(items)[0] || {}).cod || '')}${largo ? ' · ' + largo + ' dígitos' : ''}</b>${antes ? `<span>Nuevos frente a la carga anterior</span><b>${fmtN(nuevos)}</b><span>Ya no aparecen</span><b>${fmtN(salen)}</b>` : ''}</div>`;
    const ok = await modal({ titulo: antes ? '¿Actualizar las existencias?' : '¿Crear el inventario con esta consulta?', html: `<p class="muted small">${esc(file.name)}${corte ? ' · período ' + esc(corte) : ''}</p>${resumen}${mapaHtml}${contados ? `<p class="small" style="margin-top:8px">Hay <b>${fmtN(contados)}</b> registros de conteo: se conservan y se cruzan por código de ítem.</p>` : ''}${antes ? '' : '<label class="fld" style="margin-top:10px">Nombre del inventario<input type="text" id="mNom" value="Inventario físico ' + esc(ARK.MESES[new Date().getMonth()]) + ' ' + new Date().getFullYear() + '"></label>'}`, ok: antes ? 'Actualizar' : 'Crear inventario' });
    if (!ok) return;
    busy(true, 'Guardando en el servidor…');
    if (!DB.inv) {
      const nom = ($('#mNom') && $('#mNom').value.trim()) || 'Inventario físico';
      DB.inv = invNuevo(nom); DB.asig = { 1: {}, 2: {}, 3: {} };
      await iniciarInventarioServidor(DB.inv, DB.asig);
    }
    DB.items = items; DB.excl = excl; DB.corte = corte;
    await guardarServidor({ items: DB.items, excl: DB.excl, corte: DB.corte });
    busy(false);
    calcular(); renderTodo(); toast('Existencias cargadas: ' + fmtN(Object.keys(items).length) + ' ítems activos.');
  } catch (e) { busy(false); toast(e.message || String(e)); console.error(e); }
}
const invNuevo = nom => ({ id: uid(), nombre: nom, fecha: ARK.isoDate(new Date()), creado: Date.now(), estado: 'abierto', ronda: 1, rondas: { 1: { estado: 'pendiente', items: null }, 2: { estado: 'pendiente', items: [] }, 3: { estado: 'pendiente', items: [] } } });
function respaldo() {
  const d = { inv: DB.inv, items: DB.items, excl: DB.excl, ops: DB.ops, asig: DB.asig, rep: DB.rep, corte: DB.corte, filas: DB.filas };
  const b = new Blob([JSON.stringify({ v: 3, fecha: new Date().toISOString(), P: Object.assign({}, P, { clave: '' }), DB: d })], { type: 'application/json' });
  ARK.saveBlob(b, `RESPALDO_INVENTARIO_AGRO_${ARK.isoDate(new Date())}.json`);
}
/** Convierte los conteos de un respaldo de la v2 (cont por ronda) a filas. */
function filasDesdeCont(cont) {
  const out = []; [1, 2, 3].forEach(r => Object.entries((cont || {})[r] || {}).forEach(([item, x]) => { if (x && x.q != null) out.push([x.ts || Date.now(), r, item, x.q, x.op || '', x.obs || '', x.fuera ? 1 : 0, x.nuevo ? 1 : 0, x.desc || '', uid()]); }));
  return out.sort((a, b) => a[0] - b[0]);
}
async function restaurar(file) {
  try {
    const j = JSON.parse(await file.text()); if (!j.DB || !j.DB.inv) throw new Error('El archivo no es un respaldo de esta app.');
    const filas = j.DB.filas || filasDesdeCont(j.DB.cont);
    const ok = await modal({ titulo: '¿Restaurar este respaldo?', html: `<p class="small">Reemplaza en el servidor el inventario, las existencias, los operadores y los conteos (${fmtN(filas.length)} registros). La hoja de conteos actual queda archivada en Google.</p><p class="muted small">${esc(file.name)} · ${esc(j.fecha || '')}</p>`, ok: 'Restaurar' }); if (!ok) return;
    busy(true, 'Restaurando…');
    await iniciarInventarioServidor(j.DB.inv, j.DB.asig || { 1: {}, 2: {}, 3: {} });
    await guardarServidor({ items: j.DB.items || {}, excl: j.DB.excl || [], ops: j.DB.ops || [], corte: j.DB.corte || '' });
    for (let i = 0; i < filas.length; i += 1500) await SYNC.cargarFilas(filas.slice(i, i + 1500));
    cargarFoto(await SYNC.pull()); busy(false); calcular(); renderTodo(); toast('Respaldo restaurado.');
  } catch (e) { busy(false); toast(e.message || String(e)); }
}

/* ---------- Modal genérico ---------- */
function modal(o) {
  return new Promise(res => {
    const m = $('#modal'), box = $('#modalBox');
    box.innerHTML = `<h3>${esc(o.titulo)}</h3>${o.html || ''}<div class="row"><button class="btn" type="button" id="mCancel" ${o.cancel === false ? 'hidden' : ''}>${esc(o.cancel || 'Cancelar')}</button><button class="btn pri" type="button" id="mOk">${esc(o.ok || 'Aceptar')}</button></div>`;
    m.hidden = false; const fin = v => { m.hidden = true; res(v); };
    $('#mCancel').onclick = () => fin(false); $('#mOk').onclick = () => fin(true);
    const first = box.querySelector('input,select'); if (first) setTimeout(() => first.focus(), 50);
  });
}

/* ---- src/js/02_modelo.js ---- */
/* =====================================================================
   02 · Modelo: hojas y bloques por ronda, consolidado, avance, ritmo y hallazgos
   Reglas v3: nada queda sin contar (un 0 es un conteo), la cantidad final de
   cada ítem es su último conteo (SIESA ajusta con el conteo definitivo) y las
   rondas 2 y 3 se arman por FALTANTES y SOBRANTES de la ronda anterior.
   ===================================================================== */
let R = null, H = [];
const tolDe = um => /^UND?$|^UN$|^UNIDAD/.test(um || 'UND') ? (+P.tolUnd || 0) : (+P.tolDec || 0);
const opNom = id => { const o = DB.ops.find(x => x.id === id); return o ? o.nombre : (id ? '¿?' : '—'); };
const subDe = code => { const it = DB.items[code]; return it ? subCorta(it.sub) : SIN_SUB; };
const hojaRonda = r => hojaDeD(DB, r);
const blk = (code, r) => blkDe(DB, code, r);
let ORD_SUB = {}, CMP_BLK = () => 0;
/** Diferencia de un ítem tras una ronda: usa el último conteo disponible hasta esa ronda. */
function estadoTras(code, r) {
  const it = DB.items[code]; let q = null, qr = 0;
  for (let k = 1; k <= r; k++) { const c = DB.cont[k] && DB.cont[k][code]; if (c && c.q != null) { q = c.q; qr = k; } }
  const teo = it ? it.teo : 0, tol = tolDe(it && it.um);
  const dif = q == null ? null : r3(q - teo);
  return { q, qr, dif, difAj: dif == null ? 0 : (Math.abs(dif) <= tol ? 0 : dif), teo };
}
/** Ítems que pasan a la ronda r, marcados como faltante (F) o sobrante (S). */
function candidatosRonda(r) {
  const prev = r - 1, items = [], tipo = {};
  hojaRonda(prev).forEach(code => {
    const c = DB.cont[prev] && DB.cont[prev][code]; if (!c) return;     // no pasa: al cerrar no puede quedar nada sin contar
    const e = estadoTras(code, prev);
    let pasa = e.difAj !== 0, t = e.difAj < 0 ? 'F' : 'S';
    if (r === 3 && P.r3Crit === 'c1') { const c1 = DB.cont[1] && DB.cont[1][code]; pasa = !!c1 && Math.abs(c.q - c1.q) > tolDe((DB.items[code] || {}).um); if (pasa && !e.difAj) t = c.q < c1.q ? 'F' : 'S'; }
    if (pasa) { items.push(code); tipo[code] = t; }
  });
  return { items, tipo };
}
function calcular() {
  if (!DB.inv) { R = null; H = []; return; }
  ORD_SUB = ordenSubs(DB); CMP_BLK = compararBlk(ORD_SUB);
  const rAct = +DB.inv.ronda, abiertaAct = DB.inv.rondas[rAct] && DB.inv.rondas[rAct].estado === 'abierta', lines = [], hojas = [1, 2, 3].map(r => new Set(hojaRonda(r)));
  for (const code of Object.keys(DB.items)) {
    const it = DB.items[code]; const c = [1, 2, 3].map(r => DB.cont[r] && DB.cont[r][code] || null);
    let fin = null, finR = 0, op = null, ts = 0, n = 0;
    c.forEach((x, i) => { if (x && x.q != null) { fin = x.q; finR = i + 1; op = x.op; ts = x.ts; n += x.n || 1; } });
    const enHoja = hojas.map(h => h.has(code));
    const contado = fin != null;
    const dif = !contado ? null : r3(fin - it.teo), tol = tolDe(it.um);
    const difAj = dif == null ? 0 : (Math.abs(dif) <= tol ? 0 : dif);
    const nov = !contado ? 'PENDIENTE' : difAj < 0 ? 'FALTANTE' : difAj > 0 ? 'SOBRANTE' : 'SIN NOVEDAD';
    const pendAct = enHoja[rAct - 1] && !c[rAct - 1] && DB.inv.estado === 'abierto';
    lines.push({ k: code, item: code, cod: it.cod || code, ref: it.ref, desc: it.desc, sub: subCorta(it.sub), grupo: it.grupo, um: it.um, teo: it.teo, cp: it.cp, vTeo: r3(it.teo * it.cp), inact: !!it.inact,
      c1: c[0] ? c[0].q : null, c2: c[1] ? c[1].q : null, c3: c[2] ? c[2].q : null, fin, finR, dif, difAj, vDif: difAj * it.cp, nov, op, ts, n, enHoja, contado, pendAct, blkAct: enHoja[rAct - 1] ? blk(code, rAct) : '',
      fuera: c.some(x => x && x.fuera), obs: c.map(x => x && x.obs).filter(Boolean).join(' · ') });
  }
  // ítems contados que no existen en la consulta (no pueden ir al plano)
  const nuevos = [];
  [1, 2, 3].forEach(r => Object.entries(DB.cont[r] || {}).forEach(([code, x]) => { if (!DB.items[code] && x.nuevo) nuevos.push({ k: code, item: code, cod: code, ref: code, desc: x.desc || '(sin descripción)', sub: SIN_SUB, um: '', teo: 0, cp: 0, vTeo: 0, c1: r === 1 ? x.q : null, c2: r === 2 ? x.q : null, c3: r === 3 ? x.q : null, fin: x.q, finR: r, dif: x.q, difAj: x.q, vDif: 0, nov: 'SOBRANTE', op: x.op, ts: x.ts, n: x.n, enHoja: [false, false, false], contado: true, nuevo: true, obs: x.obs || '' }); }));
  const subs = [...new Set(lines.map(l => l.sub))].sort((a, b) => cmpS(llaveSub(ORD_SUB, a), llaveSub(ORD_SUB, b)));
  // avance por ronda / bloque / operador
  const av = {};
  [1, 2, 3].forEach(r => {
    const codes = hojaRonda(r), cont = DB.cont[r] || {}, porBlk = {}, porOp = {};
    codes.forEach(code => { const b = blk(code, r); const pb = porBlk[b] || (porBlk[b] = { blk: b, sub: subDeBlk(b), tipo: tipoBlk(b), total: 0, cont: 0, ops: (DB.asig[r] && DB.asig[r][b]) || [], ult: 0, vDif: 0, nDif: 0 }); pb.total++;
      const x = cont[code]; if (x) { pb.cont++; pb.ult = Math.max(pb.ult, x.ts); const e = estadoTras(code, r); if (e.difAj) { pb.nDif++; pb.vDif += e.difAj * ((DB.items[code] || {}).cp || 0); } } });
    Object.values(cont).forEach(x => { const po = porOp[x.op] || (porOp[x.op] = { op: x.op, nombre: opNom(x.op), cont: 0, ini: x.ts, ult: 0, blks: new Set() }); po.cont++; po.ini = Math.min(po.ini, x.ts); po.ult = Math.max(po.ult, x.ts); });
    Object.entries(DB.asig[r] || {}).forEach(([b, ids]) => (ids || []).forEach(id => { const po = porOp[id] || (porOp[id] = { op: id, nombre: opNom(id), cont: 0, ini: 0, ult: 0, blks: new Set() }); po.blks.add(b); }));
    // (v7) dueño de cada ítem: en bloques con un solo operador es él; con varios, el reparto (manual o partes iguales)
    const dueno = {}; Object.values(porBlk).forEach(pb => { const ops = pb.ops || []; pb.porOp = {}; ops.forEach(id => { pb.porOp[id] = { asig: 0, cont: 0 }; }); if (!ops.length) return;
      const lista = codes.filter(c => blk(c, r) === pb.blk).sort(cmpCod), cambios = (DB.rep && DB.rep[r] && DB.rep[r][pb.blk]) || {};
      pb.codes = lista; pb.cambios = Object.keys(cambios).filter(c => ops.includes(cambios[c])).length;
      lista.forEach((c, i) => { const d = ops.length === 1 ? ops[0] : (cambios[c] && ops.includes(cambios[c]) ? cambios[c] : duenoAuto(i, lista.length, ops)); dueno[c] = d; pb.porOp[d].asig++; if (cont[c]) pb.porOp[d].cont++; }); });
    Object.values(porOp).forEach(po => { po.asig = Object.values(dueno).filter(d => d === po.op).length; po.blks = [...po.blks].sort(CMP_BLK); po.horas = po.ini && po.ult > po.ini ? (po.ult - po.ini) / 36e5 : 0; po.ritmo = po.horas > 0.05 ? po.cont / po.horas : null; });
    const lista = Object.values(porBlk).sort((a, b) => CMP_BLK(a.blk, b.blk));
    av[r] = { total: codes.length, cont: codes.filter(c => cont[c]).length, porBlk, lista, porOp, dueno, estado: DB.inv.rondas[r].estado };
  });
  const a = agg(lines);
  R = { lines, nuevos, subs, av, rAct, abiertaAct, a, fechaConteo: DB.inv.fecha };
  construirHallazgos();
}
function agg(lines) {
  const o = { n: lines.length, cont: 0, pend: 0, pendSaldo: 0, falt: 0, sobr: 0, ok: 0, vFalt: 0, vSobr: 0, vTeo: 0, vFis: 0 };
  lines.forEach(l => { o.vTeo += l.vTeo; if (l.nov === 'PENDIENTE') { o.pend++; if (l.teo) o.pendSaldo++; return; } o.cont++; o.vFis += (l.fin || 0) * l.cp; if (l.nov === 'FALTANTE') { o.falt++; o.vFalt += l.vDif; } else if (l.nov === 'SOBRANTE') { o.sobr++; o.vSobr += l.vDif; } else o.ok++; });
  o.vNeto = o.vFalt + o.vSobr; o.vAbs = Math.abs(o.vFalt) + o.vSobr; o.exact = o.cont ? o.ok / o.cont : 0; o.avance = o.n ? o.cont / o.n : 0;
  return o;
}
/** Ítems contados por bloques de 15 minutos de una ronda (para el ritmo; sale de los conteos, no de la bitácora). */
function ritmoRonda(r) {
  const ts = Object.values(DB.cont[r] || {}).map(x => x.ts).filter(Boolean).sort((a, b) => a - b); if (!ts.length) return [];
  const t0 = Math.floor(ts[0] / 9e5) * 9e5, t1 = Math.max(Math.floor(ts[ts.length - 1] / 9e5) * 9e5, Math.min(Math.floor(Date.now() / 9e5) * 9e5, t0 + 95 * 9e5)); const out = [];
  for (let t = t0; t <= t1 && out.length < 96; t += 9e5) out.push({ t, n: 0 });
  ts.forEach(x => { const i = Math.floor((x - t0) / 9e5); if (out[i]) out[i].n++; });
  return out;
}
/** Estimado de cuándo termina la ronda: ritmo reciente (última media hora) con más peso que el promedio desde que abrió. */
function etaRonda(r) {
  if (!DB.inv || !R) return null;
  const av = R.av[r], est = estadoRonda(r); if (!av) return null;
  const falta = av.total - av.cont, ahora = Date.now();
  const ts = Object.values(DB.cont[r] || {}).map(x => x.ts).filter(Boolean);
  const ini = DB.inv.rondas[r].abierta || (ts.length ? Math.min(...ts) : 0);
  const out = { r, estado: est, falta, total: av.total, cont: av.cont, ini, ult: ts.length ? Math.max(...ts) : 0, ritmo: 0, ms: null, fin: null, detenido: false, fiable: false };
  if (est === 'cerrada') { out.fin = DB.inv.rondas[r].cerrada || out.ult; out.ms = 0; return out; }
  if (est !== 'abierta' || !ts.length) return out;
  const rec = ts.filter(t => ahora - t <= 30 * 60000).length, hRec = Math.min(.5, Math.max(1 / 60, (ahora - Math.max(ini, ahora - 30 * 60000)) / 36e5));
  const hTot = Math.max(1 / 60, (ahora - ini) / 36e5), rTot = av.cont / hTot, rRec = rec / hRec;
  out.detenido = ahora - out.ult > 15 * 60000;
  out.ritmo = hTot < .25 ? rTot : (rec >= 5 ? .7 * rRec + .3 * rTot : rTot);
  out.fiable = av.cont >= 10 && hTot >= 1 / 12;
  if (!falta) { out.ms = 0; out.fin = out.ult; return out; }
  if (out.ritmo > 0 && !out.detenido) { out.ms = falta / out.ritmo * 36e5; out.fin = ahora + out.ms; }
  return out;
}
const fmtHm = ts => ts ? fmtHs(ts).slice(0, 5) : '—';
const fmtDur = ms => { if (ms == null) return '—'; const m = Math.round(ms / 60000); if (m < 1) return 'menos de 1 min'; if (m < 60) return `${m} min`; const h = Math.floor(m / 60), mm = m % 60; return `${h} h${mm ? ' ' + ARK.pad2(mm) + ' min' : ''}`; };
/** Frase corta del estimado, para chips y pantallas. */
function etaTexto(e, largo) {
  if (!e) return '';
  if (e.estado === 'cerrada') return `Ronda ${e.r} cerrada ${fmtHm(e.fin)}`;
  if (e.estado !== 'abierta') return '';
  if (!e.cont) return largo ? 'Aún no hay registros: el estimado aparece con los primeros conteos.' : 'Sin ritmo aún';
  if (!e.falta) return `Ronda ${e.r} completa · lista para cerrar`;
  if (e.detenido) return largo ? `Estimado detenido: nadie registra desde ${fmtHm(e.ult)} (faltan ${fmtN(e.falta)} ítems).` : `Detenido desde ${fmtHm(e.ult)}`;
  if (!e.fin) return '';
  const hora = fmtHm(e.fin), dia = new Date(e.fin).getDate() !== new Date().getDate() ? ' (mañana)' : '';
  return largo ? `Faltan ${fmtN(e.falta)} ítems · ritmo ${fmtN(Math.round(e.ritmo))} ítems/h · a este ritmo la ronda ${e.r} termina en ${fmtDur(e.ms)}, hacia las ${hora}${dia}${e.fiable ? '' : ' (estimado inicial)'}` : `Termina ~${hora}${dia}`;
}
/** Resumen corto de los bloques de un operador: en ronda 1 los subgrupos; en 2 y 3 cuántos de faltantes y de sobrantes. */
function resumenBlks(blks) {
  if (!blks.length) return '—';
  if (blks.length <= 3 || !blks.some(b => tipoBlk(b))) return blks.map(b => (tipoBlk(b) ? `<span class="pill ${tipoBlk(b) === 'F' ? 'p-bad' : 'p-ok'}">${tipoBlk(b) === 'F' ? 'F' : 'S'}</span> ` : '') + esc(subDeBlk(b))).join(', ');
  const f = blks.filter(b => tipoBlk(b) === 'F').length, s = blks.filter(b => tipoBlk(b) === 'S').length;
  return `<span title="${esc(blks.join(' · '))}">${f ? `<span class="pill p-bad">FALTANTES</span> ${fmtN(f)} bloques ` : ''}${s ? `<span class="pill p-ok">SOBRANTES</span> ${fmtN(s)} bloques` : ''}</span>`;
}

/* ---------- Hallazgos: lo que el auditor debería mirar ---------- */
const COLS_L = [{ l: 'Ítem', f: r => esc(r.item) }, { l: 'Descripción', f: r => esc(r.desc) + `<small class="sub2">${esc(r.sub)} · ${esc(r.um)}</small>`, cls: 'desc' }, { l: 'Existencia', n: 1, f: r => fmtQ(r.teo) }, { l: 'C1 · C2 · C3', n: 1, f: r => conteosHtml(r) }, { l: 'Final', n: 1, f: r => fmtQ(r.fin) }, { l: 'Diferencia', n: 1, f: r => `<span class="${sgn(r.difAj)}">${fmtQ(r.difAj)}</span>` }, { l: 'Valor', n: 1, f: r => `<span class="${sgn(r.vDif)}">${fmt$(r.vDif)}</span>` }, { l: 'Operador', f: r => esc(opNom(r.op)), cls: 'wrap' }];
const COLS_BLK = [{ k: 'blk', l: 'Bloque' }, { l: 'Ítems', n: 1, f: q => fmtN(q.total) }, { l: 'Contados', n: 1, f: q => fmtN(q.cont) }];
function construirHallazgos() {
  H = []; if (!R) return;
  const L = R.lines, r = R.rAct, av = R.av[r], big = +P.difGrande || 0;
  const add = (id, sev, t, x, rows, accion, cols, go) => { if (!rows || !rows.length) return; H.push({ id, sev, t, x, n: rows.length, valor: rows[0] && rows[0].vDif != null ? rows.reduce((a, q) => a + (q.vDif || 0), 0) : null, rows, accion, cols: cols || COLS_L, go }); };
  const byV = (a, b) => Math.abs(b.vDif) - Math.abs(a.vDif);
  add('grandes', 'bad', 'Diferencias grandes en pesos', `Ítems con diferencia superior a ${fmt$(big)} a costo (ins)`, L.filter(l => Math.abs(l.vDif) >= big && big > 0).sort(byV), 'Verificar en sitio antes de cerrar la ronda: ubicación, unidad de medida y si hay mercancía en recepción o en otro punto.', null, ['cons', { dif: true }]);
  add('nuevos', 'bad', 'Códigos contados que no están en la consulta', 'Registrados como «no encontrado en la lista»: no pueden ir al plano de SIESA', R.nuevos, 'Buscar el ítem en SIESA: puede estar creado con otro código, inactivo o nunca creado. Si existe, cargar una consulta nueva antes de generar el plano.', null, ['datos', {}]);
  add('inact', 'warn', 'Ítems inactivos o bloqueados con existencia', 'Están en las hojas de conteo: si quedaran fuera, SIESA los dejaría en cero', L.filter(l => l.inact), 'Confirmar en sitio y definir con el cliente si se reactivan o se dan de baja después del ajuste.', null, ['cons', { q: '' }]);
  add('fuera', 'warn', 'Ítems contados fuera de su bloque asignado', 'El operador los encontró en su zona pero pertenecen a otro bloque', L.filter(l => l.fuera), 'Confirmar la ubicación física y que el operador del bloque dueño no los cuente dos veces.', null, ['cons', {}]);
  const sinAsig = av.lista.filter(s => !s.ops.length && s.total);
  add('sinasig', av.estado === 'abierta' ? 'bad' : 'warn', 'Bloques sin operador en la ronda ' + r, 'Nadie los va a contar y la ronda no se puede cerrar con pendientes', sinAsig, 'Asignar un operador en Rondas y asignación.', COLS_BLK, ['rondas', {}]);
  add('edits', 'warn', 'Ítems corregidos tres veces o más', 'Cantidad cambiada varias veces por el operador', L.filter(l => l.n >= (+P.maxEdits || 3)).sort((a, b) => b.n - a.n), 'Preguntar al operador qué pasó; es una señal de duda en la unidad de medida o en la ubicación.', null, ['cons', {}]);
  add('decimal', 'warn', 'Decimales en unidades enteras', 'Conteo con fracción en ítems que se miden en UND', L.filter(l => l.fin != null && /^UND?$/.test(l.um) && l.fin % 1 !== 0), 'Revisar si se contó por empaque o por unidad.', null, ['cons', {}]);
  add('sobrpuro', 'warn', 'Sobrantes de ítems con existencia en cero', 'Hay mercancía física que el sistema no tiene', L.filter(l => l.teo === 0 && l.nov === 'SOBRANTE').sort(byV), 'Buscar compras sin causar o traslados pendientes antes de ajustar.', null, ['cons', { nov: 'SOBRANTE' }]);
  add('faltpuro', 'warn', 'Faltantes totales', 'Existencia en sistema y nada físico', L.filter(l => l.teo > 0 && l.fin === 0).sort(byV), 'Confirmar ventas sin facturar, averías o ubicación en otra zona.', null, ['cons', { nov: 'FALTANTE' }]);
  if (av.estado === 'abierta') {
    const quietos = Object.values(av.porOp).filter(o => o.asig > 0 && o.cont < o.asig && (!o.ult || Date.now() - o.ult > (+P.inactMin || 30) * 60000));
    add('quietos', 'info', 'Operadores sin registros recientes', `Más de ${P.inactMin} minutos sin registrar y con ítems pendientes`, quietos.map(o => ({ nombre: o.nombre, cont: o.cont, asig: o.asig, ult: o.ult })), 'Preguntar si tienen dificultades con la lista o con el celular.', [{ k: 'nombre', l: 'Operador' }, { l: 'Contados', n: 1, f: q => fmtN(q.cont) }, { l: 'Asignados', n: 1, f: q => fmtN(q.asig) }, { l: 'Último registro', f: q => hace(q.ult) }], ['tablero', {}]);
  }
  add('cero', 'info', 'Ítems con costo en cero y diferencia', 'La diferencia no se valoriza', L.filter(l => !l.cp && l.difAj), 'Revisar el costo en SIESA antes de ajustar.', null, ['cons', { dif: true }]);
  const ordenSev = { bad: 0, warn: 1, info: 2 }; H.sort((a, b) => ordenSev[a.sev] - ordenSev[b.sev] || Math.abs(b.valor || 0) - Math.abs(a.valor || 0));
}

/* ---- src/js/03_control.js ---- */
/* =====================================================================
   03 · Centro de control: inicio, tablero en vivo, rondas, consolidado y puntos a revisar
   ===================================================================== */
const RENDER = {}, FILTROS = { cons: {} };
let VISTA = 'inicio', T_SUB = '', T_R = 0, C_EST = '', REV_SEV = '', REV_ABRIR = null, D_TAB = 'items';
const TIT = { inicio: ['Inicio', 'Carga de existencias'], bodega: ['Bodega en vivo', 'Recorrido 3D del conteo'], tablero: ['Tablero en vivo', 'Avance del conteo'], rondas: ['Rondas y asignación', 'Operadores y bloques de conteo'], cons: ['Conteo consolidado', 'Existencia vs. físico por ítem'], revisar: ['Puntos a revisar', 'Hallazgos del auditor'], planos: ['Plano SIESA', 'Conteo físico definitivo'], datos: ['Datos cargados', 'Existencias y bitácora'], params: ['Parámetros', 'Reglas, plano y acceso'] };
const mostrar = ARK.nav(v => { VISTA = v; ST.set('vista', v); const t = TIT[v] || ['', '']; $('#pgTitle').textContent = t[0]; $('#pgSub').textContent = t[1]; animarVista(v); (RENDER[v] || (() => { }))(); window.scrollTo({ top: 0 }); });
/* v4: al cambiar de pantalla, la sección entra con un deslizamiento suave y sus tarjetas aparecen escalonadas (solo en ese momento, no en cada refresco en vivo) */
function animarVista(v) { const s = $('#v-' + v); if (!s) return; s.classList.remove('v4-anim'); void s.offsetWidth; s.classList.add('v4-anim'); clearTimeout(s._anim); s._anim = setTimeout(() => s.classList.remove('v4-anim'), 1600); }
function saludoHora() { const h = new Date().getHours(); return h < 12 ? 'Buenos días' : h < 18 ? 'Buenas tardes' : 'Buenas noches'; }
/* Menú lateral contraíble: en pantallas de portátil arranca contraído para dar espacio a las tablas */
(function menuLateral() {
  const app = $('#ctlApp'), tg = $('#sideTg'); let pref = null; try { pref = localStorage.getItem('agro_menu'); } catch (e) { }
  const aplicar = mini => { app.classList.toggle('mini', mini); tg.textContent = mini ? '»' : '«'; };
  aplicar(pref ? pref === 'mini' : window.innerWidth < 1500);
  $$('.nav-item').forEach(b => { const t = b.querySelector('span:not(.ic)'); if (t && !b.title) b.title = t.textContent; });
  tg.onclick = () => { const mini = !app.classList.contains('mini'); aplicar(mini); try { localStorage.setItem('agro_menu', mini ? 'mini' : 'full'); } catch (e) { } setTimeout(() => window.dispatchEvent(new Event('resize')), 250); };
})();
function ir(v, f) { if (f && v === 'cons') { Object.assign(FILTROS.cons, f); aplicarFiltrosCons(); } mostrar(v); }
function renderTodo() { renderTop(); (RENDER[VISTA] || (() => { }))(); const n = H.filter(h => h.sev === 'bad').length; const b = $('#navRev'); b.hidden = !n; b.textContent = n; }
function kpi(o) {
  const attr = o.go ? ` class="kpi ${o.c || ''} click" tabindex="0" role="button" data-k="${esc(o.go)}"` : ` class="kpi ${o.c || ''}"`;
  return `<div${attr}>${o.ic ? `<span class="ki">${ARK.svg(o.ic)}</span>` : ''}<span class="l">${esc(o.l)}</span><span class="v">${o.v}</span><span class="s">${esc(o.s || '')}</span>${o.bar != null ? `<div class="bar"><i style="width:${Math.max(0, Math.min(100, o.bar * 100)).toFixed(1)}%"></i></div>` : ''}</div>`;
}
function wireKpis(host, map) { host.querySelectorAll('[data-k]').forEach(el => { const f = () => map[el.dataset.k] && map[el.dataset.k](); el.onclick = f; el.onkeydown = e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); f(); } }; }); }
const empty = (t, x) => `<div class="empty"><b>${esc(t)}</b>${esc(x || '')}</div>`;
const estadoRonda = r => DB.inv ? DB.inv.rondas[r].estado : 'pendiente';
const NOMR = { 1: 'Ronda 1 · conteo completo', 2: 'Ronda 2 · reconteo de diferencias', 3: 'Ronda 3 · tercer conteo' };
const pillTipo = b => { const t = tipoBlk(b); return t ? `<span class="pill ${t === 'F' ? 'p-bad' : 'p-ok'}">${t === 'F' ? 'FALTANTES' : 'SOBRANTES'}</span> ` : ''; };
const blkHtml = b => pillTipo(b) + esc(subDeBlk(b));
const avanceHtml = (c, t) => `<div class="av2"><div class="avance ${t && c >= t ? 'ok' : ''}"><i style="width:${t ? Math.min(100, c / t * 100) : 0}%"></i></div><span>${fmtN(c)}/${fmtN(t)}</span></div>`;
const conteosHtml = r => `<span class="cts">${[r.c1, r.c2, r.c3].map((v, i) => `<i class="${v == null ? 'nul' : r.finR === i + 1 ? 'fin' : ''}">${fmtQ(v)}</i>`).join('')}</span>`;
const VIVO = { ok: true, ts: Date.now(), msg: '' };
function renderTop() {
  const c = [];
  if (DB.inv) { c.push(`<span class="mchip">${esc(DB.inv.nombre)} · ${ARK.fmtDate(DB.inv.fecha)}</span>`); const e = estadoRonda(DB.inv.ronda); c.push(`<span class="mchip ${e === 'abierta' ? 'y' : ''}">Ronda ${DB.inv.ronda} ${e}</span>`); if (R) { c.push(`<span class="mchip">${fmtN(R.av[DB.inv.ronda].cont)} / ${fmtN(R.av[DB.inv.ronda].total)} contados</span>`); const et = etaTexto(etaRonda(DB.inv.ronda)); if (et && e === 'abierta') c.push(`<span class="mchip eta" title="Estimado según el ritmo de digitación">⏱ ${esc(et)}</span>`); } }
  else c.push('<span class="mchip">Sin inventario: cargue las existencias</span>');
  c.push(`<span class="mchip ${VIVO.ok ? '' : 'off'}" id="chipSrv" title="${esc(VIVO.msg || '')}">${VIVO.ok ? '● En vivo · ' + fmtHs(VIVO.ts) : '○ Sin conexión · reintentando'}</span>`);
  $('#tchips').innerHTML = c.join('');
}

/* ---------- INICIO ---------- */
RENDER.inicio = function () {
  { const inv = DB.inv, av = inv && R ? R.av[inv.ronda] : null, hoy = new Date();
    $('#saludo').innerHTML = `<div class="saludo4"><div class="cl"><img src="data:image/png;base64," alt=""></div><div><h2>${saludoHora()}, Área de Control</h2><p>${inv ? `${esc(inv.nombre)} · ronda ${inv.ronda} ${estadoRonda(inv.ronda)}${av && av.total ? ` · ${pct(av.cont / av.total, 0)} contado` : ''}` : 'Todavía no hay un inventario en curso: cargue la consulta de existencias para empezar.'}</p></div><div class="chips"><span class="y">${esc(ARK.fmtDate(hoy))}</span><span>${inv ? (inv.estado === 'abierto' ? 'Inventario en curso' : 'Inventario cerrado') : 'Sin inventario'}</span><span>${fmtN(DB.ops.length)} operadores</span></div><div class="deco"><svg viewBox="0 0 1000 120" preserveAspectRatio="xMaxYMax slice" aria-hidden="true"><circle cx="880" cy="40" r="26" fill="#FFCD00"/><path d="M0 120 C 200 60, 400 90, 600 70 S 900 40, 1000 60 V120z" fill="#fff"/><path d="M0 120 C 300 100, 600 115, 1000 95 V120z" fill="#fff" opacity=".6"/></svg></div></div>`; }
  const inv = DB.inv;
  if (!inv) { $('#invBox').innerHTML = empty('No hay inventario en curso', 'Cargue la consulta de existencias para crearlo.'); }
  else {
    const av = R ? R.av[inv.ronda] : { cont: 0, total: 0 };
    $('#invBox').innerHTML = `<div class="kv2"><span>Nombre</span><b>${esc(inv.nombre)}</b><span>Fecha</span><b>${ARK.fmtDate(inv.fecha)}</b><span>Estado</span><b>${inv.estado === 'abierto' ? 'En curso' : 'Cerrado'}</b><span>Ronda actual</span><b>${inv.ronda} · ${estadoRonda(inv.ronda)}</b><span>Avance de la ronda</span><b>${fmtN(av.cont)} / ${fmtN(av.total)} (${pct(av.total ? av.cont / av.total : 0, 0)})</b><span>Operadores</span><b>${fmtN(DB.ops.length)}</b><span>Registros en bitácora</span><b>${fmtN(DB.log.length)}</b></div>
      <div class="filters" style="margin:12px 0 0"><button class="btn pri" type="button" data-go="rondas">Rondas y asignación</button><button class="btn" type="button" data-go="tablero">Ver tablero</button><button class="btn" type="button" id="btnNuevoInv" style="margin-left:auto">Nuevo inventario</button></div>`;
    $('#btnNuevoInv').onclick = async () => { const ok = await modal({ titulo: '¿Empezar un inventario nuevo?', html: '<p class="small">El inventario actual se cierra y su hoja de conteos queda archivada en Google (no se borra). Los operadores y las existencias se conservan; las asignaciones empiezan de cero.</p>', ok: 'Empezar uno nuevo' }); if (!ok) return;
      busy(true, 'Creando el inventario…');
      try { DB.inv = invNuevo('Inventario físico ' + ARK.MESES[new Date().getMonth()] + ' ' + new Date().getFullYear()); DB.asig = { 1: {}, 2: {}, 3: {} }; await iniciarInventarioServidor(DB.inv, DB.asig); toast('Inventario nuevo creado. La hoja de conteos anterior quedó archivada en Google.'); }
      catch (e) { toast(e.message || String(e)); } finally { busy(false); }
      calcular(); renderTodo(); };
  }
  const its = Object.values(DB.items);
  if (!its.length) $('#cargaBox').innerHTML = empty('Sin existencias', 'Formato esperado: consulta de existencias por ítem de SIESA.');
  else {
    const porSub = {}; its.forEach(i => { const s = subCorta(i.sub); const p = porSub[s] || (porSub[s] = { sub: s, n: 0, saldo: 0, valor: 0 }); p.n++; if (i.teo > 0) p.saldo++; p.valor += i.teo * i.cp; });
    const rows = Object.values(porSub).sort((a, b) => cmpS(llaveSub(ORD_SUB, a.sub), llaveSub(ORD_SUB, b.sub)));
    $('#cargaBox').innerHTML = `<div class="kv2" style="margin-bottom:10px"><span>Ítems activos</span><b>${fmtN(its.length)}</b><span>Con existencia &gt; 0</span><b>${fmtN(its.filter(i => i.teo > 0).length)}</b><span>Valor a costo (ins)</span><b>${fmt$(its.reduce((a, i) => a + i.teo * i.cp, 0))}</b><span>Inactivos con existencia (se cuentan)</span><b>${fmtN(its.filter(i => i.inact).length)}</b><span>Dejados por fuera</span><b>${fmtN(DB.excl.length)}</b><span>Período de la consulta</span><b>${esc(DB.corte || '—')}</b></div><div id="tblSubIni"></div>`;
    ARK.table($('#tblSubIni'), [{ k: 'sub', l: 'Subgrupo' }, { l: 'Ítems', n: 1, f: r => fmtN(r.n) }, { l: 'Con saldo', n: 1, f: r => fmtN(r.saldo) }, { l: 'Valor', n: 1, f: r => fmt$(r.valor) }], rows, { size: 30, maxh: '300px' });
  }
  $$('[data-go]').forEach(b => b.onclick = () => mostrar(b.dataset.go));
};
ARK.zonaCarga('#dropAll', cargarExistencias);
$('#btnRespaldo').onclick = respaldo;
$('#fRest').addEventListener('change', e => { restaurar(e.target.files[0]); e.target.value = ''; });

/* ---------- TABLERO EN VIVO ---------- */
RENDER.tablero = function () {
  if (!R) { $('#kpisT').innerHTML = ''; $('#tblOps').innerHTML = $('#tblLog').innerHTML = $('#tblPend').innerHTML = empty('Sin inventario', 'Cargue las existencias en Inicio.'); return; }
  const rs = [1, 2, 3].filter(r => estadoRonda(r) !== 'pendiente' || r === DB.inv.ronda);
  const sel = $('#t_ronda'); const keep = T_R || DB.inv.ronda; sel.innerHTML = rs.map(r => `<option value="${r}">Ronda ${r} · ${estadoRonda(r)}</option>`).join(''); sel.value = String(rs.includes(keep) ? keep : DB.inv.ronda); T_R = +sel.value;
  const av = R.av[T_R], blks = av.lista;
  ARK.selOpts($('#t_sub'), blks.map(s => s.blk), 'Todos los bloques', T_SUB); T_SUB = $('#t_sub').value;
  const vis = T_SUB ? blks.filter(s => s.blk === T_SUB) : blks;
  const total = vis.reduce((a, s) => a + s.total, 0), cont = vis.reduce((a, s) => a + s.cont, 0), nDif = vis.reduce((a, s) => a + s.nDif, 0);
  const codes = new Set(hojaRonda(T_R).filter(c => !T_SUB || blk(c, T_R) === T_SUB)); const lines = R.lines.filter(l => codes.has(l.k));
  let vFalt = 0, vSobr = 0; lines.forEach(l => { const e = estadoTras(l.k, T_R); if (e.difAj < 0) vFalt += e.difAj * l.cp; else if (e.difAj > 0) vSobr += e.difAj * l.cp; });
  const ahora = Date.now(), ops = Object.values(av.porOp), activos = ops.filter(o => o.ult && ahora - o.ult < 15 * 60000).length;
  const ult1h = Object.values(DB.cont[T_R] || {}).filter(x => ahora - x.ts < 36e5).length;
  $('#kpisT').innerHTML = [
    { l: 'Avance de la ronda', v: pct(total ? cont / total : 0, 0), s: `${fmtN(cont)} de ${fmtN(total)} ítems`, c: 'brand', bar: total ? cont / total : 0, ic: 'target' },
    { l: 'Sin contar', v: fmtN(total - cont), s: total - cont ? 'la ronda no cierra hasta llegar a 0' : 'listo para cerrar', c: total - cont ? 'warn' : 'ok', go: 'pend', ic: 'clock' },
    { l: 'Operadores activos', v: fmtN(activos), s: `de ${fmtN(ops.length)} · últimos 15 min`, c: 'brand', ic: 'users' },
    { l: 'Ritmo última hora', v: fmtN(ult1h), s: 'ítems contados / hora', c: 'or', ic: 'zap' },
    { l: 'Con diferencia', v: fmtN(nDif), s: cont ? `${pct(nDif / cont, 1)} de lo contado` : '—', c: nDif ? 'bad' : 'ok', go: 'dif', ic: 'alert' },
    { l: 'Diferencia neta', v: fmtM(vFalt + vSobr), s: `faltante ${fmtM(vFalt)} · sobrante ${fmtM(vSobr)}`, c: 'acc', ic: 'scale' },
    (() => { const e = etaRonda(T_R); const abierta = e && e.estado === 'abierta'; return { l: abierta ? 'Termina hacia las' : e && e.estado === 'cerrada' ? 'Cerrada' : 'Finalización', v: abierta ? (e.fin && !e.detenido ? fmtHm(e.fin) : e.detenido ? 'detenido' : '—') : e && e.estado === 'cerrada' ? fmtHm(e.fin) : '—', s: abierta ? (e.fin && !e.detenido ? `en ${fmtDur(e.ms)} · ${fmtN(Math.round(e.ritmo))} ítems/h` : e.detenido ? `sin registros desde ${fmtHm(e.ult)}` : 'esperando los primeros conteos') : 'la ronda no está abierta', c: abierta && e.fin && !e.detenido ? 'brand' : 'warn', ic: 'clock' }; })()
  ].map(kpi).join('');
  wireKpis($('#kpisT'), { pend: () => ir('cons', { est: 'pend', sub: T_SUB ? subDeBlk(T_SUB) : '' }), dif: () => ir('cons', { dif: true, sub: T_SUB ? subDeBlk(T_SUB) : '' }) });
  $('#t_info').textContent = `${NOMR[T_R]} · actualizado ${fmtHs(Date.now())}`;
  $('#liveT').classList.toggle('off', estadoRonda(T_R) !== 'abierta');
  const labs = blks.map(s => s.blk);
  ARK.chart('chSub', { type: 'bar', data: { labels: labs, datasets: [{ label: 'Contados', data: blks.map(s => s.cont), backgroundColor: '#1E6B3C', borderRadius: 4 }, { label: 'Sin contar', data: blks.map(s => s.total - s.cont), backgroundColor: '#DCE7DE', borderRadius: 4 }] },
    options: { indexAxis: 'y', scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, ticks: { font: { size: 11 } } } }, onClick: (e, els) => { if (!els.length) return; const s = labs[els[0].index]; T_SUB = T_SUB === s ? '' : s; RENDER.tablero(); }, plugins: { tooltip: { callbacks: { afterBody: it => { const s = blks[it[0].dataIndex]; return [`Avance ${pct(s.total ? s.cont / s.total : 0, 0)} · ${s.ops.map(opNom).join(', ') || 'sin operador'}`]; } } } } } });
  ARK.table($('#tblOps'), [{ l: 'Operador', f: o => `<span class="dot ${o.ult && ahora - o.ult < 15 * 60000 ? 'on' : o.ult ? 'idle' : 'off'}"></span><a class="lnk" data-op="${o.op}">${esc(o.nombre)}</a>`, cls: 'wrap' }, { l: 'Bloques', f: o => `<span class="small">${resumenBlks(o.blks)}</span>`, cls: 'desc' }, { l: 'Avance', f: o => avanceHtml(o.cont, o.asig) }, { l: 'Ítems/h', n: 1, f: o => o.ritmo ? fmtN(o.ritmo) : '—' }, { l: 'Último', f: o => hace(o.ult), cls: 'wrap' }],
    ops.sort((a, b) => b.cont - a.cont), { size: 30, empty: 'Sin operadores asignados en esta ronda.', after: h => h.querySelectorAll('[data-op]').forEach(a => a.onclick = () => abrirOperador(a.dataset.op)) });
  const rit = ritmoRonda(T_R);
  ARK.chart('chRitmo', { type: 'line', data: { labels: rit.map(x => fmtHs(x.t).slice(0, 5)), datasets: [{ label: 'Registros', data: rit.map(x => x.n), borderColor: '#F28C1E', backgroundColor: 'rgba(242,140,30,.15)', fill: true, tension: .3, pointRadius: 2 }] }, options: { scales: { y: { beginAtZero: true } }, plugins: { legend: { display: false } } } });
  { const e = etaRonda(T_R), base = rit.length ? `Inicio ${fmtH(e && e.ini ? e.ini : rit[0].t)} · pico ${fmtN(Math.max(...rit.map(x => x.n)))} registros en 15 min` : 'Aún no hay registros en esta ronda.'; const txt = etaTexto(e, true);
    $('#ritmo').innerHTML = `<span>${esc(base)}</span>${txt ? `<div class="eta ${e.detenido ? 'off' : ''}">${ARK.svg('clock')}<b>${esc(txt)}</b></div>` : ''}`; }
  const difS = blks.map(s => s.vDif);
  ARK.chart('chDif', { type: 'bar', data: { labels: labs, datasets: [{ label: 'Diferencia $', data: difS, backgroundColor: difS.map(v => v < 0 ? '#C8102E' : '#17824A'), borderRadius: 4 }] }, options: { indexAxis: 'y', scales: { x: { ticks: { callback: v => fmtM(v) } } }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => fmt$(c.raw) } } } } });
  const pendBlk = blks.filter(s => s.total > s.cont).map(s => ({ blk: s.blk, pend: s.total - s.cont, total: s.total, ops: s.ops.map(opNom).join(', ') || '—', ult: s.ult }));
  ARK.table($('#tblPend'), [{ l: 'Bloque', f: s => blkHtml(s.blk) + `<small class="sub2">${esc(s.ops)} · ${hace(s.ult)}</small>`, cls: 'desc' }, { l: 'Sin contar', n: 1, f: s => `<b class="neg">${fmtN(s.pend)}</b> <span class="muted small">de ${fmtN(s.total)}</span>` }, { l: '', f: s => `<button class="btn" data-pend="${esc(s.blk)}">Ver</button>` }], pendBlk, { size: 30, maxh: '420px', empty: 'Todo contado en esta ronda.', after: h => h.querySelectorAll('[data-pend]').forEach(b => b.onclick = () => ir('cons', { est: 'pend', sub: subDeBlk(b.dataset.pend) })) });
  const log = DB.log.filter(x => x.r === T_R).slice(-40).reverse();
  ARK.table($('#tblLog'), [{ l: 'Hora', f: x => fmtHs(x.ts) }, { l: 'Operador', f: x => esc(opNom(x.op)) }, { l: 'Ítem', f: x => esc(x.item) }, { l: 'Descripción · bloque', f: x => esc((DB.items[x.item] || {}).desc || ((DB.cont[x.r] || {})[x.item] || {}).desc || '') + `<small class="sub2">${blkHtml(DB.items[x.item] ? blk(x.item, x.r) : SIN_SUB)}</small>`, cls: 'desc' }, { l: 'Cantidad', n: 1, f: x => x.q == null ? '<span class="muted">borrado</span>' : `<b>${fmtQ(x.q)}</b>` }, { l: 'Antes', n: 1, f: x => x.prev == null ? '' : fmtQ(x.prev) }], log, { size: 40, maxh: '380px', empty: 'Todavía no hay registros.', rowAttr: x => `class="clk" data-it="${esc(x.item)}"`, after: h => h.querySelectorAll('tr[data-it]').forEach(tr => tr.onclick = () => abrirDetalle(tr.dataset.it)) });
};
$('#t_ronda').addEventListener('change', e => { T_R = +e.target.value; RENDER.tablero(); });
$('#t_sub').addEventListener('change', e => { T_SUB = e.target.value; RENDER.tablero(); });

/* ---------- RONDAS Y ASIGNACIÓN ---------- */
async function guardarRondas() { calcular(); renderTodo(); try { await guardarServidor({ inv: DB.inv, asig: DB.asig, ops: DB.ops, rep: DB.rep }); } catch (e) { toast('No se pudo guardar en el servidor: ' + (e.message || e) + '. Se reintenta al refrescar.'); PEND_GUARDAR = true; } }
let PEND_GUARDAR = false;
RENDER.rondas = function () {
  if (!DB.inv) { $('#rondaStrip').innerHTML = empty('Sin inventario', 'Cargue las existencias en Inicio.'); $('#tblOperadores').innerHTML = $('#tblAsig').innerHTML = $('#asigTipo').innerHTML = ''; return; }
  const inv = DB.inv, rA = +inv.ronda;
  $('#rondaStrip').innerHTML = [1, 2, 3].map(r => {
    const e = estadoRonda(r), av = R.av[r], prevCerr = r === 1 || estadoRonda(r - 1) === 'cerrada';
    const cand = r > 1 && e === 'pendiente' && prevCerr && r === rA + 1 ? candidatosRonda(r) : null;
    const nF = cand ? Object.values(cand.tipo).filter(t => t === 'F').length : 0, nS = cand ? cand.items.length - nF : 0;
    const acts = [];
    if (inv.estado === 'abierto') {
      if (e === 'pendiente' && r === 1) acts.push(`<button class="btn pri" data-r="${r}" data-a="abrir">Abrir ronda 1</button>`);
      if (cand && cand.items.length) acts.push(`<button class="btn or" data-r="${r}" data-a="preparar">Preparar ronda ${r} · ${fmtN(nF)} faltantes / ${fmtN(nS)} sobrantes</button>`);
      if (cand && !cand.items.length) acts.push(`<span class="small muted">Sin diferencias: no hace falta la ronda ${r}.</span>`);
      if (e === 'lista') acts.push(`<button class="btn pri" data-r="${r}" data-a="abrir">Abrir ronda ${r}</button>`, `<button class="btn" data-r="${r}" data-a="recalc">Recalcular lista</button>`);
      if (e === 'abierta') acts.push(`<button class="btn pri" data-r="${r}" data-a="cerrar">Cerrar ronda ${r}</button>`);
      if (e === 'cerrada' && r === rA) acts.push(`<button class="btn" data-r="${r}" data-a="reabrir">Reabrir</button>`, `<button class="btn pri" data-r="${r}" data-a="fin">Finalizar inventario</button>`);
    } else if (r === rA) acts.push(`<button class="btn" data-r="${r}" data-a="reabrirInv">Reabrir inventario</button>`);
    const nDif = av.lista.reduce((a, s) => a + s.nDif, 0), tipo = (inv.rondas[r] || {}).tipo || {}, tF = Object.values(tipo).filter(t => t === 'F').length;
    return `<div class="rcard ${e}"><h3>${esc(NOMR[r])}<span class="pill ${e === 'abierta' ? 'p-ok' : e === 'cerrada' ? 'p-info' : e === 'lista' ? 'p-warn' : 'p-mute'}">${e.toUpperCase()}</span></h3>
      <div class="kv"><span>Ítems en la hoja</span><b>${fmtN(av.total)}${r > 1 && av.total ? ` · ${fmtN(tF)} F / ${fmtN(av.total - tF)} S` : ''}</b></div><div class="kv"><span>Contados</span><b>${fmtN(av.cont)} (${pct(av.total ? av.cont / av.total : 0, 0)})</b></div><div class="kv"><span>Con diferencia</span><b>${fmtN(nDif)}</b></div>
      <div class="kv"><span>Abierta</span><b>${fmtH(inv.rondas[r].abierta)}</b></div><div class="kv"><span>Cerrada</span><b>${fmtH(inv.rondas[r].cerrada)}</b></div>${e === 'abierta' ? (() => { const et = etaRonda(r); return `<div class="kv"><span>Termina (estimado)</span><b>${et && et.fin && !et.detenido ? fmtHm(et.fin) + ' · en ' + fmtDur(et.ms) : et && et.detenido ? 'detenido' : '—'}</b></div>`; })() : ''}<div class="acts">${acts.join('')}</div></div>`;
  }).join('') + (inv.estado === 'cerrado' ? `<div class="note" style="grid-column:1/-1;margin:0">Inventario finalizado: la cantidad definitiva de cada ítem es su último conteo. Ya puede generar el plano de SIESA.</div>` : '');
  $$('#rondaStrip [data-a]').forEach(b => b.onclick = () => accionRonda(+b.dataset.r, b.dataset.a));
  // operadores
  const av = R.av[rA];
  ARK.table($('#tblOperadores'), [{ l: 'Nombre', f: o => `<a class="lnk" data-op="${o.id}">${esc(o.nombre)}</a>` }, { l: 'PIN', f: o => o.pin ? `<span class="num">${esc(o.pin)}</span>` : '<span class="muted">sin PIN</span>' }, { l: `Bloques ronda ${rA}`, f: o => `<span class="small">${resumenBlks(Object.keys(DB.asig[rA] || {}).filter(b => (DB.asig[rA][b] || []).includes(o.id)).sort(CMP_BLK))}</span>`, cls: 'desc' }, { l: 'Contados', n: 1, f: o => `${fmtN((av.porOp[o.id] || {}).cont || 0)}<span class="muted"> / ${fmtN((av.porOp[o.id] || {}).asig || 0)}</span>` }, { l: '', f: o => `<button class="btn" data-del="${o.id}" title="Quitar">✕</button>` }], DB.ops, { size: 50, empty: 'Agregue los operadores que van a contar.', after: h => { h.querySelectorAll('[data-op]').forEach(a => a.onclick = () => abrirOperador(a.dataset.op)); h.querySelectorAll('[data-del]').forEach(b => b.onclick = async () => { const id = b.dataset.del; const tiene = Object.values(DB.cont).some(c => Object.values(c).some(x => x.op === id)); if (tiene) { toast('Este operador ya tiene registros: no se puede quitar, solo desasignar.'); return; } DB.ops = DB.ops.filter(o => o.id !== id); [1, 2, 3].forEach(r => Object.keys(DB.asig[r]).forEach(s => DB.asig[r][s] = DB.asig[r][s].filter(x => x !== id))); guardarRondas(); }); } });
  // asignación de la ronda actual
  const e = estadoRonda(rA); $('#asigTag').textContent = `ronda ${rA} · ${e}`;
  const blks = av.lista, opts = DB.ops.map(o => `<option value="${o.id}">${esc(o.nombre)}</option>`).join('');
  const hayF = blks.some(b => b.tipo === 'F'), hayS = blks.some(b => b.tipo === 'S');
  $('#asigTipo').innerHTML = rA > 1 && (hayF || hayS) ? `<div class="opbox" style="margin-bottom:12px">${hayF ? `<label class="fld"><span><span class="pill p-bad">FALTANTES</span> todos a</span><select data-tipo="F"><option value="">elegir operador…</option>${opts}</select></label>` : ''}${hayS ? `<label class="fld"><span><span class="pill p-ok">SOBRANTES</span> todos a</span><select data-tipo="S"><option value="">elegir operador…</option>${opts}</select></label>` : ''}<span class="small muted">Asigna de una vez todos los bloques de ese tipo, en el orden de los subgrupos. Luego puede ajustar bloque por bloque.</span></div>` : '';
  $$('#asigTipo [data-tipo]').forEach(sl => sl.onchange = () => { const id = sl.value; if (!id) return; blks.filter(b => b.tipo === sl.dataset.tipo).forEach(b => { DB.asig[rA][b.blk] = [id]; }); guardarRondas(); toast(`Todos los ${sl.dataset.tipo === 'F' ? 'faltantes' : 'sobrantes'} asignados a ${opNom(id)}.`); });
  { const n = blks.filter(b => b.ops.length > 1).length, av0 = $('#asigNota'); if (av0) av0.innerHTML = n && !DB.srvRep ? `<div class="banner" style="margin:0 0 10px">${fmtN(n)} bloque${n === 1 ? '' : 's'} con varios operadores: para que cada celular reciba solo su parte hay que actualizar el script al <b>servidor v4</b>. Con el servidor actual todos ven el bloque completo.</div>` : (n ? `<p class="muted small" style="margin:0 0 8px">${fmtN(n)} bloque${n === 1 ? '' : 's'} repartido${n === 1 ? '' : 's'} entre varios operadores: por defecto en <b>partes iguales y contiguas</b>; con ✎ se ajusta ítem por ítem. Cada celular solo ve lo suyo.</p>` : ''); }
  if (!blks.length) { $('#tblAsig').innerHTML = empty(rA > 1 ? 'La ronda aún no tiene lista' : 'Sin ítems', rA > 1 ? 'Prepare la ronda para ver qué bloques tienen diferencias.' : 'Cargue las existencias.'); return; }
  ARK.table($('#tblAsig'), [{ l: 'Bloque', f: s => blkHtml(s.blk) }, { l: 'Ítems', n: 1, f: s => fmtN(s.total) }, { l: 'Contados', n: 1, f: s => fmtN(s.cont) }, { l: 'Operadores', f: s => `<div class="chips">${s.ops.map(id => `<span class="chip on"><a class="lnk" data-op="${id}">${esc(opNom(id))}</a>${s.ops.length > 1 && s.porOp[id] ? `<small class="cnt">${fmtN(s.porOp[id].cont)}/${fmtN(s.porOp[id].asig)}</small>` : ''}<button class="x" data-un="${esc(s.blk)}|${id}" title="Quitar">✕</button></span>`).join('')}<select data-add="${esc(s.blk)}" class="small" style="border:1px solid var(--line);border-radius:8px;padding:2px 6px"><option value="">+ asignar…</option>${opts}</select>${s.ops.length > 1 ? `<button class="btn rep ${s.cambios ? 'manual' : ''}" data-rep="${esc(s.blk)}" title="Repartir los ítems del bloque entre sus operadores">${s.cambios ? `Reparto manual · ${fmtN(s.cambios)} cambio${s.cambios === 1 ? '' : 's'}` : 'Partes iguales'} ✎</button>` : ''}</div>` }],
    blks, { size: 80, maxh: '560px', after: h => { h.querySelectorAll('[data-rep]').forEach(b => b.onclick = () => abrirReparto(b.dataset.rep)); h.querySelectorAll('[data-op]').forEach(a => a.onclick = () => abrirOperador(a.dataset.op)); h.querySelectorAll('[data-add]').forEach(s => s.onchange = () => { const id = s.value; if (!id) return; const a = DB.asig[rA][s.dataset.add] || (DB.asig[rA][s.dataset.add] = []); if (!a.includes(id)) a.push(id); guardarRondas(); });
      h.querySelectorAll('[data-un]').forEach(b => b.onclick = () => { const i = b.dataset.un.lastIndexOf('|'), bk = b.dataset.un.slice(0, i), id = b.dataset.un.slice(i + 1); DB.asig[rA][bk] = (DB.asig[rA][bk] || []).filter(x => x !== id); guardarRondas(); }); } });
};
$('#op_add').onclick = () => { const n = $('#op_nom').value.trim(), pin = $('#op_pin').value.trim(); if (!n) return toast('Escriba el nombre.'); if (DB.ops.some(o => norm(o.nombre) === norm(n))) return toast('Ese operador ya existe.'); DB.ops.push({ id: uid(), nombre: n, pin, creado: Date.now() }); $('#op_nom').value = ''; $('#op_pin').value = ''; guardarRondas(); };
$('#op_nom').addEventListener('keydown', e => { if (e.key === 'Enter') $('#op_add').click(); });
$('#asigAuto').onclick = () => {
  if (!DB.inv || !DB.ops.length) return toast('Primero agregue operadores.');
  const rA = +DB.inv.ronda, blks = R.av[rA].lista, carga = DB.ops.map(o => ({ id: o.id, n: 0 })); DB.asig[rA] = {};
  // reparte en el orden de los subgrupos, equilibrando la cantidad de ítems por operador
  blks.forEach(s => { carga.sort((a, b) => a.n - b.n); DB.asig[rA][s.blk] = [carga[0].id]; carga[0].n += s.total; });
  guardarRondas(); toast('Bloques repartidos por cantidad de ítems. Ajuste a mano lo que necesite.');
};
/* v7.1: todos los operadores en todos los bloques, cada bloque dividido por partes iguales y contiguas */
$('#asigTodos').onclick = () => {
  if (!DB.inv || !DB.ops.length) return toast('Primero agregue operadores.');
  const rA = +DB.inv.ronda, blks = R.av[rA].lista, ids = DB.ops.map(o => o.id); DB.asig[rA] = {}; DB.rep[rA] = {};
  blks.forEach(s => { DB.asig[rA][s.blk] = ids.slice(); });
  guardarRondas(); toast(ids.length > 1 ? `Cada bloque dividido por partes iguales entre ${ids.length} operadores.` : 'Todos los bloques asignados al único operador.');
};
$('#asigClear').onclick = () => { if (!DB.inv) return; DB.asig[DB.inv.ronda] = {}; guardarRondas(); };
async function accionRonda(r, a) {
  const inv = DB.inv, rd = inv.rondas[r];
  if (a === 'abrir') { const sinAsig = R.av[r].lista.filter(s => s.total && !s.ops.length).length; if (sinAsig) { const ok = await modal({ titulo: `Hay ${sinAsig} bloques sin operador`, html: '<p class="small">Puede abrir la ronda y asignarlos después; los operadores verán los nuevos bloques al refrescar. La ronda no se podrá cerrar hasta que todo esté contado.</p>', ok: 'Abrir de todas formas' }); if (!ok) return; } rd.estado = 'abierta'; rd.abierta = Date.now(); inv.ronda = r; }
  if (a === 'cerrar') {
    const av = R.av[r], pend = av.total - av.cont;
    if (pend) {
      const lista = av.lista.filter(s => s.total > s.cont);
      const ver = await modal({ titulo: `No se puede cerrar la ronda ${r}`, html: `<p class="small">Faltan <b>${fmtN(pend)}</b> ítems por contar en ${fmtN(lista.length)} bloques. Nada puede quedar sin contar: si un ítem no está, el operador debe registrar <b>0</b>.</p><div class="kv2" style="margin-top:8px">${lista.slice(0, 8).map(s => `<span>${blkHtml(s.blk)}</span><b>${fmtN(s.total - s.cont)} · ${esc(s.ops.map(opNom).join(', ') || 'sin operador')}</b>`).join('')}</div>`, ok: 'Ver lo que falta', cancel: 'Volver' });
      if (ver) ir('cons', { est: 'pend' }); return;
    }
    const ok = await modal({ titulo: `¿Cerrar la ronda ${r}?`, html: `<p class="small">Contados ${fmtN(av.cont)} de ${fmtN(av.total)}. Los operadores dejan de poder registrar en esta ronda.${r < 3 ? ' Después podrá preparar la siguiente con las diferencias, separadas en faltantes y sobrantes, o finalizar el inventario.' : ''}</p>`, ok: 'Cerrar ronda' }); if (!ok) return; rd.estado = 'cerrada'; rd.cerrada = Date.now();
  }
  if (a === 'reabrir') { rd.estado = 'abierta'; rd.cerrada = null; if (r < 3 && inv.rondas[r + 1].estado === 'lista') { inv.rondas[r + 1].estado = 'pendiente'; inv.rondas[r + 1].items = []; inv.rondas[r + 1].tipo = {}; } }
  if (a === 'preparar' || a === 'recalc') {
    const { items, tipo } = candidatosRonda(r); if (!items.length) { toast('No hay diferencias: no hace falta la ronda ' + r + '. Puede finalizar el inventario.'); return; }
    rd.items = items; rd.tipo = tipo; rd.estado = 'lista'; inv.ronda = r; if (a === 'preparar') DB.asig[r] = {};
    const nF = Object.values(tipo).filter(t => t === 'F').length;
    toast(`Ronda ${r} lista: ${fmtN(nF)} faltantes y ${fmtN(items.length - nF)} sobrantes. Asigne operadores y ábrala.`);
  }
  if (a === 'fin') { const ok = await modal({ titulo: '¿Finalizar el inventario?', html: '<p class="small">Se cierra el conteo. La cantidad definitiva de cada ítem es su último conteo y queda lista para el plano de SIESA. Puede reabrirlo si hace falta.</p>', ok: 'Finalizar' }); if (!ok) return; inv.estado = 'cerrado'; }
  if (a === 'reabrirInv') inv.estado = 'abierto';
  await guardarRondas(); if (a === 'preparar' || a === 'recalc') mostrar('rondas');
}

/* ---------- CONSOLIDADO ---------- */
function aplicarFiltrosCons() { const f = FILTROS.cons; C_EST = ''; if ('nov' in f) $('#c_nov').value = f.nov || ''; else $('#c_nov').value = ''; if (f.est) { C_EST = f.est; $('#c_nov').value = ''; } if ('dif' in f) C_EST = f.dif ? 'dif' : C_EST; if ('sub' in f) { ARK.selOpts($('#c_sub'), R ? R.subs : [], 'Todos los subgrupos', f.sub || ''); } if ('q' in f) $('#c_q').value = f.q || ''; FILTROS.cons = {}; ARK.resetPage('tblCons'); }
RENDER.cons = function () {
  if (!R) { $('#kpisC').innerHTML = ''; $('#tblCons').innerHTML = empty('Sin inventario', 'Cargue las existencias en Inicio.'); return; }
  ARK.selOpts($('#c_sub'), R.subs, 'Todos los subgrupos');
  $$('#c_est button').forEach(b => b.classList.toggle('on', b.dataset.v === C_EST));
  const q = norm($('#c_q').value), sub = $('#c_sub').value, nov = $('#c_nov').value;
  const rows = R.lines.concat(R.nuevos).filter(l => (!q || norm(l.item + ' ' + l.ref + ' ' + l.desc).includes(q)) && (!sub || l.sub === sub) && (!nov || l.nov === nov) && (C_EST !== 'dif' || l.difAj) && (C_EST !== 'pend' || l.pendAct || l.nov === 'PENDIENTE') && (C_EST !== 'cont' || l.contado)).sort((a, b) => Math.abs(b.vDif) - Math.abs(a.vDif) || cmpS(llaveSub(ORD_SUB, a.sub), llaveSub(ORD_SUB, b.sub)));
  const a = agg(rows);
  const pendR = rows.filter(l => l.pendAct).length;
  $('#kpisC').innerHTML = [{ l: 'Ítems', v: fmtN(a.n), s: `${fmtN(a.cont)} contados · ${fmtN(pendR || a.pend)} sin contar en la ronda ${R.rAct}`, c: 'brand', ic: 'box' }, { l: 'Exactitud', v: pct(a.exact, 1), s: 'sin novedad sobre contados', c: a.exact >= .9 ? 'ok' : 'warn', ic: 'target' }, { l: 'Faltantes', v: fmtN(a.falt), s: fmt$(a.vFalt), c: 'bad', ic: 'minus' }, { l: 'Sobrantes', v: fmtN(a.sobr), s: fmt$(a.vSobr), c: 'ok', ic: 'plus' }, { l: 'Diferencia neta', v: fmtM(a.vNeto), s: 'sobrante − faltante', c: 'acc', ic: 'scale' }, { l: 'Valor en sistema', v: fmtM(a.vTeo), s: 'existencia × costo (ins)', c: 'brand', ic: 'coins' }].map(kpi).join('');
  ARK.table($('#tblCons'), [{ l: 'Ítem', f: r => `<span class="num">${esc(r.item)}</span>` }, { l: 'Descripción', f: r => esc(r.desc) + (r.inact ? ' <span class="pill p-warn">INACTIVO</span>' : '') + `<small class="sub2">${esc(r.sub)} · ${esc(r.um)}${r.obs ? ' · «' + esc(r.obs) + '»' : ''}</small>`, cls: 'desc' },
    { l: 'Existencia', n: 1, f: r => fmtQ(r.teo) }, { l: 'C1 · C2 · C3', n: 1, f: conteosHtml }, { l: 'Final', n: 1, f: r => r.fin == null ? '—' : `<b>${fmtQ(r.fin)}</b>` }, { l: 'Diferencia', n: 1, f: r => `<span class="${sgn(r.difAj)}">${fmtQ(r.difAj)}</span>` }, { l: 'Valor dif.', n: 1, f: r => `<span class="${sgn(r.vDif)}">${fmt$(r.vDif)}</span>` },
    { l: 'Novedad', f: r => ARK.pill(r.nov, { FALTANTE: 'p-bad', SOBRANTE: 'p-ok', 'SIN NOVEDAD': 'p-info', PENDIENTE: 'p-warn' }) + (r.pendAct && r.nov !== 'PENDIENTE' ? ` <span class="pill p-warn">SIN CONTAR R${R.rAct}</span>` : '') + (r.nuevo ? ' <span class="pill p-warn">NO EN CONSULTA</span>' : '') + (r.fuera ? ' <span class="pill p-warn">FUERA</span>' : ''), cls: 'wrap' }, { l: 'Operador', f: r => esc(opNom(r.op)), cls: 'wrap' }], rows,
    { size: 100, empty: 'Sin ítems con los filtros actuales.', rowAttr: r => `class="clk" data-it="${esc(r.k)}"`, after: h => h.querySelectorAll('tr[data-it]').forEach(tr => tr.onclick = () => abrirDetalle(tr.dataset.it)) });
  RENDER.cons.rows = rows;
};
['#c_q', '#c_sub', '#c_nov'].forEach(s => $(s).addEventListener('input', () => { ARK.resetPage('tblCons'); RENDER.cons(); }));
$$('#c_est button').forEach(b => b.onclick = () => { C_EST = b.dataset.v; if (C_EST === 'pend') $('#c_nov').value = ''; ARK.resetPage('tblCons'); RENDER.cons(); });
$('#btnXlsCons').onclick = () => { const rows = RENDER.cons.rows || []; ARK.exportXlsx(rows.map(r => ({ Ítem: r.item, Referencia: r.ref, Descripción: r.desc, Subgrupo: r.sub, 'U.M.': r.um, Existencia: r.teo, 'Conteo 1': r.c1, 'Conteo 2': r.c2, 'Conteo 3': r.c3, Final: r.fin, 'Conteo que manda': r.finR ? 'R' + r.finR : '', Diferencia: r.difAj, 'Costo (ins)': r.cp, 'Valor diferencia': Math.round(r.vDif), Novedad: r.nov, Inactivo: r.inact ? 'SÍ' : '', Operador: opNom(r.op), Observación: r.obs })), 'CONSOLIDADO', `CONTEO_CONSOLIDADO_AGRO_${ARK.isoDate(new Date())}.xlsx`); };
$('#btnPdfCons').onclick = () => pdfConteo(RENDER.cons.rows || []);

/* ---------- DETALLE DE UN ÍTEM ---------- */
function abrirDetalle(code) {
  const it = DB.items[code]; const l = R && (R.lines.find(x => x.k === code) || R.nuevos.find(x => x.k === code)); if (!l) return;
  const hist = DB.log.filter(x => x.item === code).slice(-30).reverse();
  $('#drawerBody').innerHTML = `<h3>${esc(l.desc)}</h3><p class="muted">Ítem ${esc(l.item)}${l.cod && l.cod !== l.item ? ` (en el plano: ${esc(l.cod)})` : ''} · Ref. ${esc(l.ref)} · ${esc(l.sub)} · ${esc(l.um)}${it ? ' · ' + esc(it.grupo) : ''}${l.inact ? ' · <span class="pill p-warn">INACTIVO</span>' : ''}</p>
    <div class="kpis" style="margin-top:12px">${[{ l: 'Existencia', v: fmtQ(l.teo), s: 'en SIESA', c: 'brand' }, { l: 'Final', v: fmtQ(l.fin), s: l.finR ? 'manda el conteo de la ronda ' + l.finR : 'sin contar', c: 'brand' }, { l: 'Diferencia', v: fmtQ(l.difAj), s: fmt$(l.vDif), c: l.difAj < 0 ? 'bad' : l.difAj > 0 ? 'ok' : 'brand' }, { l: 'Costo (ins)', v: fmt$(l.cp), s: 'valor sistema ' + fmt$(l.vTeo), c: 'acc' }].map(kpi).join('')}</div>
    <h3 style="font-size:15px;margin:10px 0 6px">Conteos por ronda</h3><div class="kv2">${[1, 2, 3].map(r => { const c = (DB.cont[r] || {})[code]; return `<span>Ronda ${r}</span><b>${c ? `${fmtQ(c.q)} · ${esc(opNom(c.op))} · ${fmtH(c.ts)}${c.n > 1 ? ` · ${c.n} cambios` : ''}${c.obs ? ` · «${esc(c.obs)}»` : ''}` : (l.enHoja[r - 1] ? '<span class="muted">pendiente</span>' : '<span class="muted">no está en la hoja</span>')}</b>`; }).join('')}</div>
    <h3 style="font-size:15px;margin:14px 0 6px">Historial</h3><div id="tblHist"></div>`;
  ARK.table($('#tblHist'), [{ l: 'Fecha', f: x => fmtH(x.ts) }, { l: 'R', f: x => x.r }, { l: 'Operador', f: x => esc(opNom(x.op)) }, { l: 'Cantidad', n: 1, f: x => x.q == null ? 'borrado' : fmtQ(x.q) }, { l: 'Antes', n: 1, f: x => x.prev == null ? '' : fmtQ(x.prev) }], hist, { size: 30, maxh: '300px', empty: 'Sin registros.' });
  $('#drawer').classList.add('open'); $('#drawer').setAttribute('aria-hidden', 'false'); $('#drawerBg').hidden = false;
}
function cerrarDetalle() { $('#drawer').classList.remove('open'); $('#drawer').setAttribute('aria-hidden', 'true'); $('#drawerBg').hidden = true; }
$('#drawerX').onclick = $('#drawerBg').onclick = cerrarDetalle;
document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarDetalle(); });

/* ---------- PUNTOS A REVISAR ---------- */
RENDER.revisar = function () {
  $$('#r_sev button').forEach(b => b.classList.toggle('on', b.dataset.v === REV_SEV));
  const a = R ? R.a : null, nb = H.filter(h => h.sev === 'bad').length, nw = H.filter(h => h.sev === 'warn').length, ni = H.filter(h => h.sev === 'info').length;
  const calidad = a && a.cont ? Math.max(0, Math.min(1, a.exact * (1 - Math.min(.5, nb * .06)))) : 0;
  $('#revScore').innerHTML = `${ARK.gauge(calidad, calidad >= .9 ? 'var(--ok)' : calidad >= .75 ? 'var(--orange)' : 'var(--bad)')}<div><b>Índice de calidad del conteo</b><small>Exactitud ${a && a.cont ? pct(a.exact, 1) : '—'} ajustada por hallazgos críticos</small><small><span class="neg">${nb} críticos</span> · ${nw} de atención · ${ni} informativos</small></div>`;
  const list = H.filter(h => !REV_SEV || h.sev === REV_SEV);
  $('#revList').innerHTML = list.length ? list.map((h, i) => `<details class="rv ${h.sev}" data-id="${h.id}" ${REV_ABRIR === h.id ? 'open' : ''}><summary><span class="sev">${{ bad: 'CRÍTICO', warn: 'ATENCIÓN', info: 'INFO' }[h.sev]}</span><div><div class="t">${esc(h.t)}</div><div class="x">${esc(h.x)}</div></div><div class="c">${fmtN(h.n)}${h.valor ? `<small>${fmt$(h.valor)}</small>` : ''}</div><span class="cv">▾</span></summary><div class="body">${h.accion ? `<div class="accion"><b>Qué hacer:</b><span>${esc(h.accion)}</span></div>` : ''}<div class="tb"></div><div class="filters" style="margin:8px 0 0"><button class="btn" data-xh="${h.id}">Excel</button>${h.go ? `<button class="btn" data-gh="${h.id}">Ir a ${esc(TIT[h.go[0]][0])}</button>` : ''}</div></div></details>`).join('') : empty(R ? 'Nada que revisar por ahora' : 'Sin inventario', R ? 'Los hallazgos aparecen a medida que avanza el conteo.' : 'Cargue las existencias en Inicio.');
  const pintar = det => { const h = H.find(x => x.id === det.dataset.id); const tb = det.querySelector('.tb'); if (!h || tb.dataset.ok) return; tb.dataset.ok = 1; tb.id = 'rvt_' + h.id; ARK.table(tb, h.cols, h.rows, { size: 25, maxh: '360px', rowAttr: r => r.item ? `class="clk" data-it="${esc(r.item)}"` : '', after: host => host.querySelectorAll('tr[data-it]').forEach(tr => tr.onclick = () => abrirDetalle(tr.dataset.it)) }); };
  $$('#revList details').forEach(d => { d.addEventListener('toggle', () => d.open && pintar(d)); if (d.open) pintar(d); });
  $$('#revList [data-xh]').forEach(b => b.onclick = () => { const h = H.find(x => x.id === b.dataset.xh); const tmp = document.createElement('div'); ARK.exportXlsx(h.rows.map(r => { const o = {}; h.cols.forEach(c => { tmp.innerHTML = c.f ? c.f(r) : esc(r[c.k]); o[c.l || c.k] = tmp.textContent; }); return o; }), h.id.toUpperCase(), `REVISAR_${h.id.toUpperCase()}_${ARK.isoDate(new Date())}.xlsx`); });
  $$('#revList [data-gh]').forEach(b => b.onclick = () => { const h = H.find(x => x.id === b.dataset.gh); ir(h.go[0], h.go[1]); });
  REV_ABRIR = null;
};
$$('#r_sev button').forEach(b => b.onclick = () => { REV_SEV = b.dataset.v; RENDER.revisar(); });

/* ---- src/js/04_operador.js ---- */
/* =====================================================================
   04 · Hoja de conteo (celular): entrar con el nombre, ver solo ítem y
   descripción de los bloques asignados y registrar cantidades.
   Ronda 1: nunca muestra existencias, costos ni conteos.
   Rondas 2 y 3: muestra si el bloque es de FALTANTES o SOBRANTES y la
   cantidad del conteo anterior, para rectificar.

   Cómo se mantiene al día con muchos celulares a la vez (v3):
   · Lo que el operador escribe queda en la pantalla («local») hasta que el
     servidor devuelve esa misma fila; ningún refresco lo puede borrar.
   · Los conteos salen en lotes (varios ítems por llamada) y la cola se
     guarda en el teléfono: si se va la señal o se recarga, no se pierde.
   · El refresco pide solo lo nuevo desde la última fila leída.
   ===================================================================== */
const OPST = ARK.store('agro_op3_');
const OP = { op: null, pin: '', h: null, ver: '', fila: 1, idx: new Map(), srv: {}, loc: {}, cola: [], fuera: {}, sub: null, filtro: 'pend', q: '',
  timer: null, envTimer: null, enviando: false, refrescando: false, fallos: 0, maestra: null };
const opEl = { body: $('#opBody'), title: $('#opTitle'), who: $('#opWho'), prog: $('#opProg'), bar: $('#opBar'), pct: $('#opPct'), back: $('#opBack'), salir: $('#opSalir'), foot: $('#opFoot'), st: $('#opSt'), footR: $('#opFootR') };
const persistir = () => { if (OP.op && OP.h && OP.h.inv) OPST.set('estado', { opId: OP.op.id, invId: OP.h.inv.id, ronda: OP.h.inv.ronda, cola: OP.cola, loc: OP.loc }); };
const valorDe = c => OP.loc[c] ? OP.loc[c].q : (OP.srv[c] ? OP.srv[c].q : null);
const obsDe = c => OP.loc[c] ? (OP.loc[c].obs || '') : (OP.srv[c] ? OP.srv[c].obs || '' : '');
const quienDe = c => OP.loc[c] ? (OP.op && OP.op.id) : (OP.srv[c] ? OP.srv[c].op : null);
const contadoEn = s => s.items.filter(i => valorDe(i.item) != null).length;

async function opIniciar() {
  const rec = OPST.get('op'); OP.sub = null;
  if (rec && rec.id) { const r = await opCargar(rec.id, rec.pin); if (r) return; }
  opLogin();
}
async function opLogin(msg) {
  OP.op = null; OP.h = null; clearTimeout(OP.timer); opEl.prog.hidden = true; opEl.back.hidden = true; opEl.salir.hidden = true; opEl.foot.hidden = true; opEl.who.textContent = ''; opEl.title.textContent = 'Hoja de conteo';
  let lista = { ops: [], inv: null }; try { lista = await SYNC.opLista(); } catch (e) { msg = 'No hay conexión con el servidor: ' + e.message; }
  OP._ult = 'login'; opAnimar();
  opEl.body.innerHTML = `<div class="op-login"><div class="lg"><div class="cl"><img src="data:image/png;base64," alt="Agrococorollo"></div></div><div class="panel"><h2>¿Quién cuenta?</h2><p class="muted small" style="margin:0 0 12px">${lista.inv ? esc(lista.inv.nombre) : 'Todavía no hay un inventario creado.'}</p>
    <label class="fld">Nombre<select id="lgOp"><option value="">Elija su nombre…</option>${(lista.ops || []).map(o => `<option value="${esc(o.id)}" data-pin="${o.pin ? 1 : 0}">${esc(o.nombre)}</option>`).join('')}</select></label>
    <label class="fld" id="lgPinW" hidden>PIN<input type="password" id="lgPin" inputmode="numeric" autocomplete="off" placeholder="PIN"></label>
    <p class="small neg" id="lgMsg" ${msg ? '' : 'hidden'}>${esc(msg || '')}</p>
    <button class="btn pri" type="button" id="lgGo">Entrar</button></div>
    <p class="muted small" style="text-align:center">Solo verá los bloques que le asignaron. Cada cantidad se guarda al instante, aunque se vaya la señal.</p>
    <p style="text-align:center"><button class="btn ghost" type="button" data-go-portada>← Volver al inicio</button></p></div>`;
  $('#lgOp').onchange = () => { const o = $('#lgOp').selectedOptions[0]; $('#lgPinW').hidden = !(o && o.dataset.pin === '1'); };
  $('#lgGo').onclick = async () => { const id = $('#lgOp').value, btn = $('#lgGo'); if (!id) return; btn.disabled = true; const ok = await opCargar(id, $('#lgPin').value); if (!ok) { btn.disabled = false; const m = $('#lgMsg'); if (m) m.hidden = false; } };
  $('#lgPin').addEventListener('keydown', e => { if (e.key === 'Enter') $('#lgGo').click(); });
  wirePortada();
}
async function opCargar(id, pin) {
  try {
    const r = await SYNC.opEntrar(id, pin); if (!r.ok) { const m = $('#lgMsg'); if (m) m.textContent = r.msg; return false; }
    OP.op = r.op; OP.pin = pin || ''; OPST.set('op', { id, pin: OP.pin });
    aplicarHoja(r, true);
    opEl.who.textContent = r.op.nombre; opEl.salir.hidden = false; opEl.foot.hidden = false; opRender();
    opProgramarRefresco(5000);
    if (OP.cola.length) { opEstado('off', `${OP.cola.length} por enviar`); programarEnvio(50); } else opEstado('', 'Al día ' + fmtHs(Date.now()));
    return true;
  } catch (e) { const m = $('#lgMsg'); if (m) m.textContent = 'Sin conexión: ' + e.message; return false; }
}
/** Recibe la hoja completa del servidor y le pone encima lo que este celular tiene sin confirmar. */
function aplicarHoja(r, alEntrar) {
  const antes = OP.h && OP.h.inv ? OP.h.inv.ronda : null;
  OP.h = r; OP.ver = r.ver; OP.fila = r.fila || 1; OP.idx = new Map();
  (r.subs || []).forEach(s => { s.items = s.items.map(a => Array.isArray(a) ? { item: a[0], ref: a[1], desc: a[2], um: a[3], inact: !!a[4], prev: a[5] } : a); s.items.forEach(i => OP.idx.set(i.item, { i, blk: s.sub })); });
  OP.srv = {}; Object.entries(r.cont || {}).forEach(([k, v]) => { OP.srv[k] = { q: v[0], op: v[1], obs: v[2] || '' }; });
  OP.fuera = {}; (r.fuera || []).forEach(f => { OP.fuera[f.item] = f; });
  if (alEntrar) {   // recuperar lo que quedó sin enviar en este teléfono (solo si es la misma persona, inventario y ronda)
    const g = OPST.get('estado'), misma = g && r.inv && g.opId === r.op.id && g.invId === r.inv.id && g.ronda === r.inv.ronda;
    if (misma) { OP.cola = g.cola || []; OP.loc = g.loc || {}; }
    else { if (g && g.cola && g.cola.length && g.opId === r.op.id) toast(`La ronda cambió: ${g.cola.length} registro(s) que no alcanzaron a enviarse ya no aplican.`); OP.cola = []; OP.loc = {}; }
  } else if (r.inv && antes && r.inv.ronda !== antes) {
    if (OP.cola.length) toast(`La ronda cambió: ${OP.cola.length} registro(s) sin enviar ya no aplican.`);
    OP.cola = []; OP.loc = {}; OP.sub = null; toast('Cambió la ronda: ahora va la ronda ' + r.inv.ronda + '.');
  }
  Object.keys(OP.loc).forEach(k => { if (OP.loc[k].ack) delete OP.loc[k]; });   // confirmados: ya vienen en la hoja del servidor
  OP.cola.forEach(c => { if (c.fuera && c.q != null) OP.fuera[c.item] = Object.assign(OP.fuera[c.item] || {}, { item: c.item, desc: c.desc, q: c.q, obs: c.obs, nuevo: !!c.nuevo }); });
  persistir();
}
/** Un solo ciclo de refresco, con un pequeño desfase al azar para que los celulares no lleguen todos juntos. */
function opProgramarRefresco(ms) {
  clearTimeout(OP.timer);
  const espera = ms != null ? ms : (OP.fallos ? Math.min(30000, 4000 * 2 ** Math.min(3, OP.fallos)) : 4500 + Math.random() * 2000);
  OP.timer = setTimeout(async () => { await opRefrescar(); if (OP.op) opProgramarRefresco(); }, espera);
}
async function opRefrescar() {
  if (!OP.op || OP.refrescando || document.hidden) return; OP.refrescando = true;
  try {
    const r = await SYNC.opRefrescar(OP.op.id, OP.ver, OP.fila);
    if (r.ok === false) { if (/no encontrado/i.test(r.msg || '')) { OPST.del('op'); opLogin(r.msg); } return; }
    if (r.recargar) { const h = await SYNC.opEntrar(OP.op.id, OP.pin); if (h.ok) { aplicarHoja(h, false); opRender(); } else { OPST.del('op'); opLogin(h.msg); return; } }
    else { OP.fila = r.fila || OP.fila; const ch = aplicarFilasOp(r.filas || []); if (ch.size) opRender(true, ch); }
    OP.fallos = 0; if (!OP.cola.length && !OP.enviando) opEstado('', 'Al día ' + fmtHs(Date.now()));
  } catch (e) { OP.fallos++; opEstado('off', OP.cola.length ? `Sin conexión · ${OP.cola.length} por enviar` : 'Sin conexión'); }
  finally { OP.refrescando = false; }
}
function aplicarFilasOp(filas) {
  const ch = new Set(), yo = OP.op.id, ronda = OP.h && OP.h.inv ? OP.h.inv.ronda : 0;
  filas.forEach(([ts, r, item, q, op, obs, fuera, nuevo, desc, id]) => {
    if (r !== ronda) return;
    if (q == null) delete OP.srv[item]; else OP.srv[item] = { q, op, obs: obs || '' };
    if (fuera && op === yo) { if (q == null) delete OP.fuera[item]; else OP.fuera[item] = Object.assign(OP.fuera[item] || {}, { item, desc, q, obs, nuevo: !!nuevo }); }
    const l = OP.loc[item]; if (l && l.id === id) delete OP.loc[item];   // el servidor ya devolvió lo que este celular guardó
    ch.add(item);
  });
  if (ch.size) persistir();
  return ch;
}
document.addEventListener('visibilitychange', () => { if (!document.hidden && OP.op && !PANT.op.hidden) { opRefrescar(); if (OP.cola.length) programarEnvio(50); } });
window.addEventListener('online', () => { if (OP.op && OP.cola.length) programarEnvio(50); });

function opEstado(cls, txt) { opEl.st.className = 'st ' + (cls || ''); opEl.st.querySelector('span').textContent = txt; }
const tituloBlk = b => { const t = tipoBlk(b); return (t ? `<span class="pill ${t === 'F' ? 'p-bad' : 'p-ok'}">${t === 'F' ? 'FALTANTES' : 'SOBRANTES'}</span> ` : '') + esc(subDeBlk(b)); };

function opRender(suave, cambios) {
  const h = OP.h; if (!h) return;
  if (!h.inv) { opEl.title.textContent = 'Hoja de conteo'; opEl.prog.hidden = true; opEl.body.innerHTML = `<div class="op-wait"><div class="big">⏳</div><b>Todavía no hay inventario</b><p>Espere a que el centro de control lo cree.</p></div>`; return; }
  const total = h.subs.reduce((a, s) => a + s.items.length, 0), cont = h.subs.reduce((a, s) => a + contadoEn(s), 0);
  opEl.footR.textContent = `Ronda ${h.inv.ronda} · ${fmtN(cont)} / ${fmtN(total)}`;
  if (!h.inv.abierta) { opEl.title.textContent = `Ronda ${h.inv.ronda}`; opEl.prog.hidden = true; opEl.back.hidden = true; opEl.body.innerHTML = `<div class="op-wait"><div class="big">${h.inv.estado === 'cerrado' ? '✅' : '⏸️'}</div><b>${h.inv.estado === 'cerrado' ? 'Inventario finalizado' : `La ronda ${h.inv.ronda} no está abierta`}</b><p>${h.inv.estado === 'cerrado' ? 'Gracias por su trabajo.' : 'Cuando el centro de control la abra, aquí aparecerán sus bloques. Esta pantalla se actualiza sola.'}</p></div>`; return; }
  if (OP.sub && !h.subs.some(s => s.sub === OP.sub)) OP.sub = null;
  if (suave && OP.pantalla === 'buscar') { opActualizarProgreso(); return; }   // no sacar al operador del buscador
  if (!OP.sub) return opRenderInicio(cont, total);
  opRenderHoja(suave, cambios);
}
function opAnimar() { const b = opEl.body; b.classList.remove('v4-anim'); void b.offsetWidth; b.classList.add('v4-anim'); clearTimeout(b._anim); b._anim = setTimeout(() => b.classList.remove('v4-anim'), 1200); }
function opRenderInicio(cont, total) {
  OP.pantalla = 'lista'; if (OP.pantalla !== OP._ult) opAnimar(); OP._ult = 'lista'; const h = OP.h; opEl.title.textContent = `Ronda ${h.inv.ronda}${h.inv.ronda > 1 ? ' · reconteo' : ''}`; opEl.back.hidden = true;
  opEl.prog.hidden = !total; opEl.bar.style.width = (total ? cont / total * 100 : 0) + '%'; opEl.pct.textContent = pct(total ? cont / total : 0, 0);
  const cards = h.subs.map(s => { const c = contadoEn(s), t = s.items.length, done = t && c >= t; return `<div class="sub-card ${done ? 'done' : ''} ${s.tipo ? 't' + s.tipo : ''}" data-sub="${esc(s.sub)}"><span class="ring">${done ? '✓' : fmtN(t - c)}</span><div class="t"><b>${tituloBlk(s.sub)}</b><span>${fmtN(c)} de ${fmtN(t)} ítems contados${done ? ' · listo' : ''}</span><div class="bar"><i style="width:${t ? c / t * 100 : 0}%"></i></div></div><span class="pc">${pct(t ? c / t : 0, 0)}</span></div>`; }).join('');
  const fuera = Object.values(OP.fuera).filter(f => valorDe(f.item) != null);
  opEl.body.innerHTML = (h.inv.ronda > 1 ? `<div class="op-done" style="background:var(--warn-bg);border-color:#F7C38E;color:var(--warn)">🔁 Reconteo: cada ítem muestra lo que se contó antes. Vuelva a contarlo con calma y escriba la cantidad real, aunque sea la misma.</div>` : '') + (total && cont >= total ? `<div class="op-done">✅ Terminó todo lo asignado. Si encuentra algo más, use «Ítem no listado».</div>` : '') + (cards || `<div class="op-wait"><div class="big">📋</div><b>Aún no tiene bloques asignados</b><p>El centro de control se los asignará en un momento. Esta pantalla se actualiza sola.</p></div>`) +
    `<div class="op-add" id="opAddBtn"><b>＋ Ítem no listado</b><br><span class="small">Encontró algo que no está en sus bloques</span></div>` + (fuera.length ? `<h3 style="font-size:14px;margin:14px 0 6px;color:var(--muted)">Registrados por fuera de sus bloques</h3><div class="items">${fuera.map(i => `<div class="it other done"><div class="c1"><b class="code">${esc(i.item)}</b>${i.nuevo ? '<span class="pill p-warn">NO EN LISTA</span>' : ''}</div><div class="des">${esc(i.desc || '')}</div><div class="q"><input type="text" value="${fmtQ(valorDe(i.item))}" disabled><button class="ok" data-delf="${esc(i.item)}" title="Borrar">✕</button></div></div>`).join('')}</div>` : '');
  $$('.sub-card', opEl.body).forEach(c => c.onclick = () => { OP.sub = c.dataset.sub; OP.filtro = 'pend'; OP.q = ''; opRenderHoja(); window.scrollTo(0, 0); });
  $('#opAddBtn').onclick = opBuscarFuera;
  $$('[data-delf]', opEl.body).forEach(b => b.onclick = () => { if (!confirm('¿Borrar este registro?')) return; const f = OP.fuera[b.dataset.delf] || {}; opGuardar(b.dataset.delf, null, '', { fuera: true, desc: f.desc, nuevo: f.nuevo }); delete OP.fuera[b.dataset.delf]; opRender(); });
}
function opRenderHoja(suave, cambios) {
  OP.pantalla = 'hoja'; if (!suave && (OP._ult !== 'hoja' || OP._sub !== OP.sub)) opAnimar(); OP._ult = 'hoja'; OP._sub = OP.sub; const h = OP.h, s = h.subs.find(x => x.sub === OP.sub); if (!s) return;
  const c = contadoEn(s), t = s.items.length;
  opEl.title.innerHTML = tituloBlk(s.sub); opEl.back.hidden = false; opEl.prog.hidden = false; opEl.bar.style.width = (t ? c / t * 100 : 0) + '%'; opEl.pct.textContent = `${fmtN(c)}/${fmtN(t)}`;
  if (suave && $('#opItems')) {   // actualización en vivo sin perder el foco: solo repinta filas que cambiaron
    const foco = document.activeElement, focoItem = foco && foco.closest && foco.closest('.it') ? foco.closest('.it').dataset.it : null;
    $$('#opItems .it').forEach(el => {
      const code = el.dataset.it; if (code === focoItem || (cambios && !cambios.has(code))) return;
      const v = valorDe(code), inp = el.querySelector('input.qty'), txt = v == null ? '' : String(v);
      if (inp.value !== txt) inp.value = txt;
      el.classList.toggle('done', v != null);
      const by = el.querySelector('.by'); if (by) by.textContent = v != null && quienDe(code) && quienDe(code) !== OP.op.id ? 'contado por otro operador' : '';
    });
    return;
  }
  const q = norm(OP.q); const rows = s.items.filter(i => (OP.filtro !== 'pend' || valorDe(i.item) == null) && (!q || norm(i.item + ' ' + (i.ref || '') + ' ' + i.desc).includes(q)));
  const r2 = h.inv.ronda > 1;
  opEl.body.innerHTML = `<div class="op-tools"><input type="search" id="opQ" placeholder="Buscar ítem o descripción" value="${esc(OP.q)}"><div class="seg"><button type="button" data-f="pend" class="${OP.filtro === 'pend' ? 'on' : ''}">Pendientes</button><button type="button" data-f="todo" class="${OP.filtro === 'todo' ? 'on' : ''}">Todos</button></div></div>
    ${t && c >= t && OP.filtro === 'pend' ? `<div class="op-done">✅ Bloque completo. Puede revisar «Todos» o volver a la lista.</div>` : ''}
    <div class="items ${r2 ? 'r2' : ''}" id="opItems"><div class="it-head"><span>Ítem · U.M.</span><span>Descripción</span>${r2 ? '<span>Conteo anterior</span>' : ''}<span>Cantidad</span><span>Observación</span></div>${rows.map(opFila).join('') || `<div class="op-wait">${q ? 'Nada coincide con la búsqueda.' : 'No hay ítems pendientes aquí.'}</div>`}</div>`;
  $('#opQ').addEventListener('input', e => { OP.q = e.target.value; opRenderHoja(); setTimeout(() => { const el = $('#opQ'); el.focus(); el.setSelectionRange(el.value.length, el.value.length); }, 0); });
  $$('.op-tools [data-f]').forEach(b => b.onclick = () => { OP.filtro = b.dataset.f; opRenderHoja(); });
  opWireFilas();
}
function opFila(i) {
  const v = valorDe(i.item), done = v != null, r2 = OP.h.inv.ronda > 1, otro = done && quienDe(i.item) && quienDe(i.item) !== OP.op.id;
  return `<div class="it ${done ? 'done' : ''}" data-it="${esc(i.item)}"><div class="c1"><b class="code">${esc(i.item)}</b><span class="um">${esc(i.um || 'UND')}</span></div><div class="des">${esc(i.desc)}${i.inact ? ' <span class="pill p-warn">INACTIVO</span>' : ''}<span class="by">${otro ? 'contado por otro operador' : ''}</span></div>
    ${r2 ? `<div class="prevq" title="Lo que se contó en la ronda anterior"><small>Antes</small><b>${fmtQ(i.prev)}</b></div>` : ''}
    <div class="q"><button class="cero" type="button" title="Cero">0</button><input class="qty" type="text" inputmode="decimal" enterkeyhint="next" value="${done ? esc(String(v)) : ''}" placeholder="cant." aria-label="Cantidad"><button class="ok" type="button" title="Guardar">✓</button></div>
    <input class="obs" type="text" placeholder="observación (opcional)" value="${esc(obsDe(i.item))}"></div>`;
}
function opWireFilas() {
  $$('#opItems .it').forEach(el => {
    const inp = el.querySelector('input.qty'), obs = el.querySelector('input.obs'), ok = el.querySelector('.ok'), cero = el.querySelector('.cero'), code = el.dataset.it;
    const guardar = () => {
      const raw = inp.value.trim().replace(',', '.');
      if (raw === '') { if (valorDe(code) != null) { if (!confirm('¿Borrar la cantidad registrada? El ítem vuelve a quedar sin contar.')) { inp.value = String(valorDe(code)); return; } el.classList.remove('done'); opGuardar(code, null, ''); } return; }
      const v = Number(raw); if (!isFinite(v) || v < 0) { toast('Cantidad no válida.'); inp.focus(); return; }
      el.classList.add('done'); el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); inp.value = String(v);
      if (valorDe(code) === v && obsDe(code) === obs.value.trim()) { opSiguiente(el); return; }
      opGuardar(code, v, obs.value.trim()); opSiguiente(el);
    };
    ok.onclick = guardar; cero.onclick = () => { inp.value = '0'; guardar(); };
    inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); guardar(); } });
    inp.addEventListener('blur', () => { const raw = inp.value.trim().replace(',', '.'); if (raw !== '' && String(valorDe(code)) !== raw) guardar(); });
    obs.addEventListener('change', () => { const v = valorDe(code); if (v != null) opGuardar(code, v, obs.value.trim()); });
  });
}
function opSiguiente(el) { let n = el.nextElementSibling; while (n && n.classList.contains('done')) n = n.nextElementSibling; if (n && n.querySelector('input.qty')) { const i = n.querySelector('input.qty'); i.focus({ preventScroll: true }); n.scrollIntoView({ block: 'center', behavior: 'smooth' }); } else { const s = OP.h.subs.find(x => x.sub === OP.sub); if (s && contadoEn(s) >= s.items.length) setTimeout(() => toast('Bloque completo.'), 300); } }

/* ---------- Guardado: cola local + envío por lotes (si se va la señal, reintenta; sobrevive a recargar la página) ---------- */
function opGuardar(item, q, obs, extra) {
  extra = extra || {}; const x = OP.idx.get(item), id = uid() + Math.random().toString(36).slice(2, 5);
  OP.loc[item] = { q, obs: obs || '', id, ts: Date.now() };
  if (extra.fuera && q != null) OP.fuera[item] = { item, desc: extra.desc || '', q, obs: obs || '', nuevo: !!extra.nuevo };
  OP.cola = OP.cola.filter(c => c.item !== item);
  OP.cola.push({ id, r: OP.h.inv.ronda, item, q, obs: obs || '', desc: x ? x.i.desc : (extra.desc || ''), sub: x ? x.blk : 'FUERA DE HOJA', fuera: extra.fuera ? 1 : 0, nuevo: extra.nuevo ? 1 : 0 });
  persistir(); opActualizarProgreso(); programarEnvio();
}
function programarEnvio(ms) { if (OP.envTimer) return; OP.envTimer = setTimeout(() => { OP.envTimer = null; enviarCola(); }, ms != null ? ms : 700); }
async function enviarCola() {
  if (OP.enviando || !OP.op || !OP.cola.length) return; OP.enviando = true;
  const lote = OP.cola.slice(0, 60); let otra = 0;
  opEstado('off', `Guardando ${lote.length}…`);
  try {
    const r = await SYNC.opGuardar(OP.op.id, lote);
    if (!r.ok) {
      const n = OP.cola.length; OP.cola = []; OP.loc = {}; persistir();
      toast((r.msg || 'No se pudo guardar.') + (n ? ` ${n} registro(s) no se guardaron.` : '')); opEstado('bad', r.msg || 'No se pudo guardar');
      const h = await SYNC.opEntrar(OP.op.id, OP.pin); if (h.ok) { aplicarHoja(h, false); opRender(); }
    } else {
      const okIds = new Set(r.ids || []), enLote = new Set(lote.map(c => c.id));
      OP.cola = OP.cola.filter(c => !enLote.has(c.id));          // aceptados o rechazados por ser de otra ronda: salen de la cola
      lote.forEach(c => { const l = OP.loc[c.item]; if (l && l.id === c.id) { if (okIds.has(c.id)) l.ack = true; else delete OP.loc[c.item]; } });
      persistir(); OP.fallos = 0;
      opEstado(OP.cola.length ? 'off' : '', `Guardado ${fmtHs(r.ts)}${OP.cola.length ? ' · ' + OP.cola.length + ' por enviar' : ''}`);
      if (OP.cola.length) otra = 50;
    }
  } catch (e) {
    OP.fallos++; otra = Math.min(20000, 1500 * 2 ** Math.min(4, OP.fallos));
    opEstado('off', `${e.ocupado ? 'Servidor ocupado' : 'Sin conexión'} · ${OP.cola.length} por enviar · reintenta solo`);
  } finally { OP.enviando = false; if (otra && OP.cola.length) programarEnvio(otra); }
}
function opActualizarProgreso() {
  const h = OP.h; if (!h || !h.inv) return;
  const total = h.subs.reduce((a, s) => a + s.items.length, 0), cont = h.subs.reduce((a, s) => a + contadoEn(s), 0);
  opEl.footR.textContent = `Ronda ${h.inv.ronda} · ${fmtN(cont)} / ${fmtN(total)}`;
  if (OP.sub) { const s = h.subs.find(x => x.sub === OP.sub); if (!s) return; const c = contadoEn(s); opEl.bar.style.width = (s.items.length ? c / s.items.length * 100 : 0) + '%'; opEl.pct.textContent = `${fmtN(c)}/${fmtN(s.items.length)}`; }
}
/* ---------- Ítem no listado: buscar en toda la consulta ---------- */
async function opBuscarFuera() {
  OP.pantalla = 'buscar';
  opEl.body.innerHTML = `<div class="panel"><div class="hd"><h2>Ítem no listado</h2><button class="btn" type="button" id="bfBack">← Volver</button></div><p class="muted small" style="margin:0 0 8px">Busque por código o descripción en toda la consulta. Si no aparece, regístrelo como «no encontrado» con la descripción que tenga.</p>
    <input type="search" id="bfQ" placeholder="Código o descripción" style="width:100%;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:16px"><div class="busca-res" id="bfRes"><p class="muted small">Cargando la lista…</p></div></div>`;
  $('#bfBack').onclick = () => { OP.pantalla = ''; opRender(); };
  if (!OP.maestra) { try { OP.maestra = (await SYNC.opMaestra()).maestra.map(a => ({ item: a[0], desc: a[1], sub: a[2], um: a[3] })); } catch (e) { $('#bfRes').innerHTML = `<p class="small neg">Sin conexión: ${esc(e.message)}. Puede registrar el ítem como no encontrado.</p>`; OP.maestra = null; } }
  const q = $('#bfQ'); if (!q) return; q.focus(); $('#bfRes').innerHTML = '';
  q.addEventListener('input', () => { const t = norm(q.value), res = $('#bfRes'); if (t.length < 2) { res.innerHTML = ''; return; }
    const tc = t.replace(/^0+(?=\d)/, ''), hits = (OP.maestra || []).filter(i => i.item === tc || norm(i.item + ' ' + i.desc).includes(t)).slice(0, 25);
    res.innerHTML = hits.map(i => `<button type="button" data-pick="${esc(i.item)}"><span class="c">${esc(i.item)}</span><span>${esc(i.desc)}</span><span class="s">${esc(i.sub)}${OP.idx.has(i.item) ? ' · en su hoja' : ''}</span></button>`).join('') + `<button type="button" data-nuevo="1" style="border-style:dashed"><span class="c">?</span><span>No está en la lista: registrar «${esc(q.value)}» como no encontrado</span></button>`;
    $$('[data-pick]', res).forEach(b => b.onclick = () => opCantidadFuera(OP.maestra.find(i => i.item === b.dataset.pick)));
    $('[data-nuevo]', res).onclick = () => opCantidadFuera({ item: q.value.trim(), desc: '', nuevo: true }); });
}
function opCantidadFuera(i) {
  const dueno = !i.nuevo && OP.idx.get(i.item);
  if (dueno) { OP.pantalla = ''; OP.sub = dueno.blk; OP.filtro = 'todo'; OP.q = i.item; opRenderHoja(); return; }
  opEl.body.innerHTML = `<div class="panel"><div class="hd"><h2>${i.nuevo ? 'Ítem no encontrado' : 'Ítem de otro bloque'}</h2></div><p><b>${esc(i.item)}</b> ${esc(i.desc || '')}${i.sub ? ` <span class="pill p-mute">${esc(i.sub)}</span>` : ''}</p>
    ${i.nuevo ? '<label class="fld">Descripción (lo que dice el empaque)<input type="text" id="cfDesc" placeholder="Descripción"></label>' : ''}<label class="fld" style="margin-top:8px">Cantidad<input type="text" id="cfQ" inputmode="decimal" style="font-size:20px"></label><label class="fld" style="margin-top:8px">Observación<input type="text" id="cfObs" placeholder="dónde estaba, etc."></label>
    <div class="row" style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button class="btn" type="button" id="cfCancel">Cancelar</button><button class="btn pri" type="button" id="cfOk">Guardar</button></div></div>`;
  $('#cfQ').focus(); $('#cfCancel').onclick = () => { OP.pantalla = ''; opRender(); };
  $('#cfOk').onclick = () => { const v = Number($('#cfQ').value.replace(',', '.')); if (!isFinite(v) || v < 0 || $('#cfQ').value.trim() === '') return toast('Cantidad no válida.'); const code = String(i.item).trim().replace(/^0+(?=\d)/, ''); if (!code) return toast('Falta el código.');
    opGuardar(code, v, $('#cfObs').value.trim(), { fuera: true, nuevo: !!i.nuevo, desc: i.nuevo ? ($('#cfDesc').value.trim() || '(sin descripción)') : i.desc }); OP.sub = null; OP.pantalla = ''; opRender(); toast('Registrado.'); };
}
opEl.back.onclick = () => { OP.sub = null; opRender(); };
opEl.salir.onclick = () => { if (OP.cola.length && !confirm(`Hay ${OP.cola.length} registro(s) sin enviar. Si sale ahora quedan guardados en este teléfono y se envían cuando vuelva a entrar con su nombre. ¿Salir?`)) return; OPST.del('op'); clearTimeout(OP.timer); OP.op = null; opLogin(); };

/* ---- src/js/05_salidas.js ---- */
/* =====================================================================
   05 · Plano SIESA, PDF, Datos, Parámetros, firmas y arranque (portada / modos)
   ===================================================================== */
/* ---------- PLANO SIESA · CONTEO FÍSICO (formato principal) ----------
   Plantilla del conector de SIESA: hojas «Inicial», «Físico» y «Final».
   Físico: una fila por ítem de la toma (toda la maestra activa + inactivos con existencia),
   con la cantidad contada definitiva (el último conteo de cada ítem, también los que cuadran y los ceros).
   SIESA calcula la diferencia contra su existencia. */
const H_FISICO = ['Compañía', 'Coonsecutivo', 'Id_Bodega', 'Cantidad_Conteo', 'Item'];
const bodDe = l => ((DB.items[l.k] || {}).bods || [])[0] || P.bodega;
function planoFilas() { return R ? R.lines.slice().sort((a, b) => cmpS(llaveSub(ORD_SUB, a.sub), llaveSub(ORD_SUB, b.sub)) || cmpS(String(a.cod), String(b.cod))) : []; }
function planoChequeos() {
  const filas = planoFilas(), cons = $('#pl_cons').value.trim(), cia = $('#pl_cia').value.trim();
  const sinContar = filas.filter(l => l.fin == null).length, bods = [...new Set(filas.map(bodDe))];
  const c = [
    { ok: !!DB.inv && DB.inv.estado === 'cerrado', t: 'Inventario finalizado', x: DB.inv && DB.inv.estado === 'cerrado' ? 'cerrado en Rondas y asignación' : 'finalícelo en Rondas y asignación (cerrar la última ronda → Finalizar inventario)', bloquea: true },
    { ok: !sinContar, t: 'Todos los ítems tienen conteo', x: sinContar ? `${fmtN(sinContar)} ítems sin contar` : `${fmtN(filas.length)} ítems con cantidad definitiva`, bloquea: true },
    { ok: /^\d+$/.test(cons), t: 'Consecutivo del conteo físico', x: cons ? (/^\d+$/.test(cons) ? cons : 'solo números') : 'escriba el número que le dio SIESA al generar el conteo físico', bloquea: true },
    { ok: /^\d+$/.test(cia), t: 'Compañía', x: cia || 'falta', bloquea: true },
    { ok: bods.length === 1, t: 'Bodega', x: bods.join(', ') + (bods.length > 1 ? ' · la consulta trae varias bodegas' : ''), bloquea: false },
    { ok: true, t: 'Inactivos', x: `${fmtN(filas.filter(l => l.inact).length)} con existencia van en el plano · ${fmtN(DB.excl.length)} sin existencia no van (SIESA les asigna cero)`, bloquea: false }
  ];
  if (R && R.nuevos.length) c.push({ ok: false, t: 'Códigos que no están en la consulta', x: `${fmtN(R.nuevos.length)} registrados como «no encontrado» no van en el plano: créelos o revíselos en SIESA`, bloquea: false });
  return { c, filas, listo: c.every(x => x.ok || !x.bloquea), cons, cia };
}
RENDER.planos = function () {
  if ($('#pl_cia').value === '') $('#pl_cia').value = P.cia || 1;
  if (!R) { $('#kpisPla').innerHTML = ''; $('#plaChecks').innerHTML = ''; $('#tblPla').innerHTML = empty('Sin inventario', 'Cargue las existencias y haga el conteo.'); $('#btnPlano').disabled = true; RENDER.ajuste(); return; }
  const { c, filas, listo } = planoChequeos();
  $('#plaChecks').innerHTML = c.map(x => `<div class="chk-row ${x.ok ? 'ok' : x.bloquea ? 'bad' : 'warn'}"><span class="ic">${x.ok ? '✓' : x.bloquea ? '✕' : '!'}</span><div><b>${esc(x.t)}</b><small>${esc(x.x)}</small></div></div>`).join('');
  $('#btnPlano').disabled = !listo;
  const porR = [1, 2, 3].map(r => filas.filter(l => l.finR === r).length), unid = filas.reduce((a, l) => a + (l.fin || 0), 0);
  const a = agg(filas);
  $('#kpisPla').innerHTML = [{ l: 'Ítems en el plano', v: fmtN(filas.length), s: 'toda la maestra de la toma', c: 'brand' }, { l: 'Unidades contadas', v: fmtN(unid, unid % 1 ? 2 : 0), s: `${fmtN(filas.filter(l => l.fin === 0).length)} ítems en cero`, c: 'brand' },
    { l: 'Manda el conteo', v: `${fmtN(porR[0])} · ${fmtN(porR[1])} · ${fmtN(porR[2])}`, s: 'ítems con cantidad de R1 · R2 · R3', c: 'or', ic: 'layers' }, { l: 'Faltantes', v: fmtN(a.falt), s: fmt$(a.vFalt) + ' a costo (ins)', c: 'bad', ic: 'minus' }, { l: 'Sobrantes', v: fmtN(a.sobr), s: fmt$(a.vSobr) + ' a costo (ins)', c: 'ok', ic: 'plus' }, { l: 'Ajuste neto esperado', v: fmtM(a.vNeto), s: 'lo que SIESA debería calcular', c: 'acc', ic: 'scale' }].map(kpi).join('');
  const q = norm($('#pl_q').value), rows = filas.filter(l => !q || norm(l.cod + ' ' + l.desc).includes(q));
  ARK.table($('#tblPla'), [{ l: 'Compañía', f: () => esc($('#pl_cia').value) }, { l: 'Coonsecutivo', f: () => esc($('#pl_cons').value) || '<span class="muted">—</span>' }, { l: 'Id_Bodega', f: l => esc(bodDe(l)) }, { l: 'Cantidad_Conteo', n: 1, f: l => l.fin == null ? '<span class="neg">sin contar</span>' : `<b>${fmtQ(l.fin)}</b>` }, { l: 'Item', f: l => `<span class="num">${esc(l.cod)}</span>` },
    { l: 'Descripción', f: l => esc(l.desc) + (l.inact ? ' <span class="pill p-warn">INACTIVO</span>' : ''), cls: 'desc' }, { l: 'Existencia', n: 1, f: l => fmtQ(l.teo) }, { l: 'Manda', f: l => l.finR ? `<span class="pill p-mute">R${l.finR}</span>` : '' }, { l: 'Diferencia', n: 1, f: l => `<span class="${sgn(l.difAj)}">${fmtQ(l.difAj)}</span>` }], rows,
    { size: 100, empty: 'Sin ítems.' });
  RENDER.ajuste();
};
['#pl_cons', '#pl_cia'].forEach(id => $(id).addEventListener('input', () => { if (id === '#pl_cia') { P.cia = +$('#pl_cia').value || 1; saveP(); } RENDER.planos(); }));
$('#pl_q').addEventListener('input', () => { ARK.resetPage('tblPla'); RENDER.planos(); });
function textoCelda(ws, r, c) { const a = XLSX.utils.encode_cell({ r, c }); if (ws[a]) { ws[a].t = 's'; ws[a].v = String(ws[a].v); ws[a].z = '@'; } }
$('#btnPlano').onclick = () => {
  const { filas, listo, cons, cia } = planoChequeos(); if (!listo) return toast('Revise los puntos en rojo antes de generar el plano.');
  if (typeof XLSX === 'undefined') return toast('No cargó la librería de Excel.');
  const nCia = +cia, nCons = +cons;
  const fis = [H_FISICO].concat(filas.map(l => [nCia, nCons, String(bodDe(l)), l.fin, String(l.cod)]));
  const wsF = XLSX.utils.aoa_to_sheet(fis);
  for (let r = 1; r < fis.length; r++) { textoCelda(wsF, r, 2); textoCelda(wsF, r, 4); }   // bodega e ítem como texto (conservan los ceros)
  wsF['!cols'] = [{ wch: 10 }, { wch: 13 }, { wch: 10 }, { wch: 16 }, { wch: 12 }];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([['Compañía'], [nCia]]), 'Inicial');
  XLSX.utils.book_append_sheet(wb, wsF, 'Físico');
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([['Compañía'], [nCia]]), 'Final');
  ARK.saveWb(wb, `Agro_CONTEO_FISICO_${nCons}_${ARK.isoDate(new Date())}.xlsx`);
};
$('#btnPlanoSop').onclick = () => {
  const filas = planoFilas(); if (!filas.length) return;
  ARK.exportXlsx(filas.map(l => ({ Item: l.cod, Referencia: l.ref, Descripción: l.desc, Subgrupo: l.sub, 'U.M.': l.um, Bodega: bodDe(l), Existencia: l.teo, 'Conteo 1': l.c1, 'Conteo 2': l.c2, 'Conteo 3': l.c3, 'Cantidad plano': l.fin, 'Conteo que manda': l.finR ? 'R' + l.finR : '', Diferencia: l.difAj, 'Costo (ins)': l.cp, 'Valor diferencia': Math.round(l.vDif), Inactivo: l.inact ? 'SÍ' : '', Operador: opNom(l.op) })), 'SOPORTE PLANO', `SOPORTE_PLANO_CONTEO_FISICO_AGRO_${ARK.isoDate(new Date())}.xlsx`);
};

/* ---------- Otro formato: ajuste por diferencias (salidas / entradas), se conserva de la v2 ---------- */
const EXCL = new Set();
function planLines() {
  if (!R) return [];
  return R.lines.filter(l => l.nov === 'FALTANTE' || l.nov === 'SOBRANTE').map(l => Object.assign({}, l, { tipo: l.difAj < 0 ? 'SALIDA' : 'ENTRADA', qty: r3(Math.abs(l.difAj)), co: P.co, bod: P.bodega }));
}
let PLAN_ROWS = [];
RENDER.ajuste = function () {
  if (!R) { $('#tblAj').innerHTML = ''; $('#btnSal').disabled = $('#btnEnt').disabled = true; return; }
  const all = planLines();
  ARK.selOpts($('#p_sub'), [...new Set(all.map(l => l.sub))].sort(), 'Todos los subgrupos');
  const t = $('#p_tipo').value, s = $('#p_sub').value;
  const rows = all.filter(l => (!t || l.tipo[0] === t) && (!s || l.sub === s)).sort((a, b) => a.tipo.localeCompare(b.tipo) || a.sub.localeCompare(b.sub) || String(a.cod).localeCompare(String(b.cod)));
  const inc = rows.filter(l => !EXCL.has(l.k)), sal = inc.filter(l => l.tipo === 'SALIDA'), ent = inc.filter(l => l.tipo === 'ENTRADA');
  PLAN_ROWS = rows;
  ARK.table($('#tblAj'), [{ l: '', f: r => `<input type="checkbox" data-pk="${esc(r.k)}" ${EXCL.has(r.k) ? '' : 'checked'} aria-label="Incluir">` }, { l: 'Tipo', f: r => `<span class="pill ${r.tipo === 'SALIDA' ? 'p-bad' : 'p-ok'}">${r.tipo}</span>` }, { l: 'Ítem', f: r => esc(r.cod) }, { k: 'desc', l: 'Descripción', cls: 'desc' }, { k: 'um', l: 'U.M.' },
    { l: 'Existencia', n: 1, f: r => fmtQ(r.teo) }, { l: 'Físico', n: 1, f: r => fmtQ(r.fin) }, { l: 'Cantidad a ajustar', n: 1, f: r => `<b>${fmtQ(r.qty)}</b>` }, { l: 'Valor', n: 1, f: r => `<span class="${sgn(r.vDif)}">${fmt$(r.vDif)}</span>` }], rows,
    { size: 100, maxh: '420px', empty: 'No hay diferencias por ajustar.', after: h => h.querySelectorAll('[data-pk]').forEach(c => c.onchange = () => { c.checked ? EXCL.delete(c.dataset.pk) : EXCL.add(c.dataset.pk); RENDER.ajuste(); }) });
  $('#btnSal').disabled = !sal.length; $('#btnEnt').disabled = !ent.length;
};
['#p_tipo', '#p_sub'].forEach(s => $(s).addEventListener('change', () => { ARK.resetPage('tblAj'); RENDER.ajuste(); }));
$('#p_all').onclick = () => { PLAN_ROWS.forEach(r => EXCL.delete(r.k)); RENDER.ajuste(); };
$('#p_none').onclick = () => { PLAN_ROWS.forEach(r => EXCL.add(r.k)); RENDER.ajuste(); };
function fechaDoc() { const d = ARK.toD(P.fecha) || ARK.toD(DB.inv && DB.inv.fecha) || new Date(); const p2 = ARK.pad2;
  return P.ffmt === 'DD/MM/AAAA' ? `${p2(d.getDate())}/${p2(d.getMonth() + 1)}/${d.getFullYear()}` : P.ffmt === 'AAAA-MM-DD' ? ARK.isoDate(d) : `${d.getFullYear()}${p2(d.getMonth() + 1)}${p2(d.getDate())}`; }
function notasDoc(lines) { const subs = [...new Set(lines.map(l => l.sub))]; return `${P.notas} ${fechaDoc()} ${subs.length <= 3 ? subs.join(', ') : subs.length + ' SUBGRUPOS'}`.slice(0, 250); }
$('#btnSal').onclick = () => {
  const lines = PLAN_ROWS.filter(l => l.tipo === 'SALIDA' && !EXCL.has(l.k)); const n = +P.num || 1;
  const docs = [['CO', 'TIPO DE DOCUMENTO', 'NUMERO DE DOCUMENTO', 'FECHA DE DOCUMENTO', 'ESTADO DEL DOCUMENTO  (0=En elaboración, 1=Aprobado/Contabilizado)', 'NOTAS DOCUMENTO'], [P.co, P.tipoSal, n, fechaDoc(), +P.estado, notasDoc(lines)]];
  const movs = [['CODIGO CO', 'CODIGO DOCUMENTO', 'NUMERO DE DOCUMENTO', 'NUMERO DE REGISTRO', 'CODIGO BODEGA SALIDA', 'Motivo', 'CENTRO DE OPERACION MOVIMIENTO', 'UNIDAD MEDIDA', 'CANTIDAD', 'ITEM', 'UNIDAD NEGOCIO. MOV']];
  lines.forEach((l, i) => movs.push([P.co, P.tipoSal, n, i + 1, P.bodega, P.motSal, P.co, l.um, l.qty, String(l.cod), P.un]));
  planoWb(docs, movs, `AJUSTE_INVENTARIO_-_SALIDAS_${fechaDoc().replace(/\//g, '')}.xlsx`, [0, 6, 9]);
};
$('#btnEnt').onclick = () => {
  const lines = PLAN_ROWS.filter(l => l.tipo === 'ENTRADA' && !EXCL.has(l.k));
  const docs = [['CO', 'tipo docto', 'Fecha del documento', 'Estado del documento (0=En elaboración, 1=Aprobado/Contabilizado)', 'OBSERVACIONES'], [P.co, P.tipoEnt, fechaDoc(), +P.estado, notasDoc(lines)]];
  const movs = [['CO', 'TIPO DOCTO MOV', 'REGISTRO', 'BODEGA', 'Motivo', 'Centro de operación movimiento', 'U.M.', 'CANTIDAD', 'COSTO UNITARIO', 'REFERENCIA', 'UNIDAD NEGOCIO. MOV']];
  lines.forEach((l, i) => movs.push([P.co, P.tipoEnt, i + 1, P.bodega, P.motEnt, P.co, l.um, l.qty, Math.round(l.cp * 100) / 100, String(l.ref), P.un]));
  planoWb(docs, movs, `AJUSTE_INVENTARIO_-_ENTRADAS_${fechaDoc().replace(/\//g, '')}.xlsx`, [0, 5]);
};
function planoWb(docs, movs, name, textCols) {
  if (typeof XLSX === 'undefined') return toast('No cargó la librería de Excel.');
  const wb = XLSX.utils.book_new();
  const mk = (aoa, txt) => { const ws = XLSX.utils.aoa_to_sheet(aoa);
    for (let r = 1; r < aoa.length; r++) for (const c of txt) textoCelda(ws, r, c);
    ws['!cols'] = aoa[0].map(h => ({ wch: Math.min(40, Math.max(10, String(h).length + 2)) })); return ws; };
  XLSX.utils.book_append_sheet(wb, mk(docs, [0]), 'Documentos'); XLSX.utils.book_append_sheet(wb, mk(movs, textCols), 'Movimientos');
  ARK.saveWb(wb, name);
}

/* ---------- PDF del consolidado ---------- */
const VERDE = [30, 107, 60]; ARK.rgbUnidad = () => VERDE;
function pdfConteo(rows) {
  try {
    const doc = ARK.pdf.nuevo('letter'); const a = agg(rows);
    ARK.pdf.membrete(doc, { rgb: VERDE, titulo: 'Conteo físico de inventario · consolidado', sub: `${DB.inv ? DB.inv.nombre : ''} · ${ARK.fmtDate(DB.inv ? DB.inv.fecha : new Date())} · bodega ${P.bodega}`, empresa: P.empresa + ' · Área de Control Arketops', ark: ARK_LOGO });
    doc.setTextColor(40); doc.setFontSize(9.5); doc.setFont('helvetica', 'normal');
    doc.text(`Ítems ${fmtN(a.n)} · contados ${fmtN(a.cont)} · sin contar ${fmtN(a.pend)} · exactitud ${pct(a.exact, 1)} · faltantes ${fmtN(a.falt)} (${fmt$(a.vFalt)}) · sobrantes ${fmtN(a.sobr)} (${fmt$(a.vSobr)}) · neto ${fmt$(a.vNeto)}`, 10, 32);
    doc.autoTable({ startY: 36, head: [['Ítem', 'Descripción', 'Subgrupo', 'U.M.', 'Existencia', 'C1', 'C2', 'C3', 'Final', 'Dif.', 'Costo (ins)', 'Valor dif.', 'Novedad', 'Operador']],
      body: rows.map(r => [r.item, r.desc + (r.inact ? ' (INACTIVO)' : ''), r.sub, r.um, fmtQ(r.teo), fmtQ(r.c1), fmtQ(r.c2), fmtQ(r.c3), fmtQ(r.fin), fmtQ(r.difAj), fmt$(r.cp), fmt$(r.vDif), r.nov, opNom(r.op)]),
      styles: { fontSize: 7, cellPadding: 1.4 }, headStyles: { fillColor: VERDE, fontSize: 7 }, columnStyles: { 1: { cellWidth: 60 }, 4: { halign: 'right' }, 5: { halign: 'right' }, 6: { halign: 'right' }, 7: { halign: 'right' }, 8: { halign: 'right' }, 9: { halign: 'right' }, 10: { halign: 'right' }, 11: { halign: 'right' } },
      didParseCell: d => { if (d.section === 'body' && d.column.index === 12) { const v = d.cell.raw; d.cell.styles.textColor = v === 'FALTANTE' ? [200, 16, 46] : v === 'SOBRANTE' ? [23, 130, 74] : v === 'PENDIENTE' ? [163, 95, 0] : [90, 90, 90]; d.cell.styles.fontStyle = 'bold'; } } });
    { let y = doc.lastAutoTable.finalY + 16; const W = doc.internal.pageSize.getWidth(); if (y > doc.internal.pageSize.getHeight() - 30) { doc.addPage(); y = 30; } firmasLista().forEach((f, i) => { const x = 20 + i * (W - 40) / 3; doc.setDrawColor(120); doc.line(x, y, x + 70, y); doc.setFontSize(8); doc.setTextColor(40); doc.text(f.n || '______________________', x, y + 5); doc.setTextColor(120); doc.text(f.c, x, y + 9.5); }); }
    ARK.pdf.pie(doc, { rgb: VERDE, responsable: P.firma1n || 'Área de Control' });
    doc.save(`CONTEO_CONSOLIDADO_AGRO_${ARK.isoDate(new Date())}.pdf`); toast('PDF generado.');
  } catch (e) { toast(e.message || String(e)); console.error(e); }
}
const firmasLista = () => [{ n: P.firma1n, c: P.firma1c }, { n: P.firma2n, c: P.firma2c }, { n: P.firma3n, c: P.firma3c }];
function renderFirmas() { $('#sigs').innerHTML = firmasLista().map(f => `<div class="sig"><div class="ph" style="display:grid;place-items:center;color:var(--brand);font-weight:800;font-size:20px">${esc((f.n || '?').split(' ').map(x => x[0]).slice(0, 2).join(''))}</div><div class="tx"><small>FIRMA</small><b>${esc(f.n || 'Por definir')}</b><span>${esc(f.c)}</span></div></div>`).join(''); }

/* ---------- DATOS ---------- */
RENDER.datos = function () {
  $$('#d_tab button').forEach(b => b.classList.toggle('on', b.dataset.v === D_TAB));
  const q = norm($('#d_q').value); let rows = [], cols = [];
  if (D_TAB === 'items') { rows = Object.values(DB.items).filter(i => !q || norm((i.cod || '') + ' ' + i.item + ' ' + i.ref + ' ' + i.desc).includes(q)); cols = [{ l: 'Ítem', f: i => esc(i.item) }, { l: 'Descripción', f: i => esc(i.desc) + (i.inact ? ' <span class="pill p-warn">INACTIVO</span>' : '') + `<small class="sub2">${esc(subCorta(i.sub))}${i.grupo ? ' · ' + esc(subCorta(i.grupo)) : ''}${i.linea ? ' · ' + esc(subCorta(i.linea)) : ''}${i.ref && i.ref !== i.item ? ' · Ref. ' + esc(i.ref) : ''}</small>`, cls: 'desc' }, { k: 'um', l: 'U.M.' }, { l: 'Existencia', n: 1, f: i => fmtQ(i.teo) }, { l: 'Costo (ins)', n: 1, f: i => fmt$(i.cp) }, { l: 'Valor', n: 1, f: i => fmt$(i.teo * i.cp) }, { l: 'Bodega', f: i => esc(i.bods.join(', ')) }, { l: 'Código plano', f: i => `<span class="muted num">${esc(i.cod || '')}</span>` }]; }
  if (D_TAB === 'log') { rows = DB.log.slice().reverse().filter(x => !q || norm(x.item + ' ' + ((DB.items[x.item] || {}).desc || '') + ' ' + opNom(x.op)).includes(q)); cols = [{ l: 'Fecha y hora', f: x => fmtH(x.ts) + ':' + ARK.pad2(new Date(x.ts).getSeconds()) }, { l: 'Ronda', f: x => x.r }, { l: 'Operador', f: x => esc(opNom(x.op)) }, { l: 'Ítem', f: x => esc(x.item) }, { l: 'Descripción', f: x => esc((DB.items[x.item] || {}).desc || ''), cls: 'desc' }, { l: 'Cantidad', n: 1, f: x => x.q == null ? 'borrado' : fmtQ(x.q) }, { l: 'Antes', n: 1, f: x => x.prev == null ? '' : fmtQ(x.prev) }]; }
  if (D_TAB === 'excl') { rows = DB.excl.filter(x => !q || norm(x.item + ' ' + x.desc).includes(q)); cols = [{ l: 'Ítem', f: x => esc(x.item) }, { l: 'Descripción', f: x => esc(x.desc) + `<small class="sub2">${esc(subCorta(x.sub))}</small>`, cls: 'desc' }, { k: 'bod', l: 'Bodega' }, { l: 'Existencia', n: 1, f: x => fmtQ(x.teo) }, { k: 'motivo', l: 'Por qué quedó fuera' }]; }
  $('#d_info').textContent = `${fmtN(rows.length)} filas`;
  ARK.table($('#tblDatos'), cols, rows, { size: 100, empty: 'Sin datos.' });
  RENDER.datos.rows = rows; RENDER.datos.cols = cols;
};
$$('#d_tab button').forEach(b => b.onclick = () => { D_TAB = b.dataset.v; ARK.resetPage('tblDatos'); RENDER.datos(); });
$('#d_q').addEventListener('input', () => { ARK.resetPage('tblDatos'); RENDER.datos(); });
$('#d_xls').onclick = () => { const tmp = document.createElement('div'); ARK.exportXlsx((RENDER.datos.rows || []).map(r => { const o = {}; RENDER.datos.cols.forEach(c => { tmp.innerHTML = c.f ? c.f(r) : esc(r[c.k]); o[c.l || c.k] = tmp.textContent; }); return o; }), D_TAB.toUpperCase(), `DATOS_${D_TAB.toUpperCase()}_AGRO_${ARK.isoDate(new Date())}.xlsx`); };

/* ---------- PARÁMETROS ---------- */
function campo([k, l, t, op, full]) {
  const v = P[k] ?? '';
  if (t === 'chk') return `<label class="chk ${full ? 'full' : ''}"><input type="checkbox" data-p="${k}" ${v ? 'checked' : ''}> ${esc(l)}</label>`;
  if (t === 'sel') return `<label class="fld ${full ? 'full' : ''}">${esc(l)}<select data-p="${k}">${op.map(o => `<option value="${esc(o[0])}" ${String(v) === String(o[0]) ? 'selected' : ''}>${esc(o[1])}</option>`).join('')}</select></label>`;
  return `<label class="fld ${full ? 'full' : ''}">${esc(l)}<input type="${t === 'num' ? 'number' : t === 'date' ? 'date' : 'text'}" data-p="${k}" value="${esc(v)}" ${t === 'num' ? 'step="any"' : ''}></label>`;
}
RENDER.params = function () {
  $('#prForm').innerHTML = [['tolUnd', 'Tolerancia en unidades (UND)', 'num'], ['tolDec', 'Tolerancia en KL / MT / g', 'num'], ['difGrande', 'Diferencia grande en pesos (hallazgo crítico)', 'num'], ['maxEdits', 'Cambios de cantidad que generan hallazgo', 'num'], ['inactMin', 'Minutos sin registrar para marcar operador quieto', 'num'],
    ['r3Crit', 'Qué pasa a la ronda 3', 'sel', [['teo', 'Ítems cuyo conteo 2 sigue distinto a la existencia'], ['c1', 'Ítems cuyo conteo 2 es distinto al conteo 1']]],
    ['excluir', 'Inactivos: marcas en la descripción, separadas con coma (con * = comienzo de palabra). Sin existencia quedan fuera; con existencia se cuentan', 'text', null, true]].map(campo).join('') +
    '<p class="note full" style="margin:0">Reglas fijas: nada queda sin contar (un 0 es un conteo y la ronda no cierra con pendientes) y la cantidad definitiva de cada ítem es su último conteo.</p>';
  $('#prPlano').innerHTML = '<p class="note full" style="margin:0 0 4px"><b>Conteo físico (principal):</b></p>' + [['cia', 'Compañía en SIESA', 'num'], ['itemLen', 'Dígitos del ítem en SIESA (se completan con ceros; 0 = sin completar)', 'num'], ['bodega', 'Bodega si la consulta no la trae', 'text']].map(campo).join('') + '<p class="note full" style="margin:8px 0 4px"><b>Ajuste por diferencias (otro formato):</b></p>' + [['co', 'Centro de operación (CO)', 'text'], ['bodega', 'Código de bodega', 'text'], ['tipoSal', 'Tipo doc. salidas', 'text'], ['tipoEnt', 'Tipo doc. entradas', 'text'], ['motSal', 'Motivo salidas', 'text'], ['motEnt', 'Motivo entradas', 'text'], ['un', 'Unidad de negocio', 'text'], ['estado', 'Estado del documento', 'sel', [['0', '0 = En elaboración'], ['1', '1 = Aprobado']]], ['num', 'Número de documento (salidas)', 'num'], ['fecha', 'Fecha del documento (vacío = fecha del inventario)', 'date'], ['ffmt', 'Formato de fecha', 'sel', [['AAAAMMDD', 'AAAAMMDD'], ['DD/MM/AAAA', 'DD/MM/AAAA'], ['AAAA-MM-DD', 'AAAA-MM-DD']]], ['notas', 'Notas del documento', 'text', null, true]].map(campo).join('');
  $('#prAcc').innerHTML = '<p class="note full" style="margin:0">Servidor compartido fijo en el archivo (Google Apps Script). La clave del centro de control se define en el script del servidor, no aquí.</p>' + ([['empresa', 'Empresa', 'text'], ['firma1n', 'Firma 1 · nombre', 'text'], ['firma1c', 'Firma 1 · cargo', 'text'], ['firma2n', 'Firma 2 · nombre', 'text'], ['firma2c', 'Firma 2 · cargo', 'text'], ['firma3n', 'Firma 3 · nombre', 'text'], ['firma3c', 'Firma 3 · cargo', 'text']]).map(campo).join('');
  $$('#v-params [data-p]').forEach(el => el.addEventListener('change', () => { const k = el.dataset.p; P[k] = el.type === 'checkbox' ? el.checked : el.type === 'number' ? (el.value === '' ? 0 : +el.value) : el.value; saveP(); if (k === 'servidor') { toast('Recargue la página para conectar con el servidor.'); } calcular(); renderTop(); renderFirmas(); }));
};

/* ---------- Arranque: portada, hoja de conteo o centro de control ---------- */
const PANT = { portada: $('#portada'), gate: $('#gate'), op: $('#opApp'), ctl: $('#ctlApp') };
function pantalla(k) { Object.entries(PANT).forEach(([n, el]) => el.hidden = n !== k); window.scrollTo(0, 0); }
function wirePortada() { $$('[data-go-portada]').forEach(b => b.onclick = () => { location.hash = ''; pantalla('portada'); }); }
$('#goConteo').onclick = () => { location.hash = '#conteo'; pantalla('op'); opIniciar(); };
$('#goControl').onclick = () => { if (sessionStorage.getItem('agro_ctl_ok') === '1') return entrarControl(); location.hash = '#control'; pantalla('gate'); $('#gateKey').value = ''; $('#gateMsg').hidden = true; setTimeout(() => $('#gateKey').focus(), 50); };
$('#gateOk').onclick = async () => {
  const k = $('#gateKey').value.trim(), msg = $('#gateMsg'); msg.hidden = true; if (!k) return;
  busy(true, 'Verificando clave…');
  const antes = P.clave; P.clave = k;
  busy(false); const bien = await entrarControl(true);   // una sola llamada: la foto de la base ya valida la clave
  if (bien) { ST.set('p', P); sessionStorage.setItem('agro_ctl_ok', '1'); } else P.clave = antes;
};
$('#gateKey').addEventListener('keydown', e => { if (e.key === 'Enter') $('#gateOk').click(); });

/* ---------- Centro de control en vivo: una foto al entrar y luego solo lo nuevo cada pocos segundos ---------- */
let CTL_TIMER = null, CTL_BUSY = false, CTL_FALLOS = 0;
async function entrarControl(desdeClave) {
  busy(true, desdeClave ? 'Verificando clave…' : 'Conectando con el servidor…');
  let d;
  try { d = await SYNC.pull(); busy(false); }
  catch (e) { busy(false); if (/clave/i.test(e.message || '')) sessionStorage.removeItem('agro_ctl_ok'); location.hash = '#control'; pantalla('gate'); const m = $('#gateMsg'); m.textContent = /clave/i.test(e.message || '') || e.servidor ? e.message : 'Sin conexión con el servidor: ' + (e.message || e); m.hidden = false; return false; }
  location.hash = '#control'; pantalla('ctl');
  cargarFoto(d); calcular(); renderFirmas(); VIVO.ok = true; VIVO.ts = Date.now();
  mostrar(ST.get('vista', 'inicio')); renderTodo();
  clearTimeout(CTL_TIMER); CTL_TIMER = setTimeout(ctlCiclo, 5000);
  setTimeout(() => LIBS.cargar().then(() => { if (!PANT.ctl.hidden) renderTodo(); }), 50);   // las librerías llegan después de pintar y la vista se repinta con las gráficas
  return true;
}
async function ctlCiclo() {
  await ctlRefrescar();
  const espera = CTL_FALLOS ? Math.min(30000, 5000 * 2 ** Math.min(3, CTL_FALLOS)) : 5000;
  CTL_TIMER = setTimeout(ctlCiclo, espera);
}
async function ctlRefrescar() {
  if (PANT.ctl.hidden || CTL_BUSY || document.hidden) return; CTL_BUSY = true;
  try {
    if (PEND_GUARDAR && !PUSHING) { PEND_GUARDAR = false; try { await guardarServidor({ inv: DB.inv, asig: DB.asig, ops: DB.ops, rep: DB.rep }); toast('Cambios pendientes guardados en el servidor.'); } catch (e) { PEND_GUARDAR = true; throw e; } }
    const gen = PUSH_GEN;
    const d = await SYNC.pullDelta(DB.ver, DB.iver, DB.fila);
    if (d.reinicio) { cargarFoto(await SYNC.pull()); calcular(); renderVivo(); return; }
    const limpio = gen === PUSH_GEN && !PUSHING;      // si hubo un cambio propio mientras tanto, del estado manda lo local
    const cambio = aplicarDelta(d, limpio);
    CTL_FALLOS = 0; VIVO.ok = true; VIVO.ts = Date.now(); VIVO.msg = '';
    if (cambio) { calcular(); renderVivo(); } else marcarVivo();
  } catch (e) { CTL_FALLOS++; VIVO.ok = false; VIVO.msg = e.message || String(e); marcarVivo(); console.warn('Centro de control sin conexión', e); }
  finally { CTL_BUSY = false; }
}
function marcarVivo() { renderTop(); const t = $('#t_info'); if (t && VISTA === 'tablero' && R) t.textContent = `${NOMR[T_R] || ''} · actualizado ${fmtHs(VIVO.ts)}`; }
/** Repinta la vista abierta sin perder la posición de lectura, y sin interrumpir a quien está escribiendo o eligiendo. */
function renderVivo() {
  const ae = document.activeElement;
  if (ae && /INPUT|SELECT|TEXTAREA/.test(ae.tagName) && ae.closest('#v-params,#v-rondas,#v-planos,#modal')) { renderTop(); return; }
  if (!$('#modal').hidden) { renderTop(); return; }
  const vista = $('#v-' + VISTA), scr = vista ? [...vista.querySelectorAll('.tbl-wrap')].map(w => [w.closest('[id]') && w.closest('[id]').id, w.scrollTop, w.scrollLeft]) : [], y = window.scrollY;
  renderTodo();
  scr.forEach(([id, t, l]) => { const host = id && document.getElementById(id), w = host && host.querySelector('.tbl-wrap'); if (w) { w.scrollTop = t; w.scrollLeft = l; } });
  window.scrollTo(0, y);
}
document.addEventListener('visibilitychange', () => { if (!document.hidden && !PANT.ctl.hidden) ctlRefrescar(); });
$$('[data-ic]').forEach(el => { if (!el.innerHTML.trim()) el.innerHTML = ARK.svg(el.dataset.ic); });
$$('.nav-item[data-ic] .ic').forEach(el => { if (!el.innerHTML.trim()) el.innerHTML = ARK.svg(el.closest('.nav-item').dataset.ic); });
$$('h2[data-pi]').forEach(h => h.insertAdjacentHTML('afterbegin', `<span class="pi">${ARK.svg(h.dataset.pi)}</span>`));
$$('button[data-pi]').forEach(h => { if (!h.innerHTML.trim()) h.innerHTML = ARK.svg(h.dataset.pi); });
{ const p = $('#pSaludo'); if (p) p.textContent = saludoHora(); }
wirePortada();
{ const np = $('#navPortal'); if (np) np.onclick = () => { location.href = new URL('../', location.href).href; }; }
/* v6: la pantalla de carga se quita apenas el DOM está listo (sin esperar librerías ni fuentes); la segunda vez en la sesión ni aparece */
(function splashRapido() { const s = $('#splash'); if (!s) return; let visto = false; try { visto = sessionStorage.getItem('agro_visto') === '1'; sessionStorage.setItem('agro_visto', '1'); } catch (e) { } const fuera = () => { s.classList.add('out'); setTimeout(() => s.remove(), 500); }; if (visto) { s.remove(); } else setTimeout(fuera, 450); })();
(function arrancar() {
  const h = location.hash;
  if (h === '#conteo') { pantalla('op'); opIniciar(); }
  else if (h === '#control' && sessionStorage.getItem('agro_ctl_ok') === '1') entrarControl();
  else if (h === '#control') { pantalla('gate'); }
  else pantalla('portada');
})();
window.LIBS.listo.then(falt => { if (!Array.isArray(falt)) return; if (falt.includes('XLSX')) { const b = $('#libBanner'); b.hidden = false; b.innerHTML = 'No cargó la librería para leer Excel.<small>Este equipo no tiene internet o bloquea cdnjs.cloudflare.com y cdn.jsdelivr.net. Conéctese y recargue la página (F5).</small>'; } else if (falt.length) console.warn('Librerías no cargadas:', falt); });

/* ---- src/js/06_bodega.js ---- */
/* =====================================================================
   06 · Bodega en vivo (v5): escena 3D en CSS, sin librerías.
   Una estantería por bloque que se va llenando con el conteo, los operadores
   parados frente al bloque donde están contando, una pantalla de pared con el
   avance y burbujas cuando llega un registro. Se gira arrastrando y se acerca
   con la rueda o los botones.
   ===================================================================== */
const B3 = { rx: 55, rz: -36, zoom: 1, built: '', logN: 0, drag: null, auto: false, sel: '' };
const B3_W = 1700, B3_D = 1150;        // tamaño del piso en unidades
const B3_SVG = {
  persona: (c, cap) => `<svg viewBox="0 0 60 92" class="av-svg" aria-hidden="true"><ellipse cx="30" cy="88" rx="16" ry="4" fill="rgba(0,0,0,.18)"/><path d="M19 48h22l3 32H16z" fill="${c}"/><rect x="21" y="78" width="7" height="10" rx="2" fill="#2E3A33"/><rect x="32" y="78" width="7" height="10" rx="2" fill="#2E3A33"/><rect x="13" y="50" width="7" height="22" rx="3.5" fill="#F2C9A4"/><rect x="40" y="50" width="7" height="22" rx="3.5" fill="#F2C9A4"/><rect x="36" y="58" width="16" height="12" rx="2" fill="#1F2A24" transform="rotate(-12 44 64)"/><rect x="38" y="60" width="12" height="8" rx="1" fill="#7CE3A8" transform="rotate(-12 44 64)"/><circle cx="30" cy="30" r="15" fill="#F2C9A4"/><path d="M15 28c0-10 7-17 15-17s15 7 15 17H15z" fill="${cap}"/><path d="M14 27h32v4H14z" fill="${cap}"/><circle cx="25" cy="32" r="1.6" fill="#2E3A33"/><circle cx="35" cy="32" r="1.6" fill="#2E3A33"/><path d="M26 38c2 2 6 2 8 0" stroke="#2E3A33" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>`,
  planta: `<svg viewBox="0 0 60 80" class="av-svg" aria-hidden="true"><ellipse cx="30" cy="77" rx="14" ry="3" fill="rgba(0,0,0,.15)"/><path d="M18 56h24l-3 20H21z" fill="#D9A066"/><path d="M16 52h28v6H16z" fill="#C48B55"/><path d="M30 54c-14-4-20-16-16-30 10 4 16 14 16 30z" fill="#2FAE66"/><path d="M30 54c14-4 20-16 16-30-10 4-16 14-16 30z" fill="#3DBB73"/><path d="M30 56c-2-18 0-30 2-40 6 10 6 26-2 40z" fill="#1E9A55"/></svg>`,
  bulto: `<svg viewBox="0 0 60 70" class="av-svg" aria-hidden="true"><ellipse cx="30" cy="67" rx="18" ry="3" fill="rgba(0,0,0,.15)"/><path d="M12 64 L15 14 Q30 6 45 14 L48 64z" fill="#E9D7A5"/><path d="M15 14 Q30 6 45 14" fill="none" stroke="#B89A5A" stroke-width="3"/><rect x="20" y="30" width="20" height="18" rx="3" fill="#00A653"/><rect x="24" y="40" width="12" height="4" rx="2" fill="#FFCD00"/></svg>`
};
/* ícono y color de cada estantería según el nombre del subgrupo */
const B3_ICO = [
  [/CONCENTRAD|ALIMENTO|BULTO/, 'sack', '#E9D7A5'], [/MASCOTA/, 'paw', '#FFD9B8'], [/MEDICAMENT|VETERIN|FARMAC|VACUNA/, 'cross', '#FFC2CB'], [/SEMILLA/, 'sprout', '#CFF2DA'],
  [/FERRETER|HERRAMIENT/, 'wrench', '#D6DEE6'], [/FERTILIZ|ABONO|AGROQU|FUNGI|HERBI|INSECT|PLAGA/, 'leafsack', '#C9EBD1'], [/HENO|FORRAJE|PASTO/, 'hay', '#F2E3A8'], [/SNACK|GALLET|GOLOSIN/, 'cookie', '#F5D2B0'],
  [/PISCINA|HOGAR|ASEO|LIMPIEZA/, 'drop', '#C5E6F7'], [/BOVIN|EQUIN|GANAD|VACA|CABALLO|PORCIN|AVES?\b|AVICOL|POLLO/, 'cow', '#E7D4C2'], [/HELADO|CONGELAD|FRIO/, 'icecream', '#D9E8F7'], [/DESECHO|BASURA|RESIDUO/, 'trash', '#DDDDDD'],
  [/PELLET/, 'pellet', '#E5D6B8'], [/SUPLEMENT|VITAMIN|SAL\b|MINERAL/, 'pill', '#E3D5F5'], [/IMPLEMENT|ACCESORI|JUGUET|COLLAR|CORREA/, 'tool', '#D3E3E6'], [/EMPAQUE|BOLSA|MATERIAL/, 'box', '#E6DFD3'],
  [/VARIO|OTRO|SIN SUBGRUPO|GENERAL/, 'box', '#EAEAEA']
];
Object.assign(ARK.ICONS, {
  sack: '<path d="M7 21h10l-1-11H8z"/><path d="M8 10c1-3 7-3 8 0M9 5l1 5M15 5l-1 5"/><path d="M10 15h4"/>',
  paw: '<circle cx="8" cy="8" r="1.8"/><circle cx="12" cy="6" r="1.8"/><circle cx="16" cy="8" r="1.8"/><circle cx="18.5" cy="12" r="1.5"/><path d="M12 11c-3 0-5 3-5 5.5A2.5 2.5 0 0 0 9.5 19c1 0 1.5-.5 2.5-.5s1.5.5 2.5.5a2.5 2.5 0 0 0 2.5-2.5C17 14 15 11 12 11z"/>',
  cross: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 8v8M8 12h8"/>',
  sprout: '<path d="M12 21v-9"/><path d="M12 12c0-4-3-6-7-6 0 4 3 6 7 6z"/><path d="M12 12c0-4 3-6 7-6 0 4-3 6-7 6z"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.1-2.1z"/>',
  leafsack: '<path d="M7 21h10l-1-11H8z"/><path d="M8 10c1-3 7-3 8 0"/><path d="M12 18c0-3 1.5-4.5 4-4.5-.3 3-1.5 4.5-4 4.5z"/>',
  hay: '<rect x="3" y="8" width="18" height="10" rx="2"/><path d="M3 12h18M8 8v10M13 8v10M18 8v10"/>',
  cookie: '<circle cx="12" cy="12" r="8.5"/><circle cx="9" cy="10" r=".8"/><circle cx="14" cy="9" r=".8"/><circle cx="10" cy="15" r=".8"/><circle cx="15" cy="14" r=".8"/>',
  drop: '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>',
  cow: '<path d="M4 5c2 2 3 3 4 3h8c1 0 2-1 4-3"/><path d="M7 8v8a5 5 0 0 0 10 0V8"/><circle cx="10" cy="12" r=".8"/><circle cx="14" cy="12" r=".8"/><path d="M9 17h6"/>',
  icecream: '<path d="M8 10a4 4 0 0 1 8 0v1H8z"/><path d="M8.5 11 12 21l3.5-10"/>',
  trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14"/>',
  pellet: '<circle cx="8" cy="9" r="2"/><circle cx="14" cy="7" r="2"/><circle cx="16" cy="13" r="2"/><circle cx="10" cy="15" r="2"/><circle cx="6" cy="17" r="1.5"/>',
  pill: '<rect x="3" y="9" width="18" height="6" rx="3" transform="rotate(-30 12 12)"/><path d="M9.5 7.7l5 8.6"/>',
  tool: '<path d="M4 20 14 10"/><path d="M14 4l6 6-3 3-6-6z"/><path d="M5 19l-1 1"/>'
});
function b3Icono(nombre) { const n = String(nombre || '').toUpperCase(); for (const [re, ic, col] of B3_ICO) if (re.test(n)) return { ic, col }; return { ic: 'box', col: '#EDEDED' }; }
const B3_COL = ['#00A653', '#E3001B', '#FFCD00', '#1F7AE0', '#8E44AD', '#F28C28', '#13B5C8', '#6B4F2A', '#E94A8A', '#2E3A33'];
const b3Col = i => B3_COL[i % B3_COL.length];
function b3Pos(lista) {   // posición de cada estantería en el piso, en filas, respetando el orden de los bloques
  const cols = Math.max(3, Math.min(6, Math.ceil(Math.sqrt(lista.length * 1.4)))), out = {};
  const sx = (B3_W - 220) / cols, sy = (B3_D - 320) / Math.max(1, Math.ceil(lista.length / cols));
  lista.forEach((b, i) => { const c = i % cols, r = Math.floor(i / cols); out[b.blk] = { x: 170 + c * sx, y: 260 + r * Math.max(190, sy), w: Math.min(180, sx - 90), d: 74 }; });
  return out;
}
function b3Caja(id, p, h, cls, sub) {   // caja 3D: piso + 4 caras + tapa, con ícono y color del subgrupo
  const { ic, col } = b3Icono(sub);
  return `<div class="b3-caja ${cls}" data-blk="${esc(id)}" style="--w:${p.w}px;--d:${p.d}px;--h:${h}px;--tint:${col};transform:translate3d(${p.x}px,${p.y}px,0)">
    <i class="f tapa"><span class="tico">${ARK.svg(ic)}</span></i><i class="f fr"><div class="fl"><span class="bi">${ARK.svg(ic)}</span><div class="bt"></div></div></i><i class="f bk"></i><i class="f iz"></i><i class="f de"></i>
    <b class="lleno"><i class="f tapa"></i><i class="f fr"></i><i class="f bk"></i><i class="f iz"></i><i class="f de"></i></b></div>`;
}
function b3Construir(av) {
  const host = $('#b3Mundo'); const lista = av ? av.lista : []; const pos = b3Pos(lista); B3.pos = pos;
  const cajas = lista.map(b => { const p = pos[b.blk]; const h = 60 + Math.min(70, Math.round(Math.sqrt(b.total) * 2.4)); return b3Caja(b.blk, p, h, b.tipo === 'F' ? 'tF' : b.tipo === 'S' ? 'tS' : '', b.sub); }).join('');
  const deco = [[80, 1080, 'planta'], [1630, 90, 'planta'], [1620, 1070, 'planta'], [860, 1090, 'planta'], [90, 120, 'bulto'], [160, 120, 'bulto'], [125, 180, 'bulto'], [1560, 1000, 'bulto'], [1630, 1000, 'bulto']].map(([x, y, k]) => `<div class="b3-sprite deco b3-rot" style="transform:translate3d(${x}px,${y}px,0)"><div class="sp-in">${B3_SVG[k]}</div></div>`).join('');
  host.innerHTML = `<div class="b3-piso"><div class="b3-grid"></div><div class="b3-alfombra"></div></div>
    <div class="b3-pared bk"><div class="b3-logo"><img src="data:image/png;base64," alt=""><b>AGROCOCOROLLO</b><span>Bodega PV001</span></div><div class="b3-pantalla"><div class="pt-in" id="b3Pant"></div></div></div>
    ${cajas}${deco}<div id="b3Ops"></div><div id="b3Burb"></div>`;
  $$('.b3-caja', host).forEach(c => { c.onclick = e => { e.stopPropagation(); b3AbrirBloque(c.dataset.blk); }; });
  const pant = host.querySelector('.b3-pantalla'); pant.onclick = e => { e.stopPropagation(); b3AbrirPared(); }; pant.title = 'Clic para ver el tablero en pantalla completa';
}
function b3Aplicar() { const m = $('#b3Mundo'); if (!m) return; m.style.setProperty('--rx', B3.rx + 'deg'); m.style.setProperty('--rz', B3.rz + 'deg'); m.style.setProperty('--zoom', B3.zoom); }
RENDER.bodega = function () {
  const sec = $('#v-bodega'); if (!DB.inv || !R) { $('#b3Vacio').hidden = false; $('#b3Esc').hidden = true; $('#b3Top').hidden = true; return; }
  $('#b3Vacio').hidden = true; $('#b3Esc').hidden = false; $('#b3Top').hidden = false;
  const r = DB.inv.ronda, av = R.av[r], ahora = Date.now();
  const firma = r + '|' + av.lista.map(b => b.blk + ':' + b.total).join(',');
  if (firma !== B3.built) { b3Construir(av); B3.built = firma; B3.logN = DB.log.length; b3Aplicar(); }
  // estanterías: nivel de llenado y estado
  av.lista.forEach(b => { const el = $(`.b3-caja[data-blk="${CSS.escape(b.blk)}"]`); if (!el) return; const p = b.total ? b.cont / b.total : 0, done = b.total && b.cont >= b.total;
    el.style.setProperty('--p', p.toFixed(3)); el.classList.toggle('done', !!done); el.classList.toggle('dif', !done && b.nDif > 0); el.classList.toggle('activo', !!b.ult && ahora - b.ult < 3 * 60000);
    const tipo = b.tipo === 'F' ? '<i class="tp f">FALT.</i>' : b.tipo === 'S' ? '<i class="tp s">SOBR.</i>' : '';
    el.querySelector('.bt').innerHTML = `${tipo}<b>${esc(subCorta(b.sub))}</b><span>${fmtN(b.cont)} / ${fmtN(b.total)} · ${pct(p, 0)}</span><em style="width:${(p * 100).toFixed(1)}%"></em>`; });
  // operadores: parados frente al bloque de su último registro (o del primero asignado)
  const cont = DB.cont[r] || {}, ultPorOp = {};
  Object.entries(cont).forEach(([code, x]) => { const u = ultPorOp[x.op]; if (!u || x.ts > u.ts) ultPorOp[x.op] = { ts: x.ts, blk: blk(code, r), code }; });
  const ops = Object.values(av.porOp).filter(o => o.asig > 0 || o.cont > 0), enBlk = {};
  const html = ops.map((o, i) => {
    const u = ultPorOp[o.op]; const b = (u && u.blk) || o.blks[0]; const p = (B3.pos || {})[b]; if (!p) return '';
    const n = enBlk[b] = (enBlk[b] || 0) + 1; const x = p.x + p.w + 34 + (n - 1) * 62, y = p.y + p.d * .8;
    const act = o.ult && ahora - o.ult < 15 * 60000, c = b3Col(DB.ops.findIndex(z => z.id === o.op));
    return `<div class="b3-sprite op b3-rot ${act ? 'act' : 'idle'}" data-op="${esc(o.op)}" style="transform:translate3d(${x}px,${y}px,0)"><div class="sp-in"><div class="et"><i style="background:${c}"></i><b>${esc(o.nombre)}</b><span>${fmtN(o.cont)}/${fmtN(o.asig)}${o.ritmo ? ' · ' + fmtN(o.ritmo) + '/h' : ''}</span></div>${B3_SVG.persona(c, act ? '#2E3A33' : '#8C9A92')}</div></div>`;
  }).join('');
  const hostOps = $('#b3Ops'); if (hostOps.innerHTML !== html) { hostOps.innerHTML = html; $$('.b3-sprite.op', hostOps).forEach(sp => sp.onclick = e => { e.stopPropagation(); abrirOperador(sp.dataset.op); }); }
  // burbujas con lo que acaba de llegar
  if (DB.log.length > B3.logN) {
    const nuevos = DB.log.slice(B3.logN).filter(l => l.r === r).slice(-6); B3.logN = DB.log.length;
    nuevos.forEach((l, i) => { const sp = $(`.b3-sprite.op[data-op="${CSS.escape(l.op)}"]`); if (!sp) return; const d = document.createElement('div'); d.className = 'b3-burbuja'; d.style.animationDelay = (i * .25) + 's';
      d.innerHTML = `<b>${esc(String(l.item))}</b> ${fmtQ(l.q)}`; sp.querySelector('.sp-in').appendChild(d); setTimeout(() => d.remove(), 2600 + i * 250); });
  } else B3.logN = DB.log.length;
  // pantalla de pared
  const tot = av.total, c = av.cont, p = tot ? c / tot : 0, activos = ops.filter(o => o.ult && ahora - o.ult < 15 * 60000).length;
  const barras = av.lista.slice(0, 14).map(b => `<i style="height:${Math.max(4, (b.total ? b.cont / b.total : 0) * 100).toFixed(0)}%" class="${b.total && b.cont >= b.total ? 'ok' : ''}" title="${esc(subCorta(b.sub))}"></i>`).join('');
  const eta = etaRonda(r), etaT = etaTexto(eta);
  $('#b3Pant').innerHTML = `<div class="pt-h"><span>${esc(DB.inv.nombre)}</span><span class="live"><i></i>${NOMR[r]}</span></div><div class="pt-big">${pct(p, 0)}<small>${fmtN(c)} de ${fmtN(tot)} ítems</small>${etaT ? `<em class="pt-eta">⏱ ${esc(etaT)}</em>` : ''}</div><div class="pt-bars">${barras}</div><div class="pt-f"><span>${fmtN(activos)} operadores activos</span><span>${fmtN(tot - c)} sin contar</span><span>${fmtHs(ahora)}</span></div>`;
  B3.pared = { r, av, eta, activos, ops, ahora }; if (B3.paredAbierta) b3PintarPared();
  // saludo y toolbar
  $('#b3Saludo').innerHTML = `<b>${saludoHora()}, Área de Control</b><span><i class="dot on"></i>${fmtN(activos)} de ${fmtN(ops.length)} operadores contando · ronda ${r} ${estadoRonda(r)}</span>`;
  $('#b3Kpis').innerHTML = [['target', pct(p, 0), 'avance'], ['clock', fmtN(tot - c), 'sin contar'], ['alert', fmtN(av.lista.reduce((a, b) => a + b.nDif, 0)), 'con diferencia'], ['users', fmtN(activos), 'activos'], ...(eta && eta.fin && !eta.detenido && eta.falta ? [['clock', fmtHm(eta.fin), 'termina ~']] : [])].map(([ic, v, l]) => `<span class="b3-kpi">${ARK.svg(ic)}<b>${v}</b><small>${l}</small></span>`).join('');
};
/* ---- ventanas: viven dentro del elemento en pantalla completa cuando lo hay (si no, en el body) ---- */
function b3Ventana(html, cls) {
  const ov = $('#b3Modal'); const host = document.fullscreenElement && document.fullscreenElement !== ov ? document.fullscreenElement : document.body;
  if (ov.parentElement !== host) host.appendChild(ov);
  ov.hidden = false; ov.className = 'b3-modal ' + (cls || ''); ov.innerHTML = html;
  ov.onclick = e => { if (e.target === ov) b3CerrarVentana(); };
  const x = ov.querySelector('.b3m-x'); if (x) x.onclick = b3CerrarVentana;
  return ov;
}
function b3CerrarVentana() { const ov = $('#b3Modal'); ov.hidden = true; ov.innerHTML = ''; }
const colsItems = (r, conBlk) => [{ l: 'Ítem', f: l => `<b class="num">${esc(l.item)}</b>` }, { l: 'Descripción', f: l => esc(l.desc) + (l.inact ? ' <span class="pill p-warn">INACTIVO</span>' : ''), cls: 'desc' }, ...(conBlk ? [{ l: 'Bloque', f: l => `<span class="small">${blkHtml(l.blk)}</span>` }] : []), { l: 'U.M.', f: l => esc(l.um || 'UND') }, { l: 'Existencia', n: 1, f: l => fmtQ(l.teo) }, { l: `Contado R${r}`, n: 1, f: l => l.q == null ? '<span class="pill p-mute">SIN CONTAR</span>' : `<b>${fmtQ(l.q)}</b>` },
  { l: 'Diferencia', n: 1, f: l => l.q == null ? '—' : l.dif ? `<span class="${l.dif < 0 ? 'neg' : 'pos'}">${fmtQ(l.dif)}</span>` : '<span class="muted">0</span>' }, { l: 'Quién · cuándo', f: l => l.q == null ? '' : `${esc(l.op)} <span class="muted small">${fmtHs(l.ts)}</span>` }];
const filtraItems = (lines, f, q) => lines.filter(l => (f === 'todos' || (f === 'cont' && l.q != null) || (f === 'pend' && l.q == null) || (f === 'dif' && l.q != null && l.dif)) && (!q || norm(l.cod + ' ' + l.item + ' ' + l.desc).includes(q)));
const segHtml = id => `<div class="seg" id="${id}"><button type="button" data-v="todos" class="on">Todos</button><button type="button" data-v="cont">Contados</button><button type="button" data-v="pend">Sin contar</button><button type="button" data-v="dif">Con diferencia</button></div>`;
function lineasDe(codes, r) { const cont = DB.cont[r] || {}, set = codes instanceof Set ? codes : new Set(codes); return R.lines.filter(l => set.has(l.k)).map(l => { const x = cont[l.k]; const e = estadoTras(l.k, r); return Object.assign({}, l, { blk: blk(l.k, r), q: x ? x.q : null, op: x ? opNom(x.op) : '', opId: x ? x.op : '', ts: x ? x.ts : 0, dif: x ? e.difAj : null }); }); }
/* ---- ventana de un operador: cómo va, sus bloques y sus ítems ---- */
function abrirOperador(id) {
  if (!DB.inv || !R) return; const r = DB.inv.ronda, av = R.av[r], o = av.porOp[id] || { op: id, nombre: opNom(id), cont: 0, asig: 0, blks: [], ritmo: 0, ult: 0 }, ahora = Date.now();
  const mios = Object.keys(av.dueno).filter(c => av.dueno[c] === id); const lines = lineasDe(mios, r); const c = b3Col(DB.ops.findIndex(z => z.id === id));
  const act = o.ult && ahora - o.ult < 15 * 60000, falta = o.asig - o.cont, eta = o.ritmo && falta > 0 && act ? ahora + falta / o.ritmo * 36e5 : null;
  const blks = o.blks.map(b => { const pb = av.porBlk[b], po = pb && pb.porOp && pb.porOp[id]; return { b, asig: po ? po.asig : (pb ? pb.total : 0), cont: po ? po.cont : 0, varios: pb && pb.ops.length > 1 }; });
  const chips = [[fmtN(o.cont) + ' / ' + fmtN(o.asig), 'contados'], [pct(o.asig ? o.cont / o.asig : 0, 0), 'avance'], [o.ritmo ? fmtN(o.ritmo) + ' /h' : '—', 'ritmo'], [o.ult ? fmtHm(o.ult) : '—', 'último registro'], [falta <= 0 && o.asig ? 'terminó' : eta ? '~' + fmtHm(eta) : act ? '—' : 'quieto', falta <= 0 && o.asig ? 'todo lo suyo' : 'termina lo suyo']];
  B3.vFiltro = 'todos'; B3.vQ = ''; B3.vBlk = '';
  const ov = b3Ventana(`<div class="b3m"><div class="b3m-h"><span class="bi" style="background:${c};color:#fff">${B3_SVG.persona('#fff', '#2E3A33').replace('class="av-svg"', 'class="av-svg mini"')}</span><div><b>${esc(o.nombre)}</b><span>${act ? '<i class="dot on"></i> contando ahora' : o.ult ? 'sin registros desde ' + fmtHm(o.ult) : 'todavía no ha registrado'} · ronda ${r}</span></div>
      <div class="b3-kpis">${chips.map(([v, l]) => `<span class="b3-kpi"><b>${v}</b><small>${l}</small></span>`).join('')}</div><button class="b3m-x" type="button" aria-label="Cerrar">✕</button></div>
    <div class="b3m-blks">${blks.map(x => `<button type="button" class="b3m-blk ${x.asig && x.cont >= x.asig ? 'done' : ''}" data-blk="${esc(x.b)}"><b>${blkHtml(x.b)}</b><span>${fmtN(x.cont)} / ${fmtN(x.asig)}${x.varios ? ' · su parte' : ''}</span><i><u style="width:${x.asig ? Math.min(100, x.cont / x.asig * 100) : 0}%"></u></i></button>`).join('') || '<span class="muted small">Sin bloques asignados en esta ronda.</span>'}</div>
    <div class="b3m-t">${segHtml('b3mSeg')}<input type="search" id="b3mQ" placeholder="Buscar ítem o descripción"><span class="muted small" id="b3mInfo"></span></div>
    <div class="b3m-b" id="b3mBody"></div></div>`);
  const pintar = () => { const rows = filtraItems(lines.filter(l => !B3.vBlk || l.blk === B3.vBlk), B3.vFiltro, norm(B3.vQ)); $('#b3mInfo').textContent = `${fmtN(rows.length)} ítems${B3.vBlk ? ' · ' + subDeBlk(B3.vBlk) : ''}`; ARK.table($('#b3mBody'), colsItems(r, true), rows, { size: 60, empty: 'Sin ítems con ese filtro.' }); };
  pintar();
  $$('#b3mSeg button', ov).forEach(bt => bt.onclick = () => { $$('#b3mSeg button', ov).forEach(x => x.classList.toggle('on', x === bt)); B3.vFiltro = bt.dataset.v; pintar(); });
  $$('.b3m-blk', ov).forEach(bt => bt.onclick = () => { B3.vBlk = B3.vBlk === bt.dataset.blk ? '' : bt.dataset.blk; $$('.b3m-blk', ov).forEach(x => x.classList.toggle('sel', x.dataset.blk === B3.vBlk)); pintar(); });
  $('#b3mQ').oninput = e => { B3.vQ = e.target.value; pintar(); };
}
/* ---- reparto de un bloque entre varios operadores (control) ---- */
function abrirReparto(b) {
  const r = DB.inv.ronda, av = R.av[r], pb = av.porBlk[b]; if (!pb || pb.ops.length < 2) return;
  const ops = pb.ops, lista = pb.codes || [], cambios = Object.assign({}, (DB.rep[r] && DB.rep[r][b]) || {}), cont = DB.cont[r] || {};
  const auto = {}; lista.forEach((c, i) => { auto[c] = duenoAuto(i, lista.length, ops); });
  const dueno = c => (cambios[c] && ops.includes(cambios[c])) ? cambios[c] : auto[c];
  const lines = lineasDe(lista, r).sort((x, y) => cmpCod(x.k, y.k)); const sel = new Set(); let q = '';
  const opts = ops.map(id => `<option value="${id}">${esc(opNom(id))}</option>`).join('');
  const ov = b3Ventana(`<div class="b3m"><div class="b3m-h"><span class="bi">${ARK.svg('users')}</span><div><b>Repartir ${blkHtml(b)}</b><span>${fmtN(lista.length)} ítems entre ${ops.map(opNom).join(', ')} · por defecto partes iguales y contiguas; aquí se cambia ítem por ítem</span></div><div class="b3-kpis" id="repResumen"></div><button class="b3m-x" type="button" aria-label="Cerrar">✕</button></div>
    <div class="b3m-t"><input type="search" id="repQ" placeholder="Buscar ítem o descripción"><label class="chk small"><input type="checkbox" id="repTodos"> marcar los visibles</label><span class="muted small" id="repSel">0 marcados</span><select id="repA"><option value="">asignar marcados a…</option>${opts}</select><button class="btn" type="button" id="repAuto">Volver a partes iguales</button><button class="btn pri" type="button" id="repOk" style="margin-left:auto">Guardar reparto</button></div>
    <div class="b3m-b" id="repBody"></div>${DB.srvRep ? '' : '<p class="banner" style="margin:0 18px 14px">El servidor todavía es v3: el reparto se guarda, pero los celulares verán el bloque completo hasta actualizar el script a v4.</p>'}</div>`);
  const resumen = () => { const n = {}; ops.forEach(id => n[id] = { a: 0, c: 0 }); lista.forEach(c => { const d = dueno(c); n[d].a++; if (cont[c]) n[d].c++; }); $('#repResumen').innerHTML = ops.map(id => `<span class="b3-kpi"><i class="dot" style="background:${b3Col(DB.ops.findIndex(z => z.id === id))}"></i><b>${fmtN(n[id].c)}/${fmtN(n[id].a)}</b><small>${esc(opNom(id))}</small></span>`).join('') + `<span class="b3-kpi"><b>${fmtN(Object.keys(cambios).filter(c => cambios[c] !== auto[c] && ops.includes(cambios[c])).length)}</b><small>cambios manuales</small></span>`; $('#repSel').textContent = `${fmtN(sel.size)} marcados`; };
  const pintar = () => {
    const rows = lines.filter(l => !q || norm(l.cod + ' ' + l.item + ' ' + l.desc).includes(q));
    ARK.table($('#repBody'), [{ l: '', f: l => `<input type="checkbox" data-sel="${esc(l.k)}" ${sel.has(l.k) ? 'checked' : ''}>` }, { l: 'Ítem', f: l => `<b class="num">${esc(l.item)}</b>` }, { l: 'Descripción', f: l => esc(l.desc), cls: 'desc' }, { l: 'Existencia', n: 1, f: l => fmtQ(l.teo) }, { l: `Contado R${r}`, n: 1, f: l => l.q == null ? '<span class="muted">—</span>' : `<b>${fmtQ(l.q)}</b> <span class="muted small">${esc(l.op)}</span>` },
      { l: 'Lo cuenta', f: l => `<select data-d="${esc(l.k)}" class="rep-sel ${dueno(l.k) !== auto[l.k] ? 'manual' : ''}">${ops.map(id => `<option value="${id}" ${dueno(l.k) === id ? 'selected' : ''}>${esc(opNom(id))}${auto[l.k] === id ? ' (auto)' : ''}</option>`).join('')}</select>` }], rows,
      { size: 100, empty: 'Sin ítems.', after: h => { h.querySelectorAll('[data-sel]').forEach(cb => cb.onchange = () => { cb.checked ? sel.add(cb.dataset.sel) : sel.delete(cb.dataset.sel); resumen(); }); h.querySelectorAll('[data-d]').forEach(s => s.onchange = () => { cambios[s.dataset.d] = s.value; s.classList.toggle('manual', s.value !== auto[s.dataset.d]); resumen(); }); } });
    resumen();
  };
  pintar();
  $('#repQ').oninput = e => { q = norm(e.target.value); pintar(); };
  $('#repTodos').onchange = e => { lines.filter(l => !q || norm(l.cod + ' ' + l.item + ' ' + l.desc).includes(q)).forEach(l => e.target.checked ? sel.add(l.k) : sel.delete(l.k)); pintar(); };
  $('#repA').onchange = e => { const id = e.target.value; if (!id) return; sel.forEach(c => { cambios[c] = id; }); sel.clear(); e.target.value = ''; pintar(); toast(`Marcados asignados a ${opNom(id)}.`); };
  $('#repAuto').onclick = () => { Object.keys(cambios).forEach(k => delete cambios[k]); sel.clear(); pintar(); };
  $('#repOk').onclick = () => { const limpio = {}; Object.keys(cambios).forEach(c => { if (ops.includes(cambios[c]) && cambios[c] !== auto[c]) limpio[c] = cambios[c]; }); DB.rep[r] = DB.rep[r] || {}; if (Object.keys(limpio).length) DB.rep[r][b] = limpio; else delete DB.rep[r][b]; b3CerrarVentana(); guardarRondas(); toast('Reparto guardado.'); };
}
/* ---- ventana de un bloque: lo contado de esa estantería, simple ---- */
function b3AbrirBloque(b) {
  const r = DB.inv.ronda, av = R.av[r], pb = av.porBlk[b]; if (!pb) return;
  const cont = DB.cont[r] || {}, codes = new Set(hojaRonda(r).filter(c => blk(c, r) === b));
  const lines = lineasDe(codes, r);
  const { ic } = b3Icono(pb.sub); B3.mFiltro = 'todos'; B3.mQ = '';
  const porOp = pb.ops.length > 1 ? pb.ops.map(id => `<span class="b3-kpi"><i class="dot" style="background:${b3Col(DB.ops.findIndex(z => z.id === id))}"></i><b>${fmtN(pb.porOp[id].cont)}/${fmtN(pb.porOp[id].asig)}</b><small><a class="lnk" data-op="${id}">${esc(opNom(id))}</a></small></span>`).join('') : '';
  const ov = b3Ventana(`<div class="b3m"><div class="b3m-h"><span class="bi">${ARK.svg(ic)}</span><div><b>${pillTipo(b)}${esc(subCorta(pb.sub))}</b><span>${fmtN(pb.cont)} de ${fmtN(pb.total)} contados · ${pct(pb.total ? pb.cont / pb.total : 0, 0)} · ${pb.ops.length ? (pb.ops.length > 1 ? 'repartido entre ' : '') + pb.ops.map(id => `<a class="lnk" data-op="${id}">${esc(opNom(id))}</a>`).join(', ') : 'sin operador asignado'}</span></div>
      ${porOp ? `<div class="b3-kpis">${porOp}</div>` : ''}<button class="btn" type="button" id="b3mCons">Ver en consolidado</button><button class="b3m-x" type="button" aria-label="Cerrar">✕</button></div>
    <div class="b3m-t">${segHtml('b3mSeg')}<input type="search" id="b3mQ" placeholder="Buscar ítem o descripción"></div>
    <div class="b3m-b" id="b3mBody"></div></div>`);
  const pintar = () => ARK.table($('#b3mBody'), colsItems(r, false), filtraItems(lines, B3.mFiltro, norm(B3.mQ)), { size: 60, empty: 'Sin ítems con ese filtro.' });
  pintar();
  $$('#b3mSeg button', ov).forEach(bt => bt.onclick = () => { $$('#b3mSeg button', ov).forEach(x => x.classList.toggle('on', x === bt)); B3.mFiltro = bt.dataset.v; pintar(); });
  $$('[data-op]', ov).forEach(a => a.onclick = () => abrirOperador(a.dataset.op));
  $('#b3mQ').oninput = e => { B3.mQ = e.target.value; pintar(); };
  $('#b3mCons').onclick = () => { b3CerrarVentana(); if (document.fullscreenElement) document.exitFullscreen(); ir('cons', { sub: subDeBlk(b), est: '' }); };
}
/* ---- tablero de pared a pantalla completa ---- */
function b3AbrirPared() { const ov = $('#b3Pared'); ov.hidden = false; B3.paredAbierta = true; b3PintarPared(); if (ov.requestFullscreen) ov.requestFullscreen().catch(() => { }); }
function b3CerrarPared() { const ov = $('#b3Pared'); ov.hidden = true; B3.paredAbierta = false; if (document.fullscreenElement === ov) document.exitFullscreen(); }
function b3PintarPared() {
  const d = B3.pared; if (!d) return; const { r, av, eta, activos, ahora } = d, tot = av.total, c = av.cont, p = tot ? c / tot : 0;
  const ops = Object.values(av.porOp).filter(o => o.asig > 0 || o.cont > 0).sort((a, b) => b.cont - a.cont);
  $('#b3Pared').innerHTML = `<button class="b3m-x" type="button" id="b3pX" aria-label="Cerrar">✕</button>
    <div class="pw-h"><div class="pw-logo"><img src="data:image/png;base64," alt=""></div><div><b>${esc(DB.inv.nombre)}</b><span>${NOMR[r]} · ${ARK.fmtDate(DB.inv.fecha)}</span></div><span class="live"><i></i>en vivo · ${fmtHs(ahora)}</span></div>
    <div class="pw-main"><div class="pw-big"><b>${pct(p, 0)}</b><span>${fmtN(c)} de ${fmtN(tot)} ítems contados</span><div class="pw-bar"><i style="width:${(p * 100).toFixed(1)}%"></i></div>
        <div class="pw-eta ${eta && eta.detenido ? 'off' : ''}">${ARK.svg('clock')}<span>${esc(etaTexto(eta, true) || 'Sin estimado todavía')}</span></div>
        <div class="pw-chips"><span><b>${fmtN(tot - c)}</b> sin contar</span><span><b>${fmtN(av.lista.reduce((a, b) => a + b.nDif, 0))}</b> con diferencia</span><span><b>${fmtN(activos)}</b> de ${fmtN(ops.length)} operadores activos</span>${eta && eta.ini ? `<span>abierta <b>${fmtHm(eta.ini)}</b></span>` : ''}</div></div>
      <div class="pw-ops"><h3>Operadores</h3>${ops.map(o => { const act = o.ult && ahora - o.ult < 15 * 60000; return `<div class="pw-op ${act ? 'act' : ''}"><i style="background:${b3Col(DB.ops.findIndex(z => z.id === o.op))}"></i><b>${esc(o.nombre)}</b><span>${fmtN(o.cont)} / ${fmtN(o.asig)}</span><span>${o.ritmo ? fmtN(o.ritmo) + ' /h' : '—'}</span><span>${o.ult ? fmtHs(o.ult) : 'sin registros'}</span><em><u style="width:${o.asig ? Math.min(100, o.cont / o.asig * 100) : 0}%"></u></em></div>`; }).join('') || '<p class="muted">Sin operadores.</p>'}</div></div>
    <div class="pw-bars">${av.lista.map(b => { const q = b.total ? b.cont / b.total : 0, { ic } = b3Icono(b.sub); return `<div class="pw-b ${b.total && b.cont >= b.total ? 'ok' : ''}"><div class="col"><i style="height:${Math.max(3, q * 100).toFixed(0)}%"></i></div><span class="ic">${ARK.svg(ic)}</span><b>${esc(subCorta(b.sub))}</b><small>${fmtN(b.cont)}/${fmtN(b.total)}</small></div>`; }).join('')}</div>`;
  $('#b3pX').onclick = b3CerrarPared;
}
document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement && B3.paredAbierta) { $('#b3Pared').hidden = true; B3.paredAbierta = false; } });
document.addEventListener('keydown', e => { if (e.key === 'Escape') { const m = $('#b3Modal'); if (m && !m.hidden) b3CerrarVentana(); if (B3.paredAbierta) b3CerrarPared(); } });
document.addEventListener('fullscreenchange', () => { const ov = $('#b3Modal'); if (!document.fullscreenElement && ov && ov.parentElement !== document.body) { document.body.appendChild(ov); } });
/* ---- interacción: arrastrar para girar, rueda para acercar, botones ---- */
(function b3Wire() {
  const esc3 = $('#b3Esc'); if (!esc3) return;
  const ini = e => { if (e.target.closest('.b3-caja,.b3-rail,.b3-top,.b3-sprite.op,.b3-pantalla')) return; B3.drag = { x: e.clientX, y: e.clientY, rx: B3.rx, rz: B3.rz }; B3.auto = false; esc3.classList.add('drag'); };
  const mov = e => { if (!B3.drag) return; B3.rz = B3.drag.rz + (e.clientX - B3.drag.x) * .35; B3.rx = Math.max(30, Math.min(80, B3.drag.rx - (e.clientY - B3.drag.y) * .25)); b3Aplicar(); };
  const fin = () => { B3.drag = null; esc3.classList.remove('drag'); };
  esc3.addEventListener('pointerdown', ini); window.addEventListener('pointermove', mov, { passive: true }); window.addEventListener('pointerup', fin);
  esc3.addEventListener('wheel', e => { e.preventDefault(); B3.zoom = Math.max(.45, Math.min(2.2, B3.zoom * (e.deltaY < 0 ? 1.1 : .9))); b3Aplicar(); }, { passive: false });
  const acc = { mas: () => { B3.zoom = Math.min(2.2, B3.zoom * 1.2); }, menos: () => { B3.zoom = Math.max(.45, B3.zoom / 1.2); }, girar: () => { B3.rz += 45; }, reset: () => { Object.assign(B3, { rx: 55, rz: -36, zoom: 1 }); }, auto: () => { B3.auto = !B3.auto; $('#b3Auto').classList.toggle('on', B3.auto); }, full: () => { const el = $('#b3Esc'); if (document.fullscreenElement) document.exitFullscreen(); else if (el.requestFullscreen) el.requestFullscreen(); } };
  $$('[data-b3]').forEach(b => b.onclick = () => { acc[b.dataset.b3](); b3Aplicar(); });
  $$('[data-b3-ir]').forEach(b => b.onclick = () => { const t = b.dataset.b3Ir, i = t.indexOf(':'); const v = i < 0 ? t : t.slice(0, i), f = i < 0 ? '' : t.slice(i + 1); ir(v, f ? JSON.parse(f) : undefined); });
  let last = 0; const giro = t => { if (B3.auto && VISTA === 'bodega' && !PANT.ctl.hidden && !document.hidden) { if (last) B3.rz += (t - last) * .0025; b3Aplicar(); } last = t; requestAnimationFrame(giro); }; requestAnimationFrame(giro);
  $('#b3Auto').classList.toggle('on', B3.auto);
  // ajuste de escala al tamaño del visor
  const fit = () => { const w = esc3.clientWidth || 1000; esc3.style.setProperty('--fit', Math.max(.26, Math.min(.7, w / 2800)).toFixed(3)); }; new ResizeObserver(fit).observe(esc3); fit();
})();

</script>
</body></html>
