<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Control de Inventarios · Agrococorollo</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<style>
/* ---- core/css/tokens.css ---- */
/* =====================================================================
   core/css/tokens.css · Identidad visual Arketops + unidades de negocio
   Uso: <body data-unidad="rojo|azul|amarillo|blanco">
     rojo     = Carnicería / planta de cárnicos
     azul     = Supermercados (punto de venta)
     amarillo = Pan y Parrilla
     blanco   = Producción
   ===================================================================== */
:root{
  /* Paleta fija de marca */
  --or-red:#CE0E2D; --or-blue:#002F86; --or-yellow:#FFCD00;
  --ark-gold:#C9A227; --ark-gold-2:#E3BE45;
  /* Acento de interacción (calendarios, barras de tiempo, tablas dinámicas) */
  --orange:#F28C1E; --orange-d:#D9730D; --orange-soft:#FFF1E2; --orange-line:#F7C38E; --orange-ink:#7A3A00;
  /* Estados */
  --ok:#17824A; --ok-bg:#E3F5EA; --warn:#A35F00; --warn-bg:#FFF2D9; --bad:#C8102E; --bad-bg:#FCE4E8; --info:#2F5FB3; --info-bg:#E8EEFB;
  --surface:#FFFFFF;
  --f-body:'Nunito Sans','Segoe UI',Arial,sans-serif; --f-mono:'JetBrains Mono',Consolas,monospace;
  --r-sm:9px; --r-md:12px; --r-lg:16px;
  --ease:cubic-bezier(.2,.8,.2,1);
  color-scheme:light;

  /* Valores por defecto = rojo */
  --brand:#CE0E2D; --brand-d:#A80A24; --brand-fg:#FFFFFF; --brand-sub:#FFD5DC; --brand-line:var(--or-yellow);
  --acc:#CE0E2D; --acc-d:#A80A24; --acc-fg:#FFFFFF; --acc-soft:#FBE9EC;
  --bg:#F6F2F1; --side:#FCFAF9; --surface-2:#F8F3F2; --line:#EBDFDD; --tint:#F8E5E8;
  --fg:#2A1A1C; --muted:#8A6E71;
  --shadow:0 1px 2px rgba(60,20,25,.05),0 8px 24px rgba(60,20,25,.07);
  --shadow-lg:0 2px 4px rgba(60,20,25,.06),0 16px 36px rgba(60,20,25,.13);
}
[data-unidad="rojo"]{ }
[data-unidad="azul"]{
  --brand:#002F86; --brand-d:#00246A; --brand-sub:#BFD0F2;
  --acc:#002F86; --acc-d:#00246A; --acc-soft:#EAF1FE;
  --bg:#EEF2F8; --side:#F8FAFD; --surface-2:#F4F7FC; --line:#DFE5EF; --tint:#E6ECF8;
  --fg:#12204A; --muted:#6B7690;
  --shadow:0 1px 2px rgba(16,32,72,.05),0 8px 24px rgba(16,32,72,.07);
  --shadow-lg:0 2px 4px rgba(16,32,72,.06),0 16px 36px rgba(16,32,72,.12);
}
[data-unidad="amarillo"]{
  --brand:#FFCD00; --brand-d:#E0B400; --brand-fg:#2A2000; --brand-sub:#5C4A00; --brand-line:var(--or-red);
  --acc:#2A2000; --acc-d:#000000; --acc-fg:#FFCD00; --acc-soft:#FFF6CC;
  --bg:#FAF7EC; --side:#FFFDF5; --surface-2:#FBF8EE; --line:#ECE4C8; --tint:#FFF3BF;
  --fg:#2A2410; --muted:#857A55;
  --shadow:0 1px 2px rgba(60,50,10,.05),0 8px 24px rgba(60,50,10,.07);
  --shadow-lg:0 2px 4px rgba(60,50,10,.06),0 16px 36px rgba(60,50,10,.12);
}
[data-unidad="blanco"]{
  --brand:#FFFFFF; --brand-d:#F1F3F6; --brand-fg:#1E2430; --brand-sub:#6B7280; --brand-line:var(--or-red);
  --acc:#1E2430; --acc-d:#000000; --acc-fg:#FFFFFF; --acc-soft:#EEF0F4;
  --bg:#F3F4F7; --side:#FFFFFF; --surface-2:#F7F8FA; --line:#E3E6EC; --tint:#ECEFF4;
  --fg:#1E2430; --muted:#6B7280;
}

/* ---- core/css/base.css ---- */
/* =====================================================================
   core/css/base.css · Estructura de las apps (menú lateral + barra superior + tarjetas)
   Depende de tokens.css. Todo color sale de variables: cambiar data-unidad cambia la app.
   ===================================================================== */
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--f-body);font-size:14.5px;line-height:1.45}
::selection{background:#FFE58A}
button,input,select,textarea{font:inherit;color:inherit}
h1,h2,h3{margin:0;text-wrap:balance}
.num,td.n,th.n{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.muted{color:var(--muted)} .small{font-size:13px}
.neg{color:var(--bad)} .pos{color:var(--ok)}

/* ---------- Esqueleto ---------- */
.app{display:grid;grid-template-columns:236px minmax(0,1fr);min-height:100vh}
.side{background:var(--side);border-right:1px solid var(--line);position:sticky;top:0;height:100vh;overflow-y:auto;padding:0 10px 18px;display:flex;flex-direction:column;scrollbar-width:thin}
.side .brand{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;margin:0 -10px 10px;padding:20px 14px 16px;background:var(--brand);border-bottom:4px solid var(--brand-line)}
.side .brand img{width:190px;max-width:100%;height:auto;filter:drop-shadow(0 6px 14px rgba(0,0,0,.25));transition:transform .25s ease}
.side .brand:hover img{transform:scale(1.03)}
.side .brand b{display:block;color:var(--brand-fg);font-weight:800;font-size:16.5px;line-height:1.15}
.side .brand span{display:block;color:var(--brand-sub);font-size:12px;margin-top:2px}
.nav-sec{font-size:10.5px;font-weight:800;letter-spacing:1.3px;color:var(--muted);text-transform:uppercase;margin:16px 12px 6px}
.nav-item{display:flex;gap:10px;align-items:center;width:100%;border:0;background:none;padding:9px 12px;border-radius:10px;font-size:14px;font-weight:600;color:var(--fg);cursor:pointer;text-align:left;margin-bottom:2px;position:relative;transition:background .15s,color .15s,transform .15s}
.nav-item:hover{background:var(--tint)}
.nav-item:active{transform:scale(.985)}
.nav-item .ic{width:20px;height:20px;flex:none;display:grid;place-items:center}
.nav-item .ic svg{width:18px;height:18px}
.nav-item[aria-current="page"]{background:var(--acc);color:var(--acc-fg);box-shadow:0 8px 18px rgba(0,0,0,.18)}
.nav-item[aria-current="page"]::before{content:"";position:absolute;left:-10px;top:8px;bottom:8px;width:4px;border-radius:0 4px 4px 0;background:var(--or-yellow)}
.nav-item[aria-current="page"] .ic{color:var(--or-yellow)!important}
.new,.beta{margin-left:auto;border-radius:999px;font-size:9.5px;font-weight:800;padding:1px 7px;letter-spacing:.5px}
.new{background:var(--orange);color:#fff}
.beta{background:var(--or-yellow);color:#2A1A1C}
.nav-item[aria-current="page"] .new{background:#fff;color:var(--orange-d)}
.side .foot-side{margin-top:auto;padding:14px 10px 0;font-size:11px;color:var(--muted)}

.main{min-width:0;display:flex;flex-direction:column}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:grid;grid-template-columns:minmax(0,1fr);grid-template-areas:'tt' 'chips';gap:8px 20px;align-items:center;
  padding:12px 330px 12px 24px;background:var(--brand);color:var(--brand-fg);border-bottom:4px solid var(--brand-line);box-shadow:0 6px 18px rgba(0,0,0,.16)}
.top .tt{grid-area:tt;min-width:0}
.top h1{font-size:22px;font-weight:800;display:flex;align-items:center;gap:10px;letter-spacing:-.2px}
.top h1::before{content:"";width:6px;height:22px;border-radius:3px;background:var(--brand-line)}
.top .sub{font-size:13px;opacity:.85;margin-left:16px}
.tchips{grid-area:chips;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.mchip{font-family:var(--f-mono);font-size:12px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);border-radius:999px;padding:5px 12px;white-space:nowrap}
[data-unidad="blanco"] .mchip,[data-unidad="amarillo"] .mchip{border-color:rgba(0,0,0,.15);background:rgba(0,0,0,.05)}
[data-unidad="amarillo"] .mchip.y{background:#2A2000;border-color:#2A2000;color:#FFCD00}
.mchip.y{background:var(--or-yellow);border-color:var(--or-yellow);font-weight:700;color:#2A1A1C}
.content{padding:20px 24px 0;width:100%;max-width:1480px}

/* Sello Arketops: triángulo blanco con franja dorada, ajustado a la esquina superior derecha */
.ark{position:absolute;top:0;right:0;bottom:0;width:310px;display:flex;align-items:center;justify-content:flex-end;padding:0 26px 0 0;pointer-events:none}
.ark::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,var(--ark-gold-2),var(--ark-gold));clip-path:polygon(64px 0,100% 0,100% 100%,0 100%)}
.ark::after{content:"";position:absolute;inset:0;background:#fff;clip-path:polygon(80px 0,100% 0,100% 100%,16px 100%)}
.ark img{position:relative;z-index:1;height:46px;width:auto;display:block}
[data-unidad="blanco"] .ark::after{background:#F7F8FA}

/* ---------- Vistas y tarjetas ---------- */
section.view{padding-block:0 10px}
section.view[hidden]{display:none}
section.view:not([hidden]){animation:vIn .38s var(--ease) both}
@keyframes vIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (max-width:980px){.g2,.g3{grid-template-columns:1fr}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;min-width:0;box-shadow:var(--shadow);transition:box-shadow .2s}
.panel h2{font-weight:800;font-size:15.5px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.panel h2 .tag{font-size:12.5px;color:var(--muted);font-weight:500}
.panel .hd{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.lede{font-size:15px;max-width:85ch;margin:0}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--or-yellow);padding:4px 10px;margin:8px 0 0}

.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-bottom:16px}
@media (max-width:1100px){.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:560px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
.kpi{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:2px;min-width:0;border-top:4px solid var(--line);transition:transform .15s,box-shadow .15s;animation:kIn .45s var(--ease) both}
.kpi:nth-child(2){animation-delay:.04s}.kpi:nth-child(3){animation-delay:.08s}.kpi:nth-child(4){animation-delay:.12s}.kpi:nth-child(5){animation-delay:.16s}.kpi:nth-child(6){animation-delay:.2s}
@keyframes kIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.kpi .l{font-weight:700;font-size:11.5px;letter-spacing:.7px;text-transform:uppercase;color:var(--muted)}
.kpi .v{font-weight:800;font-size:clamp(21px,2.3vw,28px);line-height:1.1;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kpi .s{font-size:12.5px;color:var(--muted)}
.kpi.ok{border-top-color:var(--ok)} .kpi.bad{border-top-color:var(--bad)} .kpi.warn{border-top-color:var(--warn)} .kpi.acc{border-top-color:var(--or-yellow)} .kpi.brand{border-top-color:var(--acc)} .kpi.or{border-top-color:var(--orange)}
.kpi.bad .v{color:var(--bad)} .kpi.ok .v{color:var(--ok)}

/* ---------- Tablas ---------- */
.tbl-wrap{overflow:auto;max-height:620px;border:1px solid var(--line);border-radius:10px;scrollbar-width:thin}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:13.5px}
th{position:sticky;top:0;z-index:2;background:var(--surface-2);font-weight:800;font-size:11.5px;letter-spacing:.7px;color:var(--muted);text-transform:uppercase;text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:6px 10px;border-bottom:1px solid var(--line);vertical-align:top;white-space:nowrap}
td.desc{white-space:normal;min-width:200px;max-width:320px}
tbody tr:hover td{background:var(--acc-soft)}
tr.tot td{font-weight:700;background:var(--surface-2)}
.pill{display:inline-block;border-radius:999px;padding:1px 8px;font-size:11.5px;font-weight:700;letter-spacing:.3px;white-space:nowrap}
.p-ok{background:var(--ok-bg);color:var(--ok)} .p-bad{background:var(--bad-bg);color:var(--bad)} .p-warn{background:var(--warn-bg);color:var(--warn)} .p-info{background:var(--info-bg);color:var(--info)} .p-mute{background:var(--surface-2);color:var(--muted)}
.pager{display:flex;gap:8px;align-items:center;justify-content:flex-end;margin-top:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}

/* ---------- Formularios y botones ---------- */
.filters{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-bottom:12px}
.fld{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--muted);font-weight:600;min-width:0}
.fld input,.fld select,.fld textarea{border:1px solid var(--line);background:var(--surface);border-radius:7px;padding:6px 9px;font-size:14px;color:var(--fg);font-weight:500;min-width:0}
.fld input[type=search]{min-width:210px}
@media (max-width:520px){.fld input[type=search]{min-width:0;width:100%}.fld{flex:1 1 100%}}
.chk{display:inline-flex;gap:6px;align-items:center;font-size:13.5px;font-weight:500;color:var(--fg);cursor:pointer}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:7px 12px;font-weight:700;font-size:13.5px;cursor:pointer;display:inline-flex;gap:6px;align-items:center;transition:border-color .15s,background .15s,box-shadow .15s,transform .1s}
.btn:hover{border-color:var(--acc)}
.btn:active{transform:translateY(1px)}
.btn.pri{background:var(--acc);border-color:var(--acc);color:var(--acc-fg)}
.btn.pri:hover{background:var(--acc-d);box-shadow:0 6px 14px rgba(0,0,0,.18)}
.btn.or{background:var(--orange);border-color:var(--orange);color:#fff}
.btn.or:hover{background:var(--orange-d)}
.btn.y{background:var(--or-yellow);color:#2A1A1C;border-color:var(--or-yellow)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.chart-box{position:relative;height:300px}

/* Zona de carga de archivos */
.slot{position:relative;border:1.5px dashed var(--line);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:5px;cursor:pointer;background:var(--surface-2);transition:border-color .15s,background .15s;min-width:0}
.slot:hover,.slot.over{border-color:var(--acc);background:var(--acc-soft)}
.slot.ok{border-style:solid;border-color:#9FDCB8;background:#F3FBF6}
.slot .k{font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.slot .st{font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.slot input{position:absolute;inset:0;opacity:0;cursor:pointer}

/* ---------- Avisos ---------- */
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--fg);color:#fff;padding:10px 16px;border-radius:9px;font-weight:600;z-index:60;max-width:calc(100% - 32px);box-shadow:var(--shadow)}
.toast[hidden]{display:none}
.foot{font-size:12px;color:var(--muted);padding-block:18px 28px;border-top:1px solid var(--line);margin-top:24px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}

/* ---------- Celular ---------- */
@media (max-width:900px){
  .app{grid-template-columns:1fr}
  .side{position:static;height:auto;padding:0 12px 8px;border-right:0;border-bottom:1px solid var(--line)}
  .side .brand{flex-direction:row;text-align:left;margin:0 -12px 8px;padding:12px 16px;gap:14px}
  .side .brand img{width:120px}
  .navlist{display:flex;gap:4px;overflow-x:auto;padding-bottom:4px}
  .nav-sec,.side .foot-side{display:none}
  .nav-item{width:auto;white-space:nowrap;margin:0}
  .nav-item[aria-current="page"]::before{display:none}
  .top{position:relative;padding:62px 16px 12px}
  .top .sub{margin-left:0}
  .content{padding:16px 16px 0}
  .ark{left:0;width:auto;height:52px;bottom:auto;padding-right:16px}
  .ark::before{clip-path:polygon(calc(100% - 214px) 0,100% 0,100% 100%,calc(100% - 238px) 100%)}
  .ark::after{clip-path:polygon(calc(100% - 202px) 0,100% 0,100% 100%,calc(100% - 226px) 100%)}
  .ark img{height:30px}
}
@media (max-width:480px){.side .brand img{width:98px}.top h1{font-size:19px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ---- core/css/componentes.css ---- */
/* =====================================================================
   core/css/componentes.css · Componentes reutilizables
   - Selector de periodo (calendario desplegable naranja)   .drp
   - Barra de tiempo arrastrable                            .tl
   - Ranking con barras                                     .rank/.rk
   - Tabla dinámica (arrastrar campos)                      .pv-*
   - Control segmentado                                     .seg
   - Indicador circular                                     .gauge
   - Firmas del Área de Control                             .sign/.sig
   - Pantalla de carga Arketops                             .splash
   ===================================================================== */

/* ---------- Selector de periodo ---------- */
.drp{position:relative}
.drp-btn{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--orange);background:#fff;color:var(--orange-ink);border-radius:10px;padding:6px 12px;font-weight:700;cursor:pointer;white-space:nowrap;transition:box-shadow .15s,background .15s}
.drp-btn:hover,.drp.open .drp-btn{background:var(--orange-soft);box-shadow:0 0 0 3px rgba(242,140,30,.18)}
.drp-btn svg{width:17px;height:17px;color:var(--orange-d)}
.drp-btn .cv{font-size:11px;color:var(--orange-d)}
.drp-pop{position:absolute;z-index:40;top:calc(100% + 8px);left:0;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 24px 50px rgba(0,0,0,.2);display:grid;grid-template-columns:170px auto;overflow:hidden;animation:popIn .18s ease both}
@keyframes popIn{from{opacity:0;transform:translateY(-6px) scale(.98)}to{opacity:1;transform:none}}
.drp-pre{background:#FFF8F1;border-right:1px solid #F5E2CF;padding:10px;display:flex;flex-direction:column;gap:2px}
.drp-pre button{border:0;background:none;text-align:left;padding:7px 10px;border-radius:8px;font-size:13px;cursor:pointer;color:#5A3A1A}
.drp-pre button:hover{background:var(--orange-soft)}
.drp-pre button.on{background:var(--orange);color:#fff;font-weight:700}
.drp-cal{padding:12px 14px}
.drp-months{display:flex;gap:18px}
.drp-m{width:238px}
.drp-mh{display:flex;align-items:center;justify-content:space-between;font-weight:800;font-size:13.5px;margin-bottom:6px;text-transform:capitalize}
.drp-mh button{border:0;background:var(--orange-soft);color:var(--orange-d);width:28px;height:28px;border-radius:8px;cursor:pointer;font-weight:800}
.drp-g{display:grid;grid-template-columns:repeat(7,34px)}
.drp-g .dw{font-size:10.5px;color:var(--muted);text-align:center;padding:4px 0;font-weight:700}
.drp-d{height:32px;border:0;background:none;font-size:12.5px;cursor:pointer;position:relative;color:var(--fg);border-radius:0}
.drp-d.out{visibility:hidden}
.drp-d.has::after{content:"";position:absolute;left:50%;bottom:3px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--orange)}
.drp-d.nodata{color:#C9BDBE}
.drp-d.in{background:var(--orange-soft)}
.drp-d.s,.drp-d.e{background:var(--orange);color:#fff;font-weight:800}
.drp-d.s{border-radius:9px 0 0 9px}.drp-d.e{border-radius:0 9px 9px 0}.drp-d.s.e{border-radius:9px}
.drp-d.s::after,.drp-d.e::after{background:#fff}
.drp-d:hover{outline:1.5px solid var(--orange);outline-offset:-2px;border-radius:9px}
.drp-ft{display:flex;align-items:center;justify-content:space-between;gap:10px;border-top:1px solid var(--line);margin-top:10px;padding-top:10px;font-size:12.5px;color:var(--muted)}
.drp-ft b{color:var(--orange-ink)}
@media (max-width:700px){.drp-pop{position:fixed;left:8px;right:8px;top:70px;grid-template-columns:1fr;max-height:calc(100vh - 90px);overflow:auto}.drp-pre{flex-direction:row;flex-wrap:wrap;border-right:0;border-bottom:1px solid #F5E2CF}.drp-months{flex-direction:column}.drp-m:nth-child(2){display:none}}

/* ---------- Barra de tiempo ---------- */
.tl{position:relative;height:74px;margin:2px 0 14px;user-select:none;touch-action:none}
.tl-bars{position:absolute;left:0;right:0;top:0;height:46px;display:flex;align-items:flex-end;gap:2px;padding:0 2px;border-radius:10px;background:linear-gradient(#fff,#FFF8F1);border:1px solid #F5E2CF}
.tl-bars i{flex:1;min-width:2px;background:#E8D4C4;border-radius:3px 3px 0 0;transition:background .15s}
.tl-bars i.on{background:var(--orange)}
.tl-sel{position:absolute;top:0;height:46px;border:2px solid var(--orange);border-radius:10px;background:rgba(242,140,30,.10);cursor:grab}
.tl-h{position:absolute;top:8px;width:12px;height:30px;margin-left:-6px;border-radius:6px;background:#fff;border:2px solid var(--orange);box-shadow:0 2px 6px rgba(0,0,0,.18);cursor:ew-resize}
.tl-ax{position:absolute;left:0;right:0;top:50px;display:flex;justify-content:space-between;gap:8px;font-size:11px;color:var(--muted)}
.tl-ax b{color:var(--orange-ink);text-align:center}
@media (max-width:600px){.tl{height:92px}.tl-ax{flex-wrap:wrap}.tl-ax b{order:3;flex-basis:100%}}

/* ---------- Ranking ---------- */
.rank{display:flex;flex-direction:column;gap:10px}
.rk{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:10px;align-items:center}
.rk .n{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:12.5px;background:var(--orange-soft);color:var(--orange-d)}
.rk:first-child .n{background:var(--orange);color:#fff}
.rk .nm{font-weight:800;font-size:14px}
.rk .sb{font-size:12px;color:var(--muted)}
.rk .bar{height:8px;border-radius:6px;background:#F5E9E0;overflow:hidden;margin-top:4px}
.rk .bar i{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,var(--orange),#F7A94F);transform-origin:left;animation:grow .7s var(--ease) both}
@keyframes grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.rk .v{text-align:right;font-weight:800;font-variant-numeric:tabular-nums}
.rk .v small{display:block;font-weight:600;color:var(--muted);font-size:11.5px}

/* ---------- Tabla dinámica ---------- */
.pv-zones{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:12px}
@media (max-width:900px){.pv-zones{grid-template-columns:1fr}}
.pv-z{border:1.5px dashed #E6CDB8;border-radius:12px;padding:8px 10px;min-height:56px;background:#FFFBF7;transition:background .15s,border-color .15s}
.pv-z.over{background:var(--orange-soft);border-color:var(--orange)}
.pv-z>span{display:block;font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:#B07A4A;margin-bottom:6px}
.pv-chips{display:flex;flex-wrap:wrap;gap:6px}
.pv-c{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--orange-line);background:#fff;border-radius:999px;padding:4px 6px 4px 11px;font-size:12.5px;font-weight:700;color:#5A3A1A;cursor:grab;box-shadow:0 1px 2px rgba(0,0,0,.05)}
.pv-c:active{cursor:grabbing}
.pv-c.drag{opacity:.4}
.pv-c button{border:0;background:var(--orange-soft);color:var(--orange-d);border-radius:999px;font-size:10.5px;font-weight:800;padding:1px 6px;cursor:pointer}
.pv-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.pv td,.pv th{white-space:nowrap}
.pv tr.tot td,.pv td.tc{font-weight:800;background:#FFF4E8}

/* ---------- Control segmentado ---------- */
.seg{display:inline-flex;border:1.5px solid var(--orange);border-radius:10px;overflow:hidden}
.seg button{border:0;background:#fff;padding:6px 12px;font-weight:700;font-size:13px;cursor:pointer;color:var(--orange-ink)}
.seg button+button{border-left:1px solid var(--orange-line)}
.seg button.on{background:var(--orange);color:#fff}

/* ---------- Indicador circular ---------- */
.gauge{display:flex;align-items:center;gap:14px}
.gauge svg{width:92px;height:92px;flex:none}

/* ---------- Firmas del Área de Control (formato de manuales y procesos) ---------- */
.sign{margin-top:44px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:14px 18px 0;position:relative;overflow:hidden}
.sign::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:linear-gradient(90deg,var(--acc) 0 72%,var(--or-yellow) 72% 86%,var(--ark-gold) 86%)}
.sign-hd{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.sign-hd img{height:26px;width:auto}
.sign-hd b{display:block;font-size:13.5px}
.sign-hd span{font-size:12.5px;color:var(--muted)}
.sigs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0 4px}
@media (max-width:1100px){.sigs{grid-template-columns:1fr 1fr}}
@media (max-width:700px){.sigs{grid-template-columns:1fr}}
.sig{display:flex;align-items:center;gap:12px;min-width:0;padding:8px 12px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line);transition:transform .15s,box-shadow .15s}
.sig:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.sig .ph{width:64px;height:64px;flex:none;border-radius:50%;object-fit:cover;box-shadow:0 4px 10px rgba(0,0,0,.14);background:#fff}
.sig .tx{display:flex;flex-direction:column;min-width:0;line-height:1.25}
.sig small{font-size:11px;letter-spacing:.6px;color:var(--muted)}
.sig b{font-size:13.5px;font-weight:800;overflow-wrap:anywhere}
.sig span{font-size:12px;color:var(--muted);margin-top:1px}
.sig em{font-style:normal;font-size:11.5px;color:var(--muted)}
.sig .lg{height:15px;width:auto;margin-top:4px;align-self:flex-start}
.sign .foot{border-top:1px solid var(--line);margin-top:10px;padding-block:10px 12px;font-size:11.5px}

/* ---------- Pantalla de carga Arketops ---------- */
.splash{position:fixed;inset:0;z-index:100;display:grid;place-items:center;background:radial-gradient(1200px 600px at 50% 35%,#FFFFFF 0%,var(--surface-2) 55%,var(--bg) 100%);transition:opacity .6s ease,visibility .6s}
.splash.out{opacity:0;visibility:hidden}
.splash.out .sp-card{transform:scale(1.04)}
.sp-card{position:relative;display:flex;flex-direction:column;align-items:center;gap:18px;padding:30px;transition:transform .6s ease}
.sp-logo{position:relative;width:min(360px,72vw);animation:spIn 1.1s var(--ease) both}
.sp-logo img{width:100%;height:auto;display:block;animation:spFloat 3.2s ease-in-out 1.1s infinite}
.sp-shine{position:absolute;inset:0;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.95) 48%,rgba(255,226,140,.9) 52%,transparent 70%);background-size:260% 100%;background-position:120% 0;animation:spShine 1.8s ease-in-out 1s infinite;pointer-events:none}
.sp-orbit{position:absolute;left:50%;top:44%;width:min(460px,90vw);aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none}
.sp-orbit i{position:absolute;inset:0;border-radius:50%;border:1.5px solid transparent;border-top-color:rgba(201,162,39,.55);animation:spSpin 2.4s linear infinite}
.sp-orbit i:nth-child(2){inset:9%;border-top-color:var(--acc);opacity:.45;animation-duration:3.2s;animation-direction:reverse}
.sp-orbit i:nth-child(3){inset:18%;border-top-color:rgba(255,205,0,.55);animation-duration:4s}
.sp-bar{width:min(260px,60vw);height:4px;border-radius:4px;background:var(--line);overflow:hidden;position:relative}
.sp-bar i{position:absolute;top:0;bottom:0;width:40%;border-radius:4px;background:linear-gradient(90deg,var(--ark-gold),var(--or-yellow),var(--acc));animation:spBar 1.2s ease-in-out infinite}
.sp-txt{font-weight:700;font-size:15px}
.sp-sub{font-size:12px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:-10px;text-align:center}
.sp-dots b{display:inline-block;animation:spDot 1.2s infinite}
.sp-dots b:nth-child(2){animation-delay:.2s}.sp-dots b:nth-child(3){animation-delay:.4s}
@keyframes spIn{from{opacity:0;transform:translateY(16px) scale(.92);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}
@keyframes spFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes spShine{0%{background-position:120% 0}60%,100%{background-position:-60% 0}}
@keyframes spSpin{to{transform:rotate(360deg)}}
@keyframes spBar{0%{left:-40%}100%{left:100%}}
@keyframes spDot{0%,80%,100%{opacity:.2}40%{opacity:1}}

/* ===================== Supermercados OR v3.0 · estilos propios ===================== */
/* Barra superior azul completa (sin degradado) y menú con cabecera azul */
.top{background:var(--or-blue);border-bottom:4px solid var(--or-yellow)}
.side .brand{background:var(--or-blue)}
.side .brand img{width:196px}
@media (max-width:900px){.side .brand img{width:120px}}
.kpis-x{grid-template-columns:repeat(6,minmax(0,1fr))}
@media (max-width:1100px){.kpis-x{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:560px){.kpis-x{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* KPI interactivo */
.kpi.click{cursor:pointer;position:relative;overflow:hidden}
.kpi.click::after{content:"→";position:absolute;right:12px;top:10px;font-weight:800;color:var(--muted);opacity:0;transform:translateX(-4px);transition:opacity .2s,transform .2s}
.kpi.click:hover::after{opacity:1;transform:none}
.kpi.click:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.kpi .bar{height:5px;border-radius:4px;background:var(--surface-2);overflow:hidden;margin-top:6px}
.kpi .bar i{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,var(--or-blue),#2F74F0);transform-origin:left;animation:grow .8s var(--ease) both}
.kpi.sel{box-shadow:0 0 0 2px var(--or-blue),var(--shadow-lg)}

/* Banner de librerías */
.banner{margin:12px 24px 0;padding:10px 14px;border-radius:12px;background:var(--bad-bg);color:var(--bad);font-weight:700;border-left:5px solid var(--bad)}
.banner small{display:block;font-weight:500;color:var(--fg)}

/* Inicio */
.hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:18px;align-items:stretch;margin-bottom:14px}
@media (max-width:980px){.hero{grid-template-columns:1fr}}
.hero h2{font-size:22px;font-weight:800;letter-spacing:-.3px;margin-bottom:6px}
.hero p{margin:0;color:var(--muted);max-width:62ch}
.hero>div:first-child{background:linear-gradient(135deg,#fff 0%,#F2F6FD 100%);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow)}
.drop{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;border:2px dashed #9DB8EE;border-radius:16px;background:#F6F9FF;padding:20px;cursor:pointer;transition:background .2s,border-color .2s,transform .2s}
.drop:hover,.drop.over{background:#EAF1FE;border-color:var(--or-blue);transform:translateY(-1px)}
.drop.over{box-shadow:0 0 0 6px rgba(0,47,134,.08)}
.drop input{position:absolute;inset:0;opacity:0;cursor:pointer}
.drop b{font-size:16px;color:var(--or-blue)}
.drop small{color:var(--muted)}
.drop-ic svg{width:34px;height:34px;color:var(--or-blue)}
.slots{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
@media (max-width:1100px){.slots{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.slots{grid-template-columns:1fr}}
.slot{min-height:132px}
.slot .top-s{display:flex;align-items:center;gap:8px}
.slot .top-s .ic{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:#EAF1FE;color:var(--or-blue)}
.slot .top-s .ic svg{width:17px;height:17px}
.slot .n{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums}
.slot .spill{align-self:flex-start;border-radius:999px;padding:1px 10px;font-size:11.5px;font-weight:700;border:1px solid var(--line);color:var(--muted);background:var(--surface)}
.slot.ok .spill{border-color:#9FDCB8;color:var(--ok);background:var(--ok-bg)}
.slot.soon .spill{border-color:var(--orange-line);color:var(--orange-d);background:var(--orange-soft)}
.files{display:flex;flex-direction:column;gap:8px}
.fl{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface-2);animation:kIn .35s var(--ease) both}
.fl .t{font-size:10.5px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;border-radius:6px;padding:3px 7px;background:#EAF1FE;color:var(--or-blue)}
.fl .t.toma{background:var(--orange-soft);color:var(--orange-d)} .fl .t.teorico{background:#E8F6EE;color:var(--ok)} .fl .t.cea{background:#F1E9FB;color:#6B3FC8}
.fl .nm{font-weight:700;overflow-wrap:anywhere;font-size:13.5px}
.fl .sb{font-size:12px;color:var(--muted)}
.fl .act{display:flex;gap:6px;align-items:center}
.fl select{border:1px solid var(--line);border-radius:7px;padding:3px 6px;font-size:12.5px;background:#fff;max-width:200px}
@media (max-width:700px){.fl{grid-template-columns:auto minmax(0,1fr)}.fl .act{grid-column:1/-1}.fl select{max-width:none;flex:1}}
.xbtn{border:0;background:none;color:var(--muted);cursor:pointer;font-size:16px;border-radius:7px;width:28px;height:28px}
.xbtn:hover{background:var(--bad-bg);color:var(--bad)}
.feed{display:flex;flex-direction:column;gap:8px}
.fd{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;background:var(--surface-2);border-left:4px solid var(--line);cursor:pointer;transition:background .15s}
.fd:hover{background:var(--acc-soft)}
.fd.bad{border-left-color:var(--bad)} .fd.warn{border-left-color:var(--warn)} .fd.ok{border-left-color:var(--ok)} .fd.info{border-left-color:var(--info)}
.fd b{font-size:13.5px} .fd small{display:block;color:var(--muted);font-size:12px}
.fd .c{font-weight:800;font-variant-numeric:tabular-nums}
.fd .who{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:#EAF1FE;color:var(--or-blue)}
.fd .who svg{width:16px;height:16px}

/* Filtros fijos */
.sticky-f{position:sticky;top:96px;z-index:5;background:var(--bg);padding:8px 0;margin-top:-8px}
@media (max-width:900px){.sticky-f{position:static}}
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;align-items:center}
@media (max-width:600px){.split{grid-template-columns:1fr}}
.chart-box.sm{height:240px}
.kv2{display:grid;grid-template-columns:1fr auto;gap:6px 14px;font-size:13.5px}
.kv2 span:nth-child(odd){color:var(--muted)} .kv2 b{text-align:right;font-variant-numeric:tabular-nums}

/* Tablas: fila clicable y barra de diferencia */
tr.clk{cursor:pointer} tr.clk:hover td{background:#EAF1FE}
.dbar{display:inline-block;height:8px;border-radius:4px;vertical-align:middle;margin-left:6px}
.dbar.n{background:var(--bad)} .dbar.p{background:var(--ok)}
.chipf{display:inline-flex;align-items:center;gap:6px;border-radius:999px;background:#EAF1FE;color:var(--or-blue);font-size:12px;font-weight:700;padding:3px 10px;margin:0 6px 8px 0}
.chipf button{border:0;background:none;color:inherit;cursor:pointer;font-weight:800}

/* Puntos a revisar */
.rev-head{display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:14px}
.score{display:flex;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:10px 16px;box-shadow:var(--shadow)}
.score svg{width:72px;height:72px}
.score b{font-size:15px} .score small{display:block;color:var(--muted)}
.rev-list{display:flex;flex-direction:column;gap:10px}
.rv{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden;border-left:5px solid var(--line);animation:kIn .35s var(--ease) both}
.rv.bad{border-left-color:var(--bad)} .rv.warn{border-left-color:var(--warn)} .rv.info{border-left-color:var(--info)} .rv.ok{border-left-color:var(--ok)}
.rv>summary{list-style:none;display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:14px;align-items:center;padding:12px 16px;cursor:pointer}
.rv>summary::-webkit-details-marker{display:none}
.rv .sev{font-size:10.5px;font-weight:800;letter-spacing:.8px;border-radius:6px;padding:3px 8px}
.rv.bad .sev{background:var(--bad-bg);color:var(--bad)} .rv.warn .sev{background:var(--warn-bg);color:var(--warn)} .rv.info .sev{background:var(--info-bg);color:var(--info)} .rv.ok .sev{background:var(--ok-bg);color:var(--ok)}
.rv .t{font-weight:800} .rv .x{font-size:13px;color:var(--muted)}
.rv .c{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums;text-align:right} .rv .c small{display:block;font-size:11.5px;color:var(--muted);font-weight:600}
.rv .cv{transition:transform .2s;color:var(--muted)} .rv[open] .cv{transform:rotate(180deg)}
.rv .body{padding:0 16px 14px}
.rv .accion{display:flex;gap:10px;align-items:flex-start;background:#F6F9FF;border-radius:10px;padding:8px 12px;margin-bottom:10px;font-size:13.5px}
.rv .accion b{color:var(--or-blue)}

/* Agentes */
.ask{display:flex;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:10px 12px;box-shadow:var(--shadow);margin-bottom:12px}
.ask input{flex:1;border:0;font-size:15px;padding:8px;background:none;min-width:0}
.ask input:focus{outline:none}
.ask-ic svg{width:26px;height:26px;color:var(--or-blue)}
#askOut:not(:empty){margin-bottom:14px}
.answer{background:linear-gradient(135deg,#F6F9FF,#fff);border:1px solid #C9D8F5;border-radius:14px;padding:14px 16px;animation:kIn .3s var(--ease) both}
.answer h3{font-size:15px;margin-bottom:6px}
.agents{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:1200px){.agents{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){.agents{grid-template-columns:1fr}}
.ag{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px 16px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:8px;min-width:0;transition:transform .15s,box-shadow .15s}
.ag:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.ag-h{display:flex;gap:10px;align-items:center}
.ag-av{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;flex:none;position:relative}
.ag-av svg{width:21px;height:21px}
.ag-av.run::after{content:"";position:absolute;inset:-4px;border-radius:15px;border:2px solid currentColor;opacity:.4;animation:pulse 1.2s ease-out infinite}
@keyframes pulse{from{transform:scale(.9);opacity:.6}to{transform:scale(1.15);opacity:0}}
.ag-h b{display:block;font-size:14.5px} .ag-h small{color:var(--muted);font-size:12px}
.ag-st{margin-left:auto;font-size:11px;font-weight:800;border-radius:999px;padding:2px 9px;background:var(--surface-2);color:var(--muted)}
.ag-st.ok{background:var(--ok-bg);color:var(--ok)} .ag-st.warn{background:var(--warn-bg);color:var(--warn)} .ag-st.bad{background:var(--bad-bg);color:var(--bad)}
.ag ul{margin:0;padding-left:18px;font-size:13px;display:flex;flex-direction:column;gap:3px}
.ag .ag-a{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}

/* Detalle lateral */
.drawer-bg{position:fixed;inset:0;background:rgba(10,20,50,.35);z-index:70;animation:fadeIn .2s both}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(560px,100vw);background:var(--surface);z-index:71;box-shadow:-20px 0 50px rgba(10,20,50,.25);transform:translateX(105%);transition:transform .32s var(--ease);overflow-y:auto;padding:22px 22px 30px}
.drawer.open{transform:none}
.drawer-x{position:absolute;top:14px;right:14px;border:0;background:var(--surface-2);width:34px;height:34px;border-radius:10px;cursor:pointer;font-size:16px}
.drawer h3{font-size:18px;font-weight:800;padding-right:40px}
.drawer .muted{font-size:13px}
.dsec{margin-top:16px}
.dsec h4{margin:0 0 8px;font-size:12px;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.tline{display:flex;flex-direction:column;gap:4px;max-height:330px;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:6px}
.tline div{display:grid;grid-template-columns:120px 1fr auto;gap:8px;font-size:13px;padding:4px 6px;border-radius:6px}
.tline div:nth-child(odd){background:var(--surface-2)}
.tline .e{color:var(--bad)} .tline .d{background:var(--warn-bg)!important}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* Formularios */
.form2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.form2 .full{grid-column:1/-1}
@media (max-width:600px){.form2{grid-template-columns:1fr}}
.form2 .fld textarea{resize:vertical}
.beta-band{display:flex;gap:10px;align-items:center;background:#FFF9E0;border:1px solid #F3E0A0;border-radius:12px;padding:10px 14px;margin-bottom:14px;font-size:13.5px}
.qty{width:90px;border:1px solid var(--line);border-radius:6px;padding:3px 6px;text-align:right}

/* Modal y espera */
.modal{position:fixed;inset:0;background:rgba(10,20,50,.45);display:flex;align-items:center;justify-content:center;z-index:80;padding:16px}
.modal[hidden]{display:none}
.modal .box{background:var(--surface);border-radius:16px;max-width:520px;width:100%;padding:20px;border-top:5px solid var(--or-blue);display:flex;flex-direction:column;gap:12px;box-shadow:0 20px 50px rgba(0,0,0,.35);animation:popIn .2s ease both}
.modal h3{font-size:19px;font-weight:800}
.modal .row{display:flex;gap:10px;justify-content:flex-end}
.busy{position:fixed;inset:0;background:rgba(10,20,50,.3);z-index:90;display:flex;align-items:center;justify-content:center}
.busy[hidden]{display:none}
.busy>div{display:flex;gap:12px;align-items:center;background:var(--surface);padding:16px 22px;border-radius:14px;font-weight:700;box-shadow:var(--shadow-lg)}
.spin{width:20px;height:20px;border-radius:50%;border:3px solid #DCE6F8;border-top-color:var(--or-blue);animation:spSpin .8s linear infinite}
.btn.ghost{background:none}
.empty{padding:28px;text-align:center;color:var(--muted)}
.empty b{display:block;color:var(--fg);font-size:15px;margin-bottom:4px}

.drawer .kpi .v{font-size:21px}
.drawer .kpis{grid-template-columns:repeat(2,minmax(0,1fr))!important}

[hidden]{display:none!important}
/* ---- src/css/agro.css · Identidad Agrococorollo (verde campo) + vistas propias ---- */
[data-unidad="verde"]{
  --or-blue:#1E6B3C;
  --brand:#1E6B3C; --brand-d:#155029; --brand-fg:#FFFFFF; --brand-sub:#C9E9D3; --brand-line:#FFCD00;
  --acc:#1E6B3C; --acc-d:#155029; --acc-fg:#FFFFFF; --acc-soft:#E8F4EC;
  --bg:#F1F5F1; --side:#F8FBF8; --surface-2:#F3F8F4; --line:#DCE7DE; --tint:#E6F1E8;
  --fg:#15291B; --muted:#6B7F70;
  --shadow:0 1px 2px rgba(20,50,30,.05),0 8px 24px rgba(20,50,30,.07);
  --shadow-lg:0 2px 4px rgba(20,50,30,.06),0 16px 36px rgba(20,50,30,.12);
}
.side .brand .logo-txt{display:flex;flex-direction:column;align-items:center;gap:2px;color:#fff}
.side .brand .logo-txt b{font-size:19px;letter-spacing:.5px}
.side .brand .logo-txt span{font-size:11.5px;color:var(--brand-sub)}
.side .brand .logo-txt .leaf{width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.14);display:grid;place-items:center;margin-bottom:4px}
.side .brand .logo-txt .leaf svg{width:28px;height:28px;stroke:#FFCD00}
@media (max-width:900px){.side .brand .logo-txt{flex-direction:row;gap:10px}.side .brand .logo-txt .leaf{width:34px;height:34px;margin:0}.side .brand .logo-txt b{font-size:15px}}
.sp-logo .logo-txt{color:var(--brand);font-weight:800;font-size:22px}

/* ---------- Portada: elegir modo ---------- */
.portada{min-height:100vh;display:grid;place-items:center;padding:24px;background:
  radial-gradient(1200px 600px at 10% -10%,#DDF0E3 0,transparent 60%),radial-gradient(900px 500px at 110% 110%,#FFF4C2 0,transparent 55%),var(--bg)}
.portada .box{width:min(960px,100%)}
.portada .cab{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:22px;flex-wrap:wrap}
.portada .cab h1{font-size:26px;font-weight:800;color:var(--brand)}
.portada .cab p{margin:2px 0 0;color:var(--muted)}
.portada .cab img{height:44px}
.modos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media (max-width:700px){.modos{grid-template-columns:1fr}}
.modo{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:var(--shadow);cursor:pointer;text-align:left;display:flex;flex-direction:column;gap:8px;transition:transform .15s,box-shadow .15s;border-top:6px solid var(--brand)}
.modo:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.modo.ctl{border-top-color:var(--orange)}
.modo .ic{width:46px;height:46px;border-radius:12px;background:var(--acc-soft);display:grid;place-items:center;color:var(--brand)}
.modo.ctl .ic{background:var(--orange-soft);color:var(--orange-d)}
.modo .ic svg{width:26px;height:26px}
.modo h2{font-size:19px;font-weight:800}
.modo p{margin:0;color:var(--muted);font-size:14px}
.modo .cta{margin-top:auto;font-weight:800;color:var(--brand)}
.modo.ctl .cta{color:var(--orange-d)}
.portada .pie{margin-top:18px;font-size:12px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}

/* ---------- Vista de conteo (celular) ---------- */
.op{min-height:100vh;display:flex;flex-direction:column;background:var(--bg)}
.op-top{position:sticky;top:0;z-index:30;background:var(--brand);color:#fff;padding:10px 24px 10px 14px;border-bottom:4px solid var(--brand-line);box-shadow:0 6px 18px rgba(0,0,0,.16)}
.op-top .r1{display:flex;align-items:center;gap:10px}
.op-top h1{font-size:17px;font-weight:800;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.op-top .who{font-size:12px;opacity:.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:38%}
.op-top .xbtn{flex:none}
.op-top .xbtn{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:8px;padding:5px 9px;font-weight:700;font-size:12.5px;cursor:pointer}
.op-top .prog{margin-top:8px;display:flex;align-items:center;gap:10px;font-size:12.5px}
.op-top .prog .bar{flex:1;height:8px;border-radius:99px;background:rgba(255,255,255,.22);overflow:hidden}
.op-top .prog .bar i{display:block;height:100%;background:var(--or-yellow);border-radius:99px;transition:width .35s var(--ease)}
.op-top .prog b{font-variant-numeric:tabular-nums}
.op-body{padding:14px;flex:1;width:100%;max-width:760px;margin:0 auto}
.op-login{display:flex;flex-direction:column;gap:12px;margin-top:10vh}
.op-login .panel{padding:22px}
.op-login h2{font-size:20px;margin-bottom:4px}
.op-login .fld input,.op-login .fld select{font-size:17px;padding:10px 12px}
.op-login .btn.pri{font-size:16px;padding:12px;justify-content:center;margin-top:6px}
.sub-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;cursor:pointer;margin-bottom:10px;transition:transform .12s}
.sub-card:active{transform:scale(.99)}
.sub-card .t{flex:1;min-width:0}
.sub-card .t b{display:block;font-size:15.5px}
.sub-card .t span{font-size:12.5px;color:var(--muted)}
.sub-card .bar{height:7px;border-radius:99px;background:var(--surface-2);overflow:hidden;margin-top:7px}
.sub-card .bar i{display:block;height:100%;background:var(--brand);border-radius:99px}
.sub-card.done .bar i{background:var(--ok)}
.sub-card .pc{font-weight:800;font-size:18px;font-variant-numeric:tabular-nums;color:var(--brand);min-width:52px;text-align:right}
.sub-card.done .pc{color:var(--ok)}
.sub-card .ring{width:38px;height:38px;border-radius:50%;background:var(--acc-soft);display:grid;place-items:center;color:var(--brand);font-weight:800;font-size:12px}
.op-tools{position:sticky;top:94px;z-index:25;background:var(--bg);padding:8px 0 6px;display:flex;gap:8px;align-items:center}
.op-tools input[type=search]{flex:1;min-width:0;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:16px;background:var(--surface)}
.op-tools .seg button{padding:8px 11px}
.items{display:flex;flex-direction:column;gap:7px;padding-bottom:90px}
.it{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 12px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"c1 des des" "obs obs q";gap:6px 10px;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,.03)}
.it .c1{grid-area:c1;display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-width:84px}
.it .c1 .code{font-family:var(--f-mono);font-size:16px;font-weight:700;color:var(--fg);letter-spacing:.2px;line-height:1.1}
.it .c1 small{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.it .c1 .um{background:var(--acc-soft);color:var(--brand);border-radius:6px;padding:1px 7px;font-weight:800;font-size:11.5px;letter-spacing:.4px}
.it .des{grid-area:des;font-weight:700;font-size:14.5px;line-height:1.25;overflow-wrap:anywhere;align-self:center}
.it .des .by{display:block;font-weight:500;font-size:11.5px;color:var(--muted)}
.it .q{grid-area:q;display:flex;gap:6px;align-items:center;justify-self:end}
.it .q input{width:96px;border:1.5px solid var(--line);border-radius:10px;padding:9px 10px;font-size:18px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums;background:var(--surface)}
.it .q input:focus{border-color:var(--brand);outline:0;box-shadow:0 0 0 3px var(--acc-soft)}
.it .q .ok{width:42px;height:42px;border-radius:10px;border:0;background:var(--brand);color:#fff;font-size:18px;font-weight:800;cursor:pointer;display:grid;place-items:center}
.it .q .ok:disabled{opacity:.35}
.it .q .cero{width:38px;height:42px;border-radius:10px;border:1px solid var(--line);background:var(--surface);font-weight:800;cursor:pointer;color:var(--muted)}
.it.done{border-color:#9FDCB8;background:#F3FBF6}
.it.done .q input{border-color:#9FDCB8;color:var(--ok)}
.it.done .q .ok{background:var(--ok)}
.it .obs{grid-area:obs;border:0;border-bottom:1px dashed var(--line);background:none;font-size:12.5px;padding:3px 0;min-width:0;color:var(--muted)}
.it .obs:focus{outline:0;border-bottom-color:var(--brand);color:var(--fg)}
.it-head{display:none}
@media (min-width:700px){
  .op-body{max-width:1100px}
  .it{grid-template-columns:150px minmax(0,1fr) auto 220px;grid-template-areas:"c1 des q obs";padding:6px 12px;border-radius:10px}
  .it .c1{flex-direction:row;align-items:center;gap:8px;flex-wrap:wrap}
  .it .c1 small{display:none}
  .it .q input{width:110px}
  .it-head{display:grid;grid-template-columns:150px minmax(0,1fr) auto 220px;gap:6px 10px;padding:4px 12px;font-size:11px;font-weight:800;letter-spacing:.7px;text-transform:uppercase;color:var(--muted);position:sticky;top:150px;background:var(--bg);z-index:5}
  .it-head span:nth-child(3){min-width:196px;text-align:center}
  .items{gap:5px}
}
.it.other{border-left:4px solid var(--orange)}
.op-foot{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);padding:8px 14px calc(8px + env(safe-area-inset-bottom,0px));display:flex;gap:8px;align-items:center;justify-content:space-between;font-size:12.5px;color:var(--muted);box-shadow:0 -6px 18px rgba(0,0,0,.06)}
.op-foot .st{display:flex;align-items:center;gap:6px}
.op-foot .st i{width:9px;height:9px;border-radius:50%;background:var(--ok);display:inline-block}
.op-foot .st.off i{background:var(--warn)} .op-foot .st.bad i{background:var(--bad)}
.op-foot .btn{padding:7px 11px}
.op-add{background:var(--surface);border:1.5px dashed var(--line);border-radius:14px;padding:14px;text-align:center;color:var(--muted);cursor:pointer;margin-top:4px}
.op-add b{color:var(--brand)}
.op-done{background:var(--ok-bg);border:1px solid #9FDCB8;border-radius:14px;padding:14px 16px;color:var(--ok);font-weight:700;margin-bottom:10px;display:flex;gap:10px;align-items:center}
.op-wait{text-align:center;padding:40px 16px;color:var(--muted)}
.op-wait .big{font-size:44px;margin-bottom:8px}
.busca-res{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.busca-res button{text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:9px 12px;cursor:pointer;display:flex;gap:10px;align-items:center}
.busca-res button .c{font-family:var(--f-mono);font-size:12px;color:var(--muted);min-width:58px}
.busca-res button .s{margin-left:auto;font-size:11px;color:var(--muted);white-space:nowrap}

/* ---------- Centro de control: piezas propias ---------- */
.live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--ok)}
.live i{width:8px;height:8px;border-radius:50%;background:var(--ok);animation:pulse 1.6s infinite}
.live.off{color:var(--muted)} .live.off i{background:var(--muted);animation:none}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(23,130,74,.45)}60%{box-shadow:0 0 0 7px rgba(23,130,74,0)}}
.ronda-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:14px}
@media (max-width:760px){.ronda-strip{grid-template-columns:1fr}}
.rcard{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:var(--shadow);border-top:5px solid var(--line);display:flex;flex-direction:column;gap:6px}
.rcard.abierta{border-top-color:var(--ok)} .rcard.cerrada{border-top-color:var(--brand)} .rcard.lista{border-top-color:var(--orange)}
.rcard h3{font-size:15px;font-weight:800;display:flex;justify-content:space-between;align-items:center;gap:8px}
.rcard .kv{font-size:13px;color:var(--muted);display:flex;justify-content:space-between;gap:8px}
.rcard .kv b{color:var(--fg);font-variant-numeric:tabular-nums}
.rcard .acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.asig-row td select{min-width:160px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface-2);border-radius:999px;padding:3px 10px;font-size:12.5px;font-weight:600}
.chip .x{border:0;background:none;cursor:pointer;color:var(--muted);font-weight:800;padding:0 2px}
.chip.on{background:var(--acc-soft);border-color:var(--brand);color:var(--brand)}
.avance{height:8px;border-radius:99px;background:var(--surface-2);overflow:hidden;min-width:90px}
.avance i{display:block;height:100%;background:var(--brand);border-radius:99px}
.avance.ok i{background:var(--ok)}
.opbox{display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-bottom:10px}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}
.dot.on{background:var(--ok)} .dot.idle{background:var(--warn)} .dot.off{background:var(--line)}
.urlbox{display:flex;gap:8px;align-items:center;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-family:var(--f-mono);font-size:12.5px;overflow-wrap:anywhere}
.gate{min-height:100vh;display:grid;place-items:center;padding:20px;background:var(--bg)}
.gate .panel{width:min(420px,100%)}
.gate .fld input{font-size:18px;letter-spacing:2px;text-align:center}

/* Ajustes de color del núcleo para la unidad verde */
.drop b,.drop-ic svg{color:var(--brand)} .drop:hover,.drop.over{background:var(--acc-soft);border-color:var(--brand)} .drop.over{box-shadow:0 0 0 6px rgba(30,107,60,.1)}
.modal .box{border-top-color:var(--brand)} .rv .accion b{color:var(--brand)} .rv .accion{background:#F2F8F3}
.hero>div:first-child{background:linear-gradient(135deg,#fff 0%,#EEF6F0 100%)}
.btn.ghost{background:transparent}
.kpi .bar i{background:linear-gradient(90deg,var(--brand),#3F9A63)} .spin{border-color:#D5E6DA;border-top-color:var(--brand)}
/* ---- v3 ---- */
.chk-list{display:flex;flex-direction:column;gap:6px;margin-top:12px}
.chk-row{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);border-radius:10px;padding:7px 10px;background:var(--surface)}
.chk-row .ic{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:12px;flex:none;color:#fff;background:var(--muted)}
.chk-row.ok .ic{background:var(--ok)} .chk-row.bad .ic{background:var(--bad)} .chk-row.warn .ic{background:var(--warn)}
.chk-row.bad{border-color:#F3B6C0;background:var(--bad-bg)}
.chk-row b{display:block;font-size:13.5px} .chk-row small{color:var(--muted);font-size:12.5px}
.pasos{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;font-size:14px}
details.aj>summary{cursor:pointer;list-style:none}
details.aj>summary::-webkit-details-marker{display:none}
.sub-card.tF{border-left:5px solid var(--bad)} .sub-card.tS{border-left:5px solid var(--ok)}
.sub-card .t b .pill{font-size:10.5px;vertical-align:2px}
.op-top h1 .pill{font-size:11px;vertical-align:2px;background:rgba(255,255,255,.92)}
.it .prevq{grid-area:pv;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:64px;border-radius:10px;background:var(--orange-soft);color:var(--orange-ink);padding:3px 8px;line-height:1.1}
.it .prevq small{font-size:10px;font-weight:800;letter-spacing:.6px;text-transform:uppercase}
.it .prevq b{font-size:17px;font-variant-numeric:tabular-nums}
.items.r2 .it{grid-template-areas:"c1 des des" "pv obs q"}
@media (min-width:700px){
  .items.r2 .it,.items.r2 .it-head{grid-template-columns:150px minmax(0,1fr) 80px auto 200px}
  .items.r2 .it{grid-template-areas:"c1 des pv q obs"}
}
@media (min-width:700px){ .items.r2 .it-head span:nth-child(3){min-width:0;text-align:center} .items.r2 .it-head span:nth-child(4){min-width:196px;text-align:center} }
.items.r2 .it{grid-template-areas:"c1 des des" "pv q q" "obs obs obs"}
.items.r2 .it .q{justify-self:end}
@media (min-width:700px){ .items.r2 .it{grid-template-areas:"c1 des pv q obs"} }

/* ---------- v3 · Pantallas sin desplazamiento lateral ---------- */
.content{max-width:none}
.kpis{grid-template-columns:repeat(auto-fit,minmax(165px,1fr))}
.grid.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,540px),1fr))}
.grid.g3{grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}
table{font-size:13px}
th{padding:7px 8px;white-space:normal;line-height:1.2}
td{padding:5px 8px}
td.desc{min-width:190px;max-width:none;white-space:normal}
td.wrap{white-space:normal}
td .sub2,.sub2{display:block;font-size:11.5px;color:var(--muted);font-weight:500;margin-top:1px;white-space:normal}
.cts{display:inline-grid;grid-template-columns:repeat(3,minmax(30px,auto));gap:6px;font-variant-numeric:tabular-nums}
.cts i{font-style:normal;text-align:right} .cts i.nul{color:var(--line)} .cts i.fin{font-weight:800;color:var(--fg)}
.av2{display:flex;align-items:center;gap:8px;min-width:120px} .av2 .avance{flex:1;min-width:60px} .av2 span{font-size:12px;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.mchip.off{background:#FCE4E8;border-color:#F3B6C0;color:var(--bad)}
.rcard .acts .btn{white-space:normal;text-align:left}
.filters .fld input[type=search]{min-width:180px}
/* menú lateral contraíble */
.side{position:sticky}
.side-tg{position:absolute;top:8px;right:8px;z-index:3;width:28px;height:28px;border-radius:8px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);color:#fff;font-weight:800;cursor:pointer;line-height:1}
.app{transition:grid-template-columns .2s var(--ease)}
.app.mini{grid-template-columns:66px minmax(0,1fr)}
.app.mini .side{padding:0 6px 14px;overflow-x:hidden}
.app.mini .side .brand{margin:0 -6px 8px;padding:44px 6px 12px}
.app.mini .side .brand .logo-txt b,.app.mini .side .brand .logo-txt span:not(.leaf){display:none}
.app.mini .side .brand .logo-txt .leaf{width:38px;height:38px;margin:0}
.app.mini .side-tg{right:50%;transform:translateX(50%)}
.app.mini .nav-sec,.app.mini .foot-side{display:none}
.app.mini .nav-item{justify-content:center;padding:10px 0}
.app.mini .nav-item>span:not(.ic){display:none}
.app.mini .nav-item .new{display:block;position:absolute;top:2px;right:2px;font-size:8.5px;padding:0 4px}
.app.mini .nav-item[aria-current="page"]::before{left:-6px}
@media (max-width:1500px){
  .top{padding-right:250px}
  .ark{width:235px;padding-right:18px}
  .ark::before{clip-path:polygon(50px 0,100% 0,100% 100%,0 100%)}
  .ark::after{clip-path:polygon(62px 0,100% 0,100% 100%,12px 100%)}
  .ark img{height:36px}
  .content{padding:16px 18px 0}
  .kpi .v{font-size:clamp(19px,1.9vw,25px)}
}
@media (max-width:900px){
  .side-tg{display:none}
  .app.mini{grid-template-columns:1fr}
  .navlist{flex-wrap:wrap;overflow-x:visible}
  .app.mini .nav-item>span:not(.ic){display:inline}
  .app.mini .nav-sec{display:none}
  .app.mini .side .brand .logo-txt b{display:block}
  .top{padding-right:16px}
}

/* =====================================================================
   v4 · Capa visual Cocorollo: colores del logo, paneles flotantes tipo vidrio,
   barra de íconos, transiciones entre pantallas e ilustración agro.
   ===================================================================== */
[data-unidad="verde"]{
  --or-blue:#00A653; --or-red:#E3001B; --or-yellow:#FFCD00;
  --brand:#00A653; --brand-d:#008A44; --brand-fg:#FFFFFF; --brand-sub:#D7F5E3; --brand-line:#FFCD00;
  --acc:#00A653; --acc-d:#008A44; --acc-fg:#FFFFFF; --acc-soft:#E6F7EC;
  --bg:#EEF4EF; --side:rgba(255,255,255,.72); --surface:#FFFFFF; --surface-2:#F3F8F4; --line:#DCE8DF; --tint:#E6F3EA;
  --fg:#14301F; --muted:#6A7F70;
  --shadow:0 1px 2px rgba(20,60,35,.05),0 10px 30px rgba(20,60,35,.08);
  --shadow-lg:0 2px 6px rgba(20,60,35,.06),0 24px 48px rgba(20,60,35,.14);
  --glass:rgba(255,255,255,.78); --glass-line:rgba(255,255,255,.65);
  --ok:#00A653; --ok-bg:#E3F7EA; --bad:#E3001B; --bad-bg:#FDE6E9;
}
body{background:radial-gradient(900px 500px at -10% -10%,#D8F1E1 0,transparent 60%),radial-gradient(800px 500px at 110% 0,#FFF4C7 0,transparent 55%),var(--bg);background-attachment:fixed}
@media (prefers-reduced-motion:no-preference){ .v4-in{animation:v4In .5s var(--ease) both} }
@keyframes v4In{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
@keyframes v4Pop{from{opacity:0;transform:translateY(10px) scale(.96)}to{opacity:1;transform:none}}
@keyframes v4Float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes v4Flash{0%{box-shadow:0 0 0 0 rgba(0,166,83,.55)}100%{box-shadow:0 0 0 14px rgba(0,166,83,0)}}
@keyframes v4Ping{0%{transform:scale(1);opacity:.8}100%{transform:scale(2.4);opacity:0}}

/* ---------- paneles flotantes tipo vidrio ---------- */
.panel,.kpi,.rcard,.sub-card,.it,.modo,.gate .panel,.op-login .panel{background:var(--glass);backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);border:1px solid var(--glass-line);border-radius:18px}
.panel{box-shadow:var(--shadow)}
.panel .hd h2{align-items:center}
.panel .hd h2 .pi{width:30px;height:30px;border-radius:9px;background:var(--acc-soft);color:var(--brand);display:inline-grid;place-items:center;flex:none}
.panel .hd h2 .pi svg{width:17px;height:17px}
.kpi{border-top:0;border-radius:18px;padding:14px 16px;position:relative;overflow:hidden}
.kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--line);border-radius:18px 0 0 18px}
.kpi.ok::before{background:var(--ok)} .kpi.bad::before{background:var(--bad)} .kpi.warn::before{background:#F0A500} .kpi.acc::before{background:var(--or-yellow)} .kpi.brand::before{background:var(--brand)} .kpi.or::before{background:var(--orange)}
.kpi .ki{position:absolute;right:12px;top:12px;width:34px;height:34px;border-radius:11px;background:var(--surface-2);color:var(--brand);display:grid;place-items:center}
.kpi .ki svg{width:18px;height:18px}
.kpi.bad .ki{color:var(--bad);background:var(--bad-bg)} .kpi.ok .ki{color:var(--ok);background:var(--ok-bg)} .kpi.warn .ki{color:#A35F00;background:var(--warn-bg)} .kpi.or .ki{color:var(--orange-d);background:var(--orange-soft)}
.kpi .l{padding-right:40px}
.kpi .v{transition:transform .2s} .kpi:hover .v{transform:translateX(2px)}
.kpi .bar{height:6px;border-radius:99px;background:var(--surface-2);overflow:hidden;margin-top:6px}
.pill{border-radius:999px;padding:2px 9px}
.pill::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;margin-right:5px;vertical-align:1px}
.btn{border-radius:11px;transition:transform .12s,box-shadow .15s,background .15s}
.btn:hover{transform:translateY(-1px);box-shadow:0 6px 14px rgba(20,60,35,.12)}
.btn.pri{background:linear-gradient(135deg,var(--brand),#13B866)}
.btn .bi{width:16px;height:16px;display:inline-grid} .btn .bi svg{width:16px;height:16px}
.tbl-wrap{border-radius:14px;border-color:var(--line)}
th{background:rgba(243,248,244,.9)}
tbody tr{transition:background .15s}
.mchip{backdrop-filter:blur(6px)}

/* ---------- barra superior ---------- */
.top{background:linear-gradient(100deg,#007F40 0%,var(--brand) 55%,#13B866 100%)}
.top h1::before{background:var(--or-yellow)}
.top .tt{display:flex;align-items:center;gap:12px}
.top .tt .tlogo{width:46px;height:46px;border-radius:12px;background:#fff;display:grid;place-items:center;flex:none;box-shadow:0 4px 12px rgba(0,0,0,.18)}
.top .tt .tlogo img{width:38px;height:auto}
.top .tt>div{min-width:0}

/* ---------- menú lateral: riel de íconos flotante ---------- */
.side{background:var(--side);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-right:1px solid var(--glass-line)}
.side .brand{background:linear-gradient(160deg,#007F40,var(--brand));border-radius:0 0 22px 22px;border-bottom:0}
.side .brand .clogo{width:64px;height:64px;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:0 6px 16px rgba(0,0,0,.2);margin-bottom:6px}
.side .brand .clogo img{width:54px;height:auto}
.side .brand .logo-txt b{font-size:17px;letter-spacing:.6px}
.app.mini .side .brand .clogo{width:40px;height:40px;margin:0} .app.mini .side .brand .clogo img{width:34px}
.nav-item{border-radius:12px;transition:background .15s,transform .12s,box-shadow .15s}
.nav-item:hover{background:var(--acc-soft);transform:translateX(2px)}
.nav-item[aria-current="page"]{background:linear-gradient(135deg,var(--brand),#13B866);box-shadow:0 8px 18px rgba(0,166,83,.3)}
.nav-item[aria-current="page"]::before{display:none}
.nav-item .ic{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:rgba(0,166,83,.08);transition:background .15s}
.nav-item[aria-current="page"] .ic{background:rgba(255,255,255,.2);color:#fff!important}
.app.mini .nav-item{padding:7px 0}
.app.mini .nav-item .ic{width:38px;height:38px;border-radius:12px}
.app.mini .nav-item .ic svg{width:20px;height:20px}
.side-tg{border-radius:10px}

/* ---------- transiciones entre pantallas ---------- */
.drawer{border-radius:22px 0 0 22px}
.modal .box{border-radius:20px;border-top:0;box-shadow:var(--shadow-lg);animation:v4Pop .3s var(--ease) both}
.toast{border-radius:12px;background:#14301F;animation:v4Pop .25s var(--ease) both}

/* ---------- pantalla de carga ---------- */
.splash{background:radial-gradient(900px 500px at 50% 30%,#FFFFFF 0,#EEF7F1 55%,#E3F1E7 100%)}
.sp-logo{width:min(300px,70vw);display:grid;place-items:center;gap:8px}
.sp-logo .cl{width:150px;height:150px;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:0 14px 34px rgba(0,120,60,.18);animation:v4Float 3.2s ease-in-out 1.1s infinite}
.sp-logo .cl img{width:120px;height:auto}
.sp-logo .ark{position:static;width:auto;height:auto;padding:0;pointer-events:none} .sp-logo .ark::before,.sp-logo .ark::after{display:none} .sp-logo .ark img{height:30px;position:static}
.sp-agro{position:absolute;left:0;right:0;bottom:0;height:min(34vh,260px);pointer-events:none;opacity:.9}
.sp-agro svg{width:100%;height:100%}
.sp-orbit i{border-top-color:rgba(0,166,83,.5)} .sp-orbit i:nth-child(2){border-top-color:var(--or-red)} .sp-orbit i:nth-child(3){border-top-color:rgba(255,205,0,.8)}
.sp-bar i{background:linear-gradient(90deg,var(--or-yellow),var(--brand),var(--or-red))}

/* ---------- portada ---------- */
.portada{background:none;align-content:center}
.portada .box{width:min(1040px,100%)}
.portada .hero4{position:relative;border-radius:28px;overflow:hidden;background:linear-gradient(120deg,#007F40 0%,#00A653 60%,#2FC274 100%);color:#fff;padding:34px 36px 0;box-shadow:var(--shadow-lg);margin-bottom:18px;min-height:250px}
.portada .hero4 .txt{position:relative;z-index:2;max-width:560px}
.portada .hero4 .saludo{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:5px 12px;font-size:12.5px;font-weight:700;margin-bottom:12px}
.portada .hero4 .saludo i{width:8px;height:8px;border-radius:50%;background:var(--or-yellow);position:relative}
.portada .hero4 .saludo i::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--or-yellow);animation:v4Ping 1.6s infinite}
.portada .hero4 h1{font-size:clamp(24px,3.2vw,36px);font-weight:800;line-height:1.1;letter-spacing:-.4px}
.portada .hero4 p{margin:8px 0 0;font-size:15px;opacity:.92;max-width:48ch}
.portada .hero4 .clogo{position:absolute;right:30px;top:26px;width:96px;height:96px;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,0,0,.22);z-index:2;animation:v4Float 3.4s ease-in-out infinite}
.portada .hero4 .clogo img{width:78px;height:auto}
.portada .hero4 .agro{display:block;width:calc(100% + 72px);margin:14px -36px 0;height:150px} .portada .hero4 .agro svg{display:block;width:100%;height:100%}
.portada .cab{display:none}
.modos{gap:16px}
.modo{border-top:0;padding:22px;border-radius:22px;transition:transform .18s,box-shadow .18s}
.modo .ic{width:52px;height:52px;border-radius:15px;background:linear-gradient(135deg,var(--brand),#13B866);color:#fff;box-shadow:0 8px 18px rgba(0,166,83,.3)}
.modo.ctl .ic{background:linear-gradient(135deg,#E3001B,#FF5A3C);color:#fff;box-shadow:0 8px 18px rgba(227,0,27,.28)}
.modo .ic svg{width:26px;height:26px}
.modo .cta{display:inline-flex;align-items:center;gap:6px}
.modo .cta::after{content:"→";transition:transform .15s} .modo:hover .cta::after{transform:translateX(4px)}
.modo .cta{color:var(--brand)} .modo.ctl .cta{color:var(--or-red)}
.portada .pie{padding:0 6px}
.portada .pie img{height:22px;vertical-align:middle}
.gate .panel{border-top:5px solid var(--brand)}
.gate .fld input{border-radius:12px;font-size:22px}

/* ---------- hoja de conteo (celular) ---------- */
.op{background:radial-gradient(700px 400px at 0 -10%,#D8F1E1 0,transparent 60%),var(--bg)}
.op-top{background:linear-gradient(100deg,#007F40,var(--brand) 60%,#13B866);border-radius:0 0 22px 22px;border-bottom:0;box-shadow:0 10px 24px rgba(0,100,50,.22)}
.op-top .prog .bar i{background:linear-gradient(90deg,var(--or-yellow),#FFE26B)}
.op-top .xbtn{border-radius:10px}
.op-login{margin-top:6vh}
.op-login .lg{display:grid;place-items:center;margin-bottom:6px}
.op-login .lg .cl{width:96px;height:96px;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,120,60,.18)} .op-login .lg .cl img{width:78px}
.op-login .panel{border-top:5px solid var(--brand)}
.sub-card{border-radius:18px;transition:transform .15s,box-shadow .15s}
.sub-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.sub-card .ring{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--acc-soft),#fff);color:var(--brand);font-size:13px;box-shadow:inset 0 0 0 1px var(--line)}
.sub-card.done .ring{background:linear-gradient(135deg,var(--brand),#13B866);color:#fff;box-shadow:none}
.sub-card.tF .ring{color:var(--bad)} .sub-card.tS .ring{color:var(--ok)}
.it{border-radius:16px;transition:background .25s,border-color .25s}
.it.done{background:linear-gradient(90deg,#EAF8EF,#F6FCF8)}
.it.flash{animation:v4Flash .7s ease-out}
.it .q .ok{background:linear-gradient(135deg,var(--brand),#13B866);border-radius:12px}
.it .q .ok:active{transform:scale(.94)}
.it .q input{border-radius:12px}
.it .c1 .um{background:var(--acc-soft);color:var(--brand)}
.op-done{border-radius:16px}
.op-add{border-radius:16px;background:var(--glass)}
.op-foot{backdrop-filter:blur(10px);background:rgba(255,255,255,.85)}
.op-tools input[type=search]{border-radius:12px}

/* ---------- saludo del centro de control ---------- */
.saludo4{display:flex;align-items:center;gap:16px;background:linear-gradient(120deg,#007F40 0%,var(--brand) 60%,#2FC274 100%);color:#fff;border-radius:22px;padding:18px 22px;margin-bottom:14px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.saludo4 .cl{width:58px;height:58px;border-radius:50%;background:#fff;display:grid;place-items:center;flex:none;box-shadow:0 6px 16px rgba(0,0,0,.2)} .saludo4 .cl img{width:46px}
.saludo4 h2{font-size:20px;font-weight:800;line-height:1.15}
.saludo4 p{margin:3px 0 0;opacity:.9;font-size:13.5px}
.saludo4 .chips{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.saludo4 .chips span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:5px 12px;font-size:12.5px;font-weight:700;white-space:nowrap}
.saludo4 .chips span.y{background:var(--or-yellow);color:#2A2000;border-color:var(--or-yellow)}
.saludo4 .deco{position:absolute;right:0;bottom:0;width:100%;height:100%;opacity:.16;pointer-events:none;mix-blend-mode:screen}
@media (max-width:700px){.saludo4{flex-wrap:wrap}.saludo4 .chips{margin-left:0;justify-content:flex-start}}
.hero>div:first-child{border-radius:18px;background:var(--glass)}
.drop{border-radius:18px;background:var(--glass)}
.sign{border-radius:18px;background:var(--glass)}
.rcard{border-radius:18px;border-top-width:5px}
.chk-row{border-radius:12px}
.avance i{background:linear-gradient(90deg,var(--brand),#13B866)}
.avance.ok i{background:linear-gradient(90deg,var(--brand),#13B866)}
.dot.on{background:var(--ok);box-shadow:0 0 0 3px rgba(0,166,83,.18)}
.live i{background:var(--ok)}
.score{border-radius:18px}
.rv{border-radius:16px}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}

.op-top .oplogo{width:34px;height:34px;border-radius:50%;background:#fff;display:grid;place-items:center;flex:none;box-shadow:0 3px 8px rgba(0,0,0,.18)} .op-top .oplogo img{width:28px;height:auto}
.saludo4 .deco svg{width:100%;height:100%}
.agro-svg .ag-sun{animation:v4Float 4s ease-in-out infinite} .agro-svg .ag-cloud{animation:v4Cloud 14s linear infinite} .agro-svg .ag-cloud2{animation:v4Cloud 20s linear infinite reverse}
.agro-svg .ag-sprout,.agro-svg .ag-sprout2{transform-box:fill-box;transform-origin:50% 100%;animation:v4Sway 3.5s ease-in-out infinite} .agro-svg .ag-sprout2{animation-delay:1.2s}
@keyframes v4Cloud{0%{transform:translateX(0)}50%{transform:translateX(26px)}100%{transform:translateX(0)}}
@keyframes v4Sway{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}

/* =====================================================================
   v4.1 · Movimiento marcado: pantallas con perspectiva 3D, cascada de tarjetas,
   paneles que se inclinan con el mouse y fondo con luces que flotan.
   ===================================================================== */
.content,.portada .box,.op-body{perspective:1600px}
@keyframes v4Page{0%{opacity:0;transform:translateX(90px) rotateY(-10deg) scale(.96)}60%{opacity:1}100%{opacity:1;transform:none}}
@keyframes v4Rise{0%{opacity:0;transform:translateY(56px) rotateX(14deg) scale(.94)}100%{opacity:1;transform:none}}
@keyframes v4Num{0%{opacity:0;transform:translateY(70%)}100%{opacity:1;transform:none}}
@keyframes v4Bar{0%{transform:scaleX(0)}100%{transform:none}}
@keyframes v4NavPop{0%{transform:scale(.9)}55%{transform:scale(1.07)}100%{transform:none}}
@keyframes v4Blob{0%{transform:translate(0,0) scale(1)}33%{transform:translate(60px,-40px) scale(1.12)}66%{transform:translate(-40px,50px) scale(.95)}100%{transform:translate(0,0) scale(1)}}
@keyframes v4Hero{0%{opacity:0;transform:translateY(-60px) rotateX(-14deg) scale(.96)}100%{opacity:1;transform:none}}
@keyframes v4Gate{0%{opacity:0;transform:translateY(40px) rotateX(18deg) scale(.9)}100%{opacity:1;transform:none}}
@keyframes v4Fade{0%{opacity:0}100%{opacity:1}}
body{isolation:isolate}
body::before,body::after{content:"";position:fixed;z-index:-1;border-radius:50%;filter:blur(70px);pointer-events:none;opacity:.55}
body::before{width:520px;height:520px;left:-160px;top:-120px;background:#9FE3BC;animation:v4Blob 18s ease-in-out infinite}
body::after{width:460px;height:460px;right:-140px;bottom:-120px;background:#FFE58A;animation:v4Blob 22s ease-in-out infinite reverse}
/* entrada de cada pantalla del centro de control */
section.view.v4-anim{animation:v4Page .7s cubic-bezier(.2,.8,.2,1) both;transform-origin:0 50%;will-change:transform,opacity}
.v4-anim .kpi,.v4-anim .panel,.v4-anim .hero,.v4-anim .rcard,.v4-anim .saludo4,.v4-anim .filters,.v4-anim .score,.v4-anim .rv,.v4-anim .ronda-strip>*,.v4-anim .kpis>*{animation:v4Rise .75s cubic-bezier(.2,.8,.2,1) both;transform-origin:50% 100%}
.v4-anim .filters{animation-delay:.05s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(1){animation-delay:.10s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(2){animation-delay:.18s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(3){animation-delay:.26s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(4){animation-delay:.34s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(5){animation-delay:.42s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(6){animation-delay:.50s}
.v4-anim :is(.kpis,.grid,.ronda-strip,.rev-list)>*:nth-child(n+7){animation-delay:.58s}
.v4-anim .grid:nth-of-type(2)>*{animation-delay:.45s} .v4-anim .grid:nth-of-type(3)>*{animation-delay:.6s}
.v4-anim .grid:nth-of-type(2)>*:nth-child(2){animation-delay:.55s} .v4-anim .grid:nth-of-type(3)>*:nth-child(2){animation-delay:.7s}
.v4-anim .saludo4{animation-delay:0s} .v4-anim .hero{animation-delay:.12s}
.v4-anim .kpi .v{display:block;animation:v4Num .6s .35s cubic-bezier(.2,.8,.2,1) both}
.kpi .v{overflow:hidden}
.v4-anim .kpi .bar i,.v4-anim .avance i{transform-origin:0 50%;animation:v4Bar 1s .5s cubic-bezier(.2,.8,.2,1) both}
.nav-item[aria-current="page"]{animation:v4NavPop .4s cubic-bezier(.2,.8,.2,1) both}
.top .tchips>*{animation:v4Rise .6s cubic-bezier(.2,.8,.2,1) both} .top .tchips>*:nth-child(2){animation-delay:.08s} .top .tchips>*:nth-child(3){animation-delay:.16s} .top .tchips>*:nth-child(4){animation-delay:.24s}
/* portada, clave y app completas */
#portada:not([hidden]) .hero4{animation:v4Hero .8s cubic-bezier(.2,.8,.2,1) both}
#portada:not([hidden]) .modo{animation:v4Rise .8s cubic-bezier(.2,.8,.2,1) both} #portada:not([hidden]) .modo:nth-child(1){animation-delay:.25s} #portada:not([hidden]) .modo:nth-child(2){animation-delay:.4s}
#portada:not([hidden]) .pie{animation:v4Fade .8s .7s both}
#gate:not([hidden]) .panel{animation:v4Gate .6s cubic-bezier(.2,.8,.2,1) both}
#ctlApp:not([hidden]) .side{animation:v4PageL .7s cubic-bezier(.2,.8,.2,1) both} #ctlApp:not([hidden]) .top{animation:v4Hero .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes v4PageL{0%{opacity:0;transform:translateX(-60px)}100%{opacity:1;transform:none}}
/* hoja de conteo en el celular */
.op-body.v4-anim{animation:v4Page .55s cubic-bezier(.2,.8,.2,1) both}
.op-body.v4-anim .sub-card,.op-body.v4-anim .it,.op-body.v4-anim .op-login .panel,.op-body.v4-anim .op-add,.op-body.v4-anim .op-done{animation:v4Rise .6s cubic-bezier(.2,.8,.2,1) both}
.op-body.v4-anim :is(.sub-card,.it):nth-child(1){animation-delay:.05s} .op-body.v4-anim :is(.sub-card,.it):nth-child(2){animation-delay:.11s} .op-body.v4-anim :is(.sub-card,.it):nth-child(3){animation-delay:.17s} .op-body.v4-anim :is(.sub-card,.it):nth-child(4){animation-delay:.23s} .op-body.v4-anim :is(.sub-card,.it):nth-child(5){animation-delay:.29s} .op-body.v4-anim :is(.sub-card,.it):nth-child(n+6){animation-delay:.35s}
#opApp:not([hidden]) .op-top{animation:v4Hero .6s cubic-bezier(.2,.8,.2,1) both}
.op-login .lg .cl{animation:v4Float 3s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* v6: estimado de finalización */
.eta{display:flex;align-items:center;gap:8px;margin-top:8px;background:var(--acc-soft);color:var(--brand-d);border-radius:12px;padding:8px 12px;font-size:13px} .eta svg{width:18px;height:18px;flex:none} .eta.off{background:var(--warn-bg);color:#A35F00}
.mchip.eta{background:#FFCD00;color:#2A2000}

/* =====================================================================
   v5 · Bodega en vivo: escena 3D con CSS (piso, paredes, estanterías, operadores)
   ===================================================================== */
.b3-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.b3-saludo{background:var(--glass);backdrop-filter:blur(12px);border:1px solid var(--glass-line);border-radius:16px;padding:10px 16px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:2px;min-width:240px}
.b3-saludo b{font-size:17px;font-weight:800;color:var(--fg)} .b3-saludo span{font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:6px}
.b3-pill{display:flex;gap:4px;background:var(--glass);backdrop-filter:blur(12px);border:1px solid var(--glass-line);border-radius:999px;padding:5px;box-shadow:var(--shadow);margin:0 auto}
.b3-pill button{width:40px;height:40px;border-radius:50%;border:0;background:transparent;color:var(--fg);display:grid;place-items:center;cursor:pointer;transition:background .15s,transform .15s,color .15s}
.b3-pill button svg{width:19px;height:19px} .b3-pill button:hover{background:var(--brand);color:#fff;transform:translateY(-2px) scale(1.08)}
.b3-kpis{display:flex;gap:6px;flex-wrap:wrap}
.b3-kpi{display:inline-flex;align-items:center;gap:7px;background:var(--glass);backdrop-filter:blur(12px);border:1px solid var(--glass-line);border-radius:999px;padding:6px 12px 6px 8px;box-shadow:var(--shadow);font-size:12px;color:var(--muted)}
.b3-kpi svg{width:16px;height:16px;color:var(--brand)} .b3-kpi b{font-size:15px;color:var(--fg);font-variant-numeric:tabular-nums}
.b3-esc{position:relative;height:clamp(420px,66vh,720px);border-radius:24px;overflow:hidden;background:radial-gradient(900px 500px at 50% 0,#FFFFFF 0,#EEF6F1 55%,#DCE9E0 100%);box-shadow:var(--shadow-lg);perspective:2400px;perspective-origin:50% 20%;cursor:grab;user-select:none;touch-action:none;--fit:.8}
.b3-esc.drag{cursor:grabbing} .b3-esc:fullscreen{border-radius:0;height:100vh}
.b3-mundo{position:absolute;left:50%;top:53%;width:1700px;height:1150px;transform-style:preserve-3d;transform:translate(-50%,-50%) scale(calc(var(--fit) * var(--zoom,1))) rotateX(var(--rx,58deg)) rotateZ(var(--rz,-38deg));transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.b3-esc.drag .b3-mundo{transition:none}
.b3-mundo *{transform-style:preserve-3d}
.b3-piso{position:absolute;inset:0;background:linear-gradient(90deg,#D8B98A 0,#E6CBA0 50%,#D8B98A 100%);box-shadow:0 0 0 14px #C9A77A,0 60px 120px rgba(20,60,35,.25)}
.b3-piso::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(120,80,40,.14) 0 2px,transparent 2px 90px),repeating-linear-gradient(0deg,rgba(120,80,40,.08) 0 1px,transparent 1px 420px)}
.b3-grid{position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.12) 0 1px,transparent 1px 60px)}
.b3-alfombra{position:absolute;left:120px;top:190px;right:120px;bottom:110px;border-radius:40px;background:rgba(0,166,83,.14);box-shadow:inset 0 0 0 6px rgba(0,166,83,.18)}
.b3-pared{position:absolute;background:linear-gradient(#FFFFFF,#EEF3EF);box-shadow:inset 0 -8px 0 #D4DED8}
.b3-pared.bk{left:0;top:-330px;width:1700px;height:330px;transform-origin:50% 100%;transform:rotateX(-90deg)}
.b3-pared.iz{left:-330px;top:0;width:330px;height:1150px;transform-origin:100% 50%;transform:rotateY(90deg);background:linear-gradient(90deg,#F4F7F5,#E4ECE7)}
.b3-pared.iz::after{content:"";position:absolute;left:60px;right:60px;top:60px;bottom:60px;border-radius:14px;background:linear-gradient(90deg,#BFE3FF,#E8F6FF);box-shadow:inset 0 0 0 6px #fff;opacity:.9}
.b3-pantalla{position:absolute;left:560px;top:40px;width:820px;height:250px;border-radius:18px;transform:translateZ(4px);background:#13231B;box-shadow:0 0 0 10px #2E3A33,0 20px 50px rgba(0,0,0,.35);color:#fff;padding:22px 26px;display:flex;flex-direction:column;overflow:hidden}
.b3-pantalla::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(255,255,255,.08),transparent 40%);pointer-events:none}
.pt-in{display:flex;flex-direction:column;height:100%}
.pt-h{display:flex;justify-content:space-between;align-items:center;font-size:15px;font-weight:700;opacity:.9} .pt-h .live{color:#7CE3A8;font-size:13px} .pt-h .live i{background:#7CE3A8}
.pt-big{font-size:64px;font-weight:800;letter-spacing:-2px;line-height:1;margin:10px 0 6px;display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;color:#FFCD00} .pt-big small{font-size:16px;color:#fff;opacity:.8;letter-spacing:0;font-weight:600}
.pt-bars{flex:1;display:flex;align-items:flex-end;gap:10px;padding:6px 0 4px} .pt-bars i{flex:1;background:linear-gradient(180deg,#5CE49A,#00A653);border-radius:6px 6px 0 0;min-height:4px;transition:height .6s;opacity:.9} .pt-bars i.ok{background:linear-gradient(180deg,#FFE27A,#FFCD00)}
.pt-f{display:flex;justify-content:space-between;font-size:13px;opacity:.75;border-top:1px solid rgba(255,255,255,.15);padding-top:8px}
.b3-logo{position:absolute;left:230px;top:50px;width:280px;height:230px;border-radius:18px;transform:translateZ(4px);background:#fff;box-shadow:0 10px 30px rgba(0,0,0,.15);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center}
.b3-logo img{width:110px} .b3-logo b{color:var(--brand);font-size:20px;letter-spacing:1px} .b3-logo span{font-size:13px;color:var(--muted)}
/* estanterías */
.b3-caja{position:absolute;left:0;top:0;width:var(--w);height:var(--d);cursor:pointer;--c1:#F6FAF7;--c2:#DCE6DF;--c3:#C7D4CB;--c4:#B6C4BA}
.b3-caja .f{position:absolute;display:block;border:1px solid rgba(20,60,35,.12);box-sizing:border-box}
.b3-caja>.f.tapa{inset:0;background:color-mix(in srgb,var(--tint,var(--c1)) 80%,#fff);transform:translateZ(var(--h));display:grid;place-items:center}
.b3-caja .tico{width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.75);display:grid;place-items:center;color:#2E3A33;opacity:.85} .b3-caja .tico svg{width:28px;height:28px}
.b3-caja>.f.fr{left:0;top:calc(var(--d) - var(--h));width:var(--w);height:var(--h);transform-origin:50% 100%;transform:rotateX(-90deg);background:color-mix(in srgb,var(--tint,var(--c3)) 55%,rgba(255,255,255,.35))}
.b3-caja>.f.fr .fl{position:absolute;inset:0;display:flex;align-items:center;gap:8px;padding:4px 9px;color:#17281E;text-align:left}
.b3-caja>.f.fr .fl .bi{width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.85);color:#1F6B3C;display:grid;place-items:center;flex:none} .b3-caja>.f.fr .fl .bi svg{width:21px;height:21px}
.b3-caja>.f.fr .fl .bt{min-width:0;flex:1;line-height:1.15} .b3-caja>.f.fr .fl b{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:16px;font-weight:800;overflow:hidden;line-height:1.05} .b3-caja>.f.fr .fl span{display:block;font-size:13px;color:#3C5245;margin-top:1px} .b3-caja>.f.fr .fl em{display:block;height:5px;border-radius:99px;background:#00A653;margin-top:4px;transition:width .6s} .b3-caja.done>.f.fr .fl em{background:#E0B300}
.b3-caja>.f.fr .fl .tp{display:inline-block;font-style:normal;font-size:10px;font-weight:800;letter-spacing:.4px;border-radius:999px;padding:0 6px;margin-bottom:2px;background:var(--bad-bg);color:var(--bad)} .b3-caja>.f.fr .fl .tp.s{background:var(--ok-bg);color:var(--ok)}
.b3-caja.tF>.f.fr .fl .bi{background:#FFE4E8;color:#B50016} .b3-caja.done>.f.fr .fl .bi{background:#FFF3B8;color:#8A6A00}
.b3-caja>.f.bk{left:0;top:0;width:var(--w);height:var(--h);transform-origin:50% 0;transform:rotateX(90deg);background:var(--c4)}
.b3-caja>.f.iz{left:0;top:0;width:var(--h);height:var(--d);transform-origin:0 50%;transform:rotateY(-90deg);background:var(--c4)}
.b3-caja>.f.de{left:calc(var(--w) - var(--h));top:0;width:var(--h);height:var(--d);transform-origin:100% 50%;transform:rotateY(90deg);background:color-mix(in srgb,var(--tint,var(--c2)) 60%,rgba(255,255,255,.3))}
.b3-caja .f.fr::before,.b3-caja .f.de::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 22px,rgba(20,60,35,.10) 22px 24px)}
.b3-caja .lleno{position:absolute;left:3px;top:3px;width:calc(var(--w) - 6px);height:calc(var(--d) - 6px);--hh:calc((var(--h) - 6px) * var(--p,0));transition:--p .6s}
.b3-caja .lleno .f{border:0;transition:all .6s cubic-bezier(.2,.8,.2,1)}
.b3-caja .lleno .f.tapa{inset:0;background:#4ED48A;transform:translateZ(var(--hh))}
.b3-caja .lleno .f.fr{left:0;top:calc(var(--d) - 6px - var(--hh));width:100%;height:var(--hh);transform-origin:50% 100%;transform:rotateX(-90deg);background:rgba(0,166,83,.75)}
.b3-caja .lleno .f.bk{left:0;top:0;width:100%;height:var(--hh);transform-origin:50% 0;transform:rotateX(90deg);background:#008A44}
.b3-caja .lleno .f.iz{left:0;top:0;width:var(--hh);height:100%;transform-origin:0 50%;transform:rotateY(-90deg);background:#008A44}
.b3-caja .lleno .f.de{left:calc(100% - var(--hh));top:0;width:var(--hh);height:100%;transform-origin:100% 50%;transform:rotateY(90deg);background:#13B866}
.b3-caja.done .lleno .f.tapa{background:#FFE27A} .b3-caja.done .lleno .f.fr{background:#FFCD00} .b3-caja.done .lleno .f.bk,.b3-caja.done .lleno .f.iz{background:#E0B300} .b3-caja.done .lleno .f.de{background:#FFD83A}
.b3-caja.tF .lleno .f.tapa{background:#FF8A96} .b3-caja.tF .lleno .f.fr{background:#E3001B} .b3-caja.tF .lleno .f.bk,.b3-caja.tF .lleno .f.iz{background:#B50016} .b3-caja.tF .lleno .f.de{background:#FF3D52}
.b3-caja:hover .tico{background:#fff;opacity:1}
.b3-caja.activo>.f.tapa::after{content:"";position:absolute;inset:-6px;border-radius:8px;border:3px solid #00A653;animation:b3Pulso 1.4s ease-out infinite}
@keyframes b3Pulso{0%{opacity:.9;transform:scale(1)}100%{opacity:0;transform:scale(1.25)}}
.bb-in,.sp-in{position:absolute;left:0;top:0;transform:rotateZ(calc(var(--rz,-38deg) * -1)) rotateX(calc(var(--rx,58deg) * -1)) translate(-50%,-100%);transform-origin:0 0;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.bb-in{transform:rotateZ(calc(var(--rz,-38deg) * -1)) rotateX(calc(var(--rx,58deg) * -1)) translate(-50%,-50%)}
.b3-esc.drag .bb-in,.b3-esc.drag .sp-in{transition:none}
.bb-in{width:200px;display:flex;align-items:center;gap:9px;background:rgba(255,255,255,.92);border:1px solid rgba(20,60,35,.12);border-radius:14px;padding:7px 11px 9px;box-shadow:0 14px 30px rgba(20,60,35,.2);font-size:17px;line-height:1.2;text-align:left;position:relative}
.bb-in .bi{width:38px;height:38px;border-radius:11px;background:var(--acc-soft);color:var(--brand-d);display:grid;place-items:center;flex:none} .bb-in .bi svg{width:22px;height:22px} .bb-in .bt{min-width:0;flex:1}
.b3-caja.tF .bb-in .bi{background:var(--bad-bg);color:var(--bad)} .b3-caja.done .bb-in .bi{background:#FFF3B8;color:#8A6A00}
.bb-in b{display:block;font-size:17px;font-weight:800;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .bb-in span{display:block;color:var(--muted);font-size:13.5px;margin-top:2px}
.bb-in em{display:block;height:6px;border-radius:99px;background:var(--brand);margin-top:5px;transition:width .6s} .b3-caja.done .bb-in em{background:#E0B300}
.bb-in .tp{display:inline-block;font-style:normal;font-size:11px;font-weight:800;letter-spacing:.4px;border-radius:999px;padding:1px 6px;margin-bottom:3px} .bb-in .tp.f{background:var(--bad-bg);color:var(--bad)} .bb-in .tp.s{background:var(--ok-bg);color:var(--ok)}
/* personajes y decoración */
.b3-sprite{position:absolute;left:0;top:0;width:0;height:0}
.b3-sprite .sp-in{width:110px;display:flex;flex-direction:column;align-items:center;transform:rotateZ(calc(var(--rz,-38deg) * -1)) rotateX(calc(var(--rx,58deg) * -1)) translate(-50%,-100%)}
.b3-sprite .av-svg{width:92px;height:auto;display:block;filter:drop-shadow(0 8px 10px rgba(20,60,35,.25))}
.b3-sprite.deco .av-svg{width:90px}
.b3-sprite.op .av-svg{animation:b3Resp 2.2s ease-in-out infinite;transform-origin:50% 100%} .b3-sprite.op.idle .av-svg{animation:none;opacity:.75;filter:grayscale(.5) drop-shadow(0 8px 10px rgba(20,60,35,.2))}
@keyframes b3Resp{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.03) translateY(-1px)}}
.b3-sprite.op{transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
.b3-sprite .et{background:rgba(20,48,31,.92);color:#fff;border-radius:999px;padding:6px 14px 6px 9px;display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:16px;margin-bottom:6px;box-shadow:0 8px 18px rgba(20,60,35,.25)}
.b3-sprite .et i{width:13px;height:13px;border-radius:50%;flex:none} .b3-sprite .et b{font-weight:800} .b3-sprite .et span{opacity:.8;font-variant-numeric:tabular-nums}
.b3-sprite.idle .et{background:rgba(110,125,115,.85)}
.b3-burbuja{position:absolute;left:50%;bottom:190px;transform:translateX(-50%);background:#FFCD00;color:#2A2000;border-radius:14px;padding:7px 14px;font-size:18px;white-space:nowrap;box-shadow:0 8px 18px rgba(0,0,0,.2);animation:b3Sube 2.4s cubic-bezier(.2,.8,.2,1) both;pointer-events:none}
.b3-burbuja b{font-family:'JetBrains Mono',monospace;font-weight:600;margin-right:4px}
@keyframes b3Sube{0%{opacity:0;transform:translate(-50%,16px) scale(.7)}15%{opacity:1;transform:translate(-50%,0) scale(1.05)}80%{opacity:1;transform:translate(-50%,-26px)}100%{opacity:0;transform:translate(-50%,-50px)}}
/* controles del visor */
.b3-rail{position:absolute;right:14px;top:14px;display:flex;flex-direction:column;gap:6px;z-index:5}
.b3-rail button{width:40px;height:40px;border-radius:50%;border:1px solid var(--glass-line);background:var(--glass);backdrop-filter:blur(10px);box-shadow:var(--shadow);font-size:18px;cursor:pointer;color:var(--fg);transition:transform .15s,background .15s,color .15s}
.b3-rail button:hover{transform:scale(1.1);background:var(--brand);color:#fff} .b3-rail button.on{background:var(--brand);color:#fff}
.b3-ayuda{position:absolute;left:14px;bottom:12px;background:var(--glass);backdrop-filter:blur(10px);border:1px solid var(--glass-line);border-radius:999px;padding:6px 12px;font-size:12px;color:var(--muted);z-index:5}
@media (max-width:800px){.b3-top{gap:8px}.b3-pill{margin:0}.b3-ayuda{display:none}.b3-esc{height:62vh}}

/* ventana de un bloque */
.b3-modal{position:fixed;inset:0;z-index:80;background:rgba(20,48,31,.45);backdrop-filter:blur(6px);display:grid;place-items:center;padding:20px}
.b3m{width:min(1100px,100%);max-height:92vh;background:var(--surface);border-radius:22px;box-shadow:var(--shadow-lg);display:flex;flex-direction:column;overflow:hidden;animation:v4Pop .3s cubic-bezier(.2,.8,.2,1) both}
.b3m-h{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.b3m-h .bi{width:44px;height:44px;border-radius:13px;background:var(--acc-soft);color:var(--brand-d);display:grid;place-items:center} .b3m-h .bi svg{width:26px;height:26px}
.b3m-h>div:not(.seg){display:flex;flex-direction:column;min-width:200px} .b3m-h>div>b{font-size:17px} .b3m-h>div>span{font-size:12.5px;color:var(--muted)}
.b3m-h input[type=search]{border:1px solid var(--line);border-radius:10px;padding:8px 12px;font:inherit;min-width:220px}
.b3m-x{margin-left:auto;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--surface);cursor:pointer;font-size:16px}
.b3m-b{overflow:auto;padding:0 18px 18px} .b3m-b .tbl-wrap{max-height:none}
/* tablero de pared a pantalla completa */
.b3-pared-full{position:fixed;inset:0;z-index:85;background:radial-gradient(1200px 600px at 50% -10%,#1E3A2A 0,#0F1F17 60%,#0A1510 100%);color:#fff;padding:28px 40px;display:flex;flex-direction:column;gap:18px;overflow:auto}
.b3-pared-full .b3m-x{position:absolute;right:22px;top:22px;background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.25);color:#fff;margin:0}
.pw-h{display:flex;align-items:center;gap:16px} .pw-logo{width:64px;height:64px;border-radius:50%;background:#fff;display:grid;place-items:center} .pw-logo img{width:52px}
.pw-h>div{display:flex;flex-direction:column} .pw-h b{font-size:26px;font-weight:800} .pw-h span{opacity:.75;font-size:14px} .pw-h .live{margin-left:auto;color:#7CE3A8;font-size:15px} .pw-h .live i{background:#7CE3A8}
.pw-main{display:grid;grid-template-columns:1.3fr 1fr;gap:24px;align-items:start}
.pw-big>b{font-size:clamp(90px,14vw,180px);font-weight:800;line-height:.95;letter-spacing:-4px;color:#FFCD00;display:block} .pw-big>span{font-size:22px;opacity:.85}
.pw-bar{height:16px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden;margin:16px 0} .pw-bar i{display:block;height:100%;background:linear-gradient(90deg,#00A653,#7CE3A8);border-radius:99px;transition:width .8s}
.pw-eta{display:flex;align-items:center;gap:12px;background:rgba(255,205,0,.14);border:1px solid rgba(255,205,0,.4);border-radius:16px;padding:14px 18px;font-size:20px;font-weight:700;color:#FFE27A} .pw-eta svg{width:30px;height:30px;flex:none} .pw-eta.off{background:rgba(255,120,80,.12);border-color:rgba(255,120,80,.4);color:#FFB09A}
.pw-chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px} .pw-chips span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:8px 14px;font-size:15px} .pw-chips b{font-size:18px;color:#fff}
.pw-ops h3{font-size:14px;letter-spacing:1px;text-transform:uppercase;opacity:.6;margin:0 0 8px}
.pw-op{display:grid;grid-template-columns:14px 1fr auto auto auto;gap:12px;align-items:center;padding:9px 12px;border-radius:12px;background:rgba(255,255,255,.06);margin-bottom:6px;font-size:15px;position:relative;overflow:hidden} .pw-op i{width:14px;height:14px;border-radius:50%} .pw-op b{font-weight:800} .pw-op span{opacity:.8;font-variant-numeric:tabular-nums} .pw-op em{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.08)} .pw-op em u{display:block;height:100%;background:#00A653} .pw-op.act b::after{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:#7CE3A8;margin-left:8px;vertical-align:1px}
.pw-bars{display:grid;grid-template-columns:repeat(auto-fit,minmax(72px,1fr));gap:8px;align-items:end;margin-top:auto}
.pw-b{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center} .pw-b .col{height:110px;width:100%;display:flex;align-items:flex-end;justify-content:center} .pw-b .col i{display:block;width:70%;background:linear-gradient(180deg,#5CE49A,#00A653);border-radius:8px 8px 0 0;transition:height .8s} .pw-b.ok .col i{background:linear-gradient(180deg,#FFE27A,#FFCD00)}
.pw-b .ic{width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,.1);display:grid;place-items:center} .pw-b .ic svg{width:16px;height:16px} .pw-b b{font-size:11px;line-height:1.1;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .pw-b small{font-size:11px;opacity:.7}
.pt-big .pt-eta{display:block;font-size:15px;font-style:normal;color:#FFE27A;letter-spacing:0;font-weight:700;width:100%;margin-top:4px}
.b3-pantalla{cursor:pointer} .b3-pantalla:hover{box-shadow:0 0 0 10px #2E3A33,0 0 0 16px rgba(255,205,0,.5),0 20px 50px rgba(0,0,0,.35)}
@media (max-width:900px){.pw-main{grid-template-columns:1fr}.b3-pared-full{padding:18px}}

/* v7: ventanas de operador y reparto */
.b3m-h .b3-kpis{margin-left:auto;flex-direction:row;justify-content:flex-end} .b3m-h .b3-kpi i.dot{width:10px;height:10px;border-radius:50%;display:inline-block}
.b3m-t{display:flex;align-items:center;gap:10px;padding:10px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.b3m-t input[type=search]{border:1px solid var(--line);border-radius:10px;padding:8px 12px;font:inherit;min-width:220px}
.b3m-t select{border:1px solid var(--line);border-radius:10px;padding:8px 10px;font:inherit;background:var(--surface)}
.b3m-blks{display:flex;gap:8px;flex-wrap:wrap;padding:12px 18px 2px}
.b3m-blk{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:8px 12px;text-align:left;cursor:pointer;min-width:160px;position:relative;overflow:hidden;font:inherit;transition:background .15s,border-color .15s}
.b3m-blk b{display:block;font-size:12.5px} .b3m-blk span{display:block;font-size:12px;color:var(--muted);margin-top:2px} .b3m-blk i{position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--surface-2)} .b3m-blk i u{display:block;height:100%;background:var(--brand)}
.b3m-blk.done i u{background:#E0B300} .b3m-blk.sel{border-color:var(--brand);background:var(--acc-soft)} .b3m-blk:hover{border-color:var(--brand)}
.b3m-h .bi .av-svg.mini{width:34px;height:auto}
.lnk{cursor:pointer;color:inherit;text-decoration:underline dotted var(--muted);text-underline-offset:3px} .lnk:hover{color:var(--brand)}
.chip .cnt{margin-left:5px;font-size:11px;opacity:.8;font-variant-numeric:tabular-nums}
.btn.rep{font-size:12px;padding:4px 9px} .btn.rep.manual{background:#FFF3B8;border-color:#E0B300}
.rep-sel{border:1px solid var(--line);border-radius:8px;padding:3px 6px;font:inherit;font-size:12.5px;background:var(--surface)} .rep-sel.manual{background:#FFF3B8;border-color:#E0B300;font-weight:700}

</style></head><body>
<script>document.body.dataset.unidad='verde';</script>

<div id="splash" class="splash" role="status" aria-live="polite" aria-label="Cargando">
  <div class="sp-card">
    <div class="sp-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="sp-logo"><div class="cl"><img src="data:image/png;base64," alt="Agrococorollo"></div><div class="logo-txt">AGROCOCOROLLO</div><div class="ark"><img src="data:image/png;base64," alt="Arketops"></div></div>
    <div class="sp-bar"><i></i></div>
    <div class="sp-txt">Preparando el Control de Inventarios<span class="sp-dots"><b>.</b><b>.</b><b>.</b></span></div>
    <div class="sp-sub">Agrococorollo · Área de Control</div>
  </div>
  <div class="sp-agro"><svg viewBox="0 0 1000 220" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="agro-svg">
<defs>
<linearGradient id="agSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" stop-opacity="0"/><stop offset="1" stop-color="#FFF4C7" stop-opacity=".9"/></linearGradient>
<linearGradient id="agH1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5CCB8A"/><stop offset="1" stop-color="#2FAE66"/></linearGradient>
<linearGradient id="agH2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2FB868"/><stop offset="1" stop-color="#0E8A48"/></linearGradient>
<linearGradient id="agH3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#128F4D"/><stop offset="1" stop-color="#076B36"/></linearGradient>
<linearGradient id="agSun" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE27A"/><stop offset="1" stop-color="#FFCD00"/></linearGradient>
</defs>
<rect width="1000" height="220" fill="url(#agSky)"/>
<g class="ag-sun"><circle cx="820" cy="78" r="34" fill="url(#agSun)"/><circle cx="820" cy="78" r="46" fill="#FFCD00" opacity=".18"/><circle cx="820" cy="78" r="60" fill="#FFCD00" opacity=".08"/></g>
<g class="ag-cloud" fill="#fff" opacity=".9"><ellipse cx="190" cy="70" rx="46" ry="16"/><circle cx="172" cy="60" r="18"/><circle cx="202" cy="54" r="22"/><circle cx="228" cy="66" r="14"/></g>
