  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.8"/><path d="M15.5 14.5A5 5 0 0 1 21.5 19.5"/>',
  activity: '<path d="M3 12h4l3-8 4 16 3-8h4"/>',
