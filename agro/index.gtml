<g transform="translate(560 128)"><rect x="12" y="0" width="12" height="12" rx="2" fill="#2C3E50"/><path d="M8 12 h20 v10 h-20z" fill="#DDF3E6"/><rect x="4" y="20" width="28" height="42" rx="6" fill="#F3FBF6" stroke="#BFE3CD" stroke-width="2"/><rect x="9" y="30" width="18" height="18" rx="3" fill="#00A653"/><path d="M18 34 v10 M13 39 h10" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
<g transform="translate(130 140)"><path d="M12 50 L34 8" stroke="#8C6A3C" stroke-width="5" stroke-linecap="round"/><path d="M26 4 l16 -2 l-4 16 q-8 2 -12 -4z" fill="#9AA5AE"/><path d="M28 46 L44 14" stroke="#8C6A3C" stroke-width="5" stroke-linecap="round"/><path d="M38 6 q10 -6 14 4 q-2 10 -12 10 q-6 -4 -2 -14z" fill="#9AA5AE"/></g>
<g fill="#FFCD00"><circle cx="372" cy="186" r="3"/><circle cx="384" cy="192" r="2.5"/><circle cx="394" cy="184" r="2"/><circle cx="660" cy="196" r="3"/><circle cx="672" cy="190" r="2.2"/></g>
</svg></div>
</div>

<!-- ============ PORTADA: elegir modo ============ -->
<div id="portada" class="portada" hidden>
  <div class="box">
    <div class="hero4">
      <div class="txt"><span class="saludo"><i></i><span id="pSaludo">Bienvenido</span></span><h1>Control de Inventarios<br>Agrococorollo</h1><p>Toma física por subgrupos con seguimiento en tiempo real: cada celular cuenta y el centro de control ve el avance al instante.</p></div>
      <div class="clogo"><img src="data:image/png;base64," alt="Agrococorollo"></div>
      <div class="agro"><svg viewBox="0 0 1000 220" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="agro-svg">
<defs>
<linearGradient id="agSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" stop-opacity="0"/><stop offset="1" stop-color="#FFF4C7" stop-opacity=".9"/></linearGradient>
<linearGradient id="agH1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5CCB8A"/><stop offset="1" stop-color="#2FAE66"/></linearGradient>
<linearGradient id="agH2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2FB868"/><stop offset="1" stop-color="#0E8A48"/></linearGradient>
<linearGradient id="agH3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#128F4D"/><stop offset="1" stop-color="#076B36"/></linearGradient>
<linearGradient id="agSun" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE27A"/><stop offset="1" stop-color="#FFCD00"/></linearGradient>
</defs>
<rect width="1000" height="220" fill="url(#agSky)"/>
<g class="ag-sun"><circle cx="820" cy="78" r="34" fill="url(#agSun)"/><circle cx="820" cy="78" r="46" fill="#FFCD00" opacity=".18"/><circle cx="820" cy="78" r="60" fill="#FFCD00" opacity=".08"/></g>
<g class="ag-cloud" fill="#fff" opacity=".9"><ellipse cx="190" cy="70" rx="46" ry="16"/><circle cx="172" cy="60" r="18"/><circle cx="202" cy="54" r="22"/><circle cx="228" cy="66" r="14"/></g>
<g class="ag-cloud2" fill="#fff" opacity=".8"><ellipse cx="560" cy="50" rx="36" ry="12"/><circle cx="548" cy="42" r="14"/><circle cx="572" cy="38" r="17"/></g>
<path d="M0 150 C 150 95, 300 100, 420 140 S 700 150, 1000 110 V220 H0z" fill="url(#agH1)"/>
<path d="M0 175 C 200 130, 380 150, 520 170 S 800 160, 1000 150 V220 H0z" fill="url(#agH2)"/>
<path d="M0 200 C 250 170, 500 195, 760 185 S 900 180, 1000 190 V220 H0z" fill="url(#agH3)"/>
<g stroke="#0A6E3A" stroke-width="2" stroke-linecap="round" opacity=".55"><path d="M40 196 q4-10 8 0M60 194 q4-10 8 0M80 196 q4-10 8 0M100 195 q4-10 8 0M120 197 q4-10 8 0"/><path d="M600 192 q4-10 8 0M620 190 q4-10 8 0M640 192 q4-10 8 0M660 191 q4-10 8 0"/></g>
<g class="ag-sprout" transform="translate(300 160)"><path d="M0 40 V8" stroke="#076B36" stroke-width="4" stroke-linecap="round"/><path d="M0 14 C -4 2, -18 0, -24 6 C -16 16, -4 18, 0 14z" fill="#3DBB73"/><path d="M0 20 C 4 8, 18 6, 24 12 C 16 22, 4 24, 0 20z" fill="#2FAE66"/></g>
<g class="ag-sprout2" transform="translate(720 168)"><path d="M0 34 V6" stroke="#076B36" stroke-width="4" stroke-linecap="round"/><path d="M0 12 C -4 0, -16 -2, -20 4 C -14 14, -4 16, 0 12z" fill="#3DBB73"/><path d="M0 18 C 4 6, 16 4, 20 10 C 14 20, 4 22, 0 18z" fill="#2FAE66"/></g>
<g transform="translate(420 118)"><path d="M0 70 L4 14 Q22 4 44 14 L48 70z" fill="#E9D7A5"/><path d="M4 14 Q22 4 44 14" fill="none" stroke="#B89A5A" stroke-width="3"/><path d="M12 10 L10 2 M36 10 L38 2" stroke="#B89A5A" stroke-width="3" stroke-linecap="round"/><rect x="10" y="30" width="28" height="22" rx="4" fill="#00A653"/><path d="M15 41 q4-8 8 0 M23 41 q4-8 8 0" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/><rect x="16" y="44" width="16" height="4" rx="2" fill="#FFCD00"/></g>
<g transform="translate(490 150)"><ellipse cx="24" cy="38" rx="30" ry="8" fill="#0A6E3A" opacity=".25"/><path d="M0 24 Q24 36 48 24 L44 38 Q24 46 4 38z" fill="#E3001B"/><ellipse cx="24" cy="24" rx="24" ry="7" fill="#FF5A3C"/><ellipse cx="24" cy="24" rx="18" ry="4" fill="#B57A3A"/></g>
<g transform="translate(560 128)"><rect x="12" y="0" width="12" height="12" rx="2" fill="#2C3E50"/><path d="M8 12 h20 v10 h-20z" fill="#DDF3E6"/><rect x="4" y="20" width="28" height="42" rx="6" fill="#F3FBF6" stroke="#BFE3CD" stroke-width="2"/><rect x="9" y="30" width="18" height="18" rx="3" fill="#00A653"/><path d="M18 34 v10 M13 39 h10" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
<g transform="translate(130 140)"><path d="M12 50 L34 8" stroke="#8C6A3C" stroke-width="5" stroke-linecap="round"/><path d="M26 4 l16 -2 l-4 16 q-8 2 -12 -4z" fill="#9AA5AE"/><path d="M28 46 L44 14" stroke="#8C6A3C" stroke-width="5" stroke-linecap="round"/><path d="M38 6 q10 -6 14 4 q-2 10 -12 10 q-6 -4 -2 -14z" fill="#9AA5AE"/></g>
<g fill="#FFCD00"><circle cx="372" cy="186" r="3"/><circle cx="384" cy="192" r="2.5"/><circle cx="394" cy="184" r="2"/><circle cx="660" cy="196" r="3"/><circle cx="672" cy="190" r="2.2"/></g>
</svg></div>
    </div>
    <div class="modos">
      <button class="modo" type="button" id="goConteo"><span class="ic" data-ic="scan"></span><h2>Hoja de conteo</h2><p>Para quien cuenta: elige su nombre, ve solo el ítem y la descripción de los bloques que le asignaron y registra cantidades. Funciona desde el celular.</p><span class="cta">Entrar a contar</span></button>
      <button class="modo ctl" type="button" id="goControl"><span class="ic" data-ic="chart"></span><h2>Centro de control</h2><p>Para el encargado y la auditoría: carga de existencias, asignación de subgrupos, avance en vivo, diferencias, segundo y tercer conteo, y plano de ajuste para SIESA.</p><span class="cta">Entrar con clave</span></button>
    </div>
    <div class="pie"><span>Agrococorollo · Punto de venta PV001</span><span><img src="data:image/png;base64," alt="Arketops"> Soluciones Contables y Empresariales · Área de Control · Medellín</span></div>
  </div>
</div>

<!-- ============ CLAVE DEL CENTRO DE CONTROL ============ -->
<div id="gate" class="gate" hidden>
  <div class="panel">
    <div class="hd"><h2 data-pi="lock">Centro de control</h2><button class="btn ghost" type="button" data-go-portada>← Volver</button></div>
    <p class="muted small" style="margin:0 0 10px">Esta área no la ven las personas que cuentan. Ingrese la clave del Área de Control.</p>
    <label class="fld">Clave<input type="password" id="gateKey" inputmode="numeric" autocomplete="off" placeholder="••••"></label>
    <p class="small neg" id="gateMsg" hidden>Clave incorrecta.</p>
    <button class="btn pri" type="button" id="gateOk" style="width:100%;justify-content:center;margin-top:10px">Entrar</button>
  </div>
</div>

<!-- ============ VISTA DE CONTEO (operador) ============ -->
<div id="opApp" class="op" hidden>
  <header class="op-top">
    <div class="r1"><span class="oplogo"><img src="data:image/png;base64," alt=""></span><button class="xbtn" type="button" id="opBack" hidden>←</button><h1 id="opTitle">Hoja de conteo</h1><span class="who" id="opWho"></span><button class="xbtn" type="button" id="opSalir" hidden>Salir</button></div>
    <div class="prog" id="opProg" hidden><div class="bar"><i id="opBar"></i></div><b id="opPct">0 %</b></div>
  </header>
  <div class="op-body" id="opBody"></div>
  <div class="op-foot" id="opFoot" hidden><span class="st" id="opSt"><i></i><span>Guardado</span></span><span id="opFootR"></span></div>
</div>

<!-- ============ CENTRO DE CONTROL ============ -->
<div class="app" id="ctlApp" hidden>
<aside class="side">
  <button class="side-tg" type="button" id="sideTg" title="Contraer / expandir el menú" aria-label="Contraer o expandir el menú">«</button>
  <div class="brand"><div class="clogo"><img src="data:image/png;base64," alt="Agrococorollo"></div><div class="logo-txt"><b>AGROCOCOROLLO</b><span>Control de Inventarios</span></div></div>
  <nav class="navlist" aria-label="Secciones">
    <div class="nav-sec">Conteo</div>
    <button class="nav-item" type="button" data-v="inicio" data-ic="home"><span class="ic"></span><span>Inicio y carga</span></button>
    <button class="nav-item" type="button" data-v="bodega" data-ic="box"><span class="ic"></span><span>Bodega en vivo</span></button>
    <button class="nav-item" type="button" data-v="tablero" data-ic="chart"><span class="ic"></span><span>Tablero en vivo</span></button>
    <button class="nav-item" type="button" data-v="rondas" data-ic="layers"><span class="ic"></span><span>Rondas y asignación</span></button>
    <button class="nav-item" type="button" data-v="cons" data-ic="table"><span class="ic"></span><span>Conteo consolidado</span></button>
    <button class="nav-item" type="button" data-v="revisar" data-ic="alert"><span class="ic"></span><span>Puntos a revisar</span><span class="new" id="navRev" hidden></span></button>
    <div class="nav-sec">Ajustes y soportes</div>
    <button class="nav-item" type="button" data-v="planos" data-ic="file"><span class="ic"></span><span>Plano SIESA</span></button>
    <div class="nav-sec">Datos</div>
    <button class="nav-item" type="button" data-v="datos" data-ic="db"><span class="ic"></span><span>Datos cargados</span></button>
    <button class="nav-item" type="button" data-v="params" data-ic="gear"><span class="ic"></span><span>Parámetros</span></button>
    <div class="nav-sec">Salir</div>
    <button class="nav-item" type="button" data-go-portada data-ic="scan"><span class="ic"></span><span>Ir a la hoja de conteo</span></button>
    <button class="nav-item" type="button" id="navPortal" data-ic="box" title="Portal de inventarios (todas las empresas)"><span class="ic"></span><span>Portal de inventarios</span></button>
  </nav>
  <div class="foot-side">v7.2 · Arketops · Área de Control</div>
</aside>

<div class="main">
<header class="top">
  <div class="tt"><h1 id="pgTitle">Inicio</h1><div class="sub" id="pgSub">Carga de existencias</div></div>
  <div class="tchips" id="tchips"></div>
  <div class="ark" title="Arketops – Soluciones Contables y Empresariales"><img src="data:image/png;base64," alt="Arketops"></div>
</header>
<div id="libBanner" class="banner" hidden></div>

<main class="content">

<!-- ============ INICIO ============ -->
<section class="view" id="v-inicio">
  <div id="saludo"></div>
  <div class="hero">
    <div><h2>Cargue las existencias y arme el inventario</h2><p>Arrastre la consulta de existencias de SIESA (<b>Item · Desc. item · SUBGRUPO · Existencia · Costo prom. unit. (ins)</b>). La app la reconoce por su contenido y arma una hoja de conteo por subgrupo. Los ítems <b>INACTIVO / BLOQUEADO</b> sin existencia quedan por fuera; los que tienen existencia se cuentan marcados. Volver a cargar una consulta nueva <b>actualiza</b> existencias y costos sin perder lo ya contado.</p></div>
    <label class="drop" id="dropAll"><input type="file" id="fAll" accept=".xlsx,.xlsm,.xls,.csv"><span class="drop-ic" data-ic="upload"></span><b>Soltar la consulta de existencias aquí</b><small>o haga clic para buscarla · .xls · .xlsx · .csv</small></label>
  </div>
  <div class="grid g2" style="margin-top:14px">
    <div class="panel"><div class="hd"><h2 data-pi="flag">Inventario en curso</h2><span class="live" id="liveInicio"><i></i>en vivo</span></div><div id="invBox"></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="db">Existencias cargadas</h2><div style="display:flex;gap:6px"><button class="btn" type="button" id="btnRespaldo">Respaldo</button><label class="btn" style="cursor:pointer">Restaurar<input type="file" id="fRest" accept=".json" hidden></label></div></div><div id="cargaBox"></div></div>
  </div>
  <div class="panel" style="margin-top:14px"><div class="hd"><h2 data-pi="info">Cómo se usa <span class="tag">tres pantallas, un solo archivo</span></h2></div>
    <div class="grid g3">
      <div><b>1 · Centro de control</b><p class="muted small" style="margin:4px 0 0">Cargue las existencias, cree los operadores y asigne subgrupos. Abra la ronda 1.</p></div>
      <div><b>2 · Hoja de conteo</b><p class="muted small" style="margin:4px 0 0">Cada operador entra con su nombre desde el celular, ve solo ítem y descripción y registra cantidades. Todo se guarda al instante.</p></div>
      <div><b>3 · Rondas y plano</b><p class="muted small" style="margin:4px 0 0">Al cerrar la ronda 1 (sin nada pendiente) la app arma la ronda 2 con las diferencias, separadas en faltantes y sobrantes; luego la 3. Al final genera el plano de conteo físico para SIESA.</p></div>
    </div></div>
</section>

<!-- ============ BODEGA EN VIVO (3D) ============ -->
<section class="view" id="v-bodega" hidden>
  <div id="b3Vacio" class="empty" hidden><b>Todavía no hay un inventario en curso</b>Cargue las existencias en Inicio y la bodega aparece aquí con una estantería por bloque.</div>
  <div class="b3-top" id="b3Top" hidden>
    <div class="b3-saludo" id="b3Saludo"></div>
    <div class="b3-pill">
      <button type="button" data-b3-ir="tablero" data-pi="chart" title="Tablero en vivo"></button>
      <button type="button" data-b3-ir="rondas" data-pi="layers" title="Rondas y asignación"></button>
      <button type="button" data-b3-ir='cons:{"est":"pend"}' data-pi="clock" title="Ítems sin contar"></button>
      <button type="button" data-b3-ir='cons:{"dif":true}' data-pi="alert" title="Con diferencia"></button>
      <button type="button" data-b3-ir="revisar" data-pi="search" title="Puntos a revisar"></button>
      <button type="button" data-b3-ir="planos" data-pi="file" title="Plano SIESA"></button>
    </div>
    <div class="b3-kpis" id="b3Kpis"></div>
  </div>
  <div class="b3-esc" id="b3Esc" hidden>
    <div class="b3-mundo" id="b3Mundo"></div>
    <div class="b3-rail">
      <button type="button" data-b3="mas" title="Acercar">+</button><button type="button" data-b3="menos" title="Alejar">−</button><button type="button" data-b3="girar" title="Girar 45°">⟳</button><button type="button" data-b3="auto" id="b3Auto" title="Giro automático">◌</button><button type="button" data-b3="reset" title="Vista inicial">⌂</button><button type="button" data-b3="full" title="Pantalla completa">⛶</button>
    </div>
    <div class="b3-ayuda">Arrastre para girar · rueda para acercar · clic en una estantería para ver sus ítems · clic en la pantalla para verla completa</div>
  </div>
</section>

<!-- ============ TABLERO ============ -->
<section class="view" id="v-tablero" hidden>
  <div class="filters sticky-f"><label class="fld">Ronda<select id="t_ronda"></select></label><label class="fld">Bloque<select id="t_sub"></select></label><span class="live" id="liveT"><i></i>actualizando en vivo</span><span class="muted small" id="t_info" style="margin-left:auto"></span></div>
  <div class="kpis kpis-x" id="kpisT"></div>
  <div class="grid g2">
    <div class="panel"><div class="hd"><h2 data-pi="chart">Avance por bloque <span class="tag">clic en una barra para filtrar</span></h2></div><div class="chart-box" style="height:380px"><canvas id="chSub"></canvas></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="users">Operadores <span class="tag">quién va cómo</span></h2></div><div id="tblOps"></div></div>
  </div>
  <div class="grid g2" style="margin-top:14px">
    <div class="panel"><div class="hd"><h2 data-pi="activity">Ritmo del conteo <span class="tag">registros por cada 15 minutos</span></h2></div><div class="chart-box"><canvas id="chRitmo"></canvas></div><div class="muted small" id="ritmo"></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="coins">Diferencias en pesos por bloque <span class="tag">contado − existencia, a costo (ins)</span></h2></div><div class="chart-box"><canvas id="chDif"></canvas></div></div>
  </div>
  <div class="grid g2" style="margin-top:14px">
    <div class="panel"><div class="hd"><h2 data-pi="clock">Ítems sin contar por bloque <span class="tag">la ronda no cierra hasta llegar a cero</span></h2></div><div id="tblPend"></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="list">Últimos registros <span class="tag">lo que acaba de pasar</span></h2></div><div id="tblLog"></div></div>
  </div>
</section>

<!-- ============ RONDAS Y ASIGNACIÓN ============ -->
<section class="view" id="v-rondas" hidden>
  <div class="ronda-strip" id="rondaStrip"></div>
  <div class="grid g2">
    <div class="panel"><div class="hd"><h2 data-pi="users">Operadores</h2><span class="muted small">Nombre y PIN opcional para entrar desde el celular</span></div>
      <div class="opbox"><label class="fld">Nombre<input type="text" id="op_nom" placeholder="Nombre del operador"></label><label class="fld">PIN<input type="text" id="op_pin" inputmode="numeric" maxlength="6" placeholder="opcional" style="width:90px"></label><button class="btn pri" type="button" id="op_add">Agregar</button></div>
      <div id="tblOperadores"></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="layers">Asignación de bloques <span class="tag" id="asigTag"></span></h2><div style="display:flex;gap:6px"><button class="btn" type="button" id="asigAuto" title="Cada bloque completo a una persona, equilibrando el total de ítems">Repartir automático</button><button class="btn" type="button" id="asigTodos" title="Cada bloque dividido por partes iguales entre todos los operadores">Todos en todos</button><button class="btn" type="button" id="asigClear">Limpiar</button></div></div>
      <div id="asigNota"></div><div id="asigTipo"></div><div id="tblAsig"></div></div>
  </div>
</section>

<!-- ============ CONSOLIDADO ============ -->
<section class="view" id="v-cons" hidden>
  <div class="filters">
    <label class="fld">Buscar<input type="search" id="c_q" placeholder="Ítem, referencia o descripción"></label>
    <label class="fld">Subgrupo<select id="c_sub"></select></label>
    <label class="fld">Novedad<select id="c_nov"><option value="">Todas</option><option>FALTANTE</option><option>SOBRANTE</option><option>SIN NOVEDAD</option><option>PENDIENTE</option></select></label>
    <div class="seg" id="c_est"><button type="button" data-v="" class="on">Todos</button><button type="button" data-v="cont">Contados</button><button type="button" data-v="pend">Sin contar</button><button type="button" data-v="dif">Con diferencia</button></div><label class="chk" hidden><input type="checkbox" id="c_dif"></label>
    <div style="margin-left:auto;display:flex;gap:8px"><button class="btn" type="button" id="btnXlsCons">Excel</button><button class="btn" type="button" id="btnPdfCons">PDF</button></div>
  </div>
  <div class="kpis" id="kpisC"></div>
  <div class="panel"><div id="tblCons"></div></div>
</section>

<!-- ============ PUNTOS A REVISAR ============ -->
<section class="view" id="v-revisar" hidden>
  <div class="rev-head" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px"><div id="revScore" class="score"></div><div class="filters" style="margin:0"><div class="seg" id="r_sev"><button type="button" data-v="" class="on">Todos</button><button type="button" data-v="bad">Críticos</button><button type="button" data-v="warn">Atención</button><button type="button" data-v="info">Informativos</button></div></div></div>
  <div id="revList" class="rev-list"></div>
</section>

<!-- ============ PLANO ============ -->
<section class="view" id="v-planos" hidden>
  <div class="grid g2">
    <div class="panel"><div class="hd"><h2 data-pi="file">Plano SIESA · Conteo físico <span class="tag">toda la maestra con la cantidad contada definitiva</span></h2></div>
      <div class="form2">
        <label class="fld">Compañía<input type="number" id="pl_cia" min="1" step="1"></label>
        <label class="fld">Consecutivo del conteo físico (lo da SIESA)<input type="number" id="pl_cons" min="1" step="1" placeholder="Ej. 4"></label>
      </div>
      <div id="plaChecks" class="chk-list"></div>
      <div class="filters" style="margin:12px 0 0"><button class="btn pri" type="button" id="btnPlano">Descargar plano SIESA</button><button class="btn" type="button" id="btnPlanoSop">Soporte en Excel</button></div>
    </div>
    <div class="panel"><div class="hd"><h2 data-pi="upload">Cómo se sube</h2></div>
      <ol class="pasos">
        <li>Finalice el inventario en <b>Rondas y asignación</b>. Cada ítem queda con su <b>último conteo</b> como cantidad definitiva.</li>
        <li>En SIESA genere el <b>conteo físico</b> de la bodega y copie el <b>consecutivo</b> que le asigna.</li>
        <li>Escriba ese número aquí y descargue el plano. Trae las hojas <b>Inicial</b>, <b>Físico</b> y <b>Final</b> de la plantilla del conector, con el ítem completo (con ceros) y la bodega en texto.</li>
        <li>Al importarlo en SIESA indique el conteo definitivo y deje marcada <b>«Si no tiene conteos, asignar cero a los tres conteos»</b>: así los inactivos sin existencia, que no van en el plano, quedan en cero.</li>
      </ol>
      <p class="note">El plano lleva la <b>cantidad contada</b>, no la diferencia: SIESA calcula el ajuste contra su existencia. El «Ajuste neto esperado» de abajo sirve para comparar con lo que SIESA calcule.</p>
    </div>
  </div>
  <div class="kpis" id="kpisPla" style="margin-top:14px"></div>
  <div class="panel"><div class="hd"><h2 data-pi="table">Vista previa · hoja Físico</h2><label class="fld">Buscar<input type="search" id="pl_q" placeholder="Ítem o descripción"></label></div><div id="tblPla"></div></div>
  <details class="panel aj" style="margin-top:14px"><summary><b>Otro formato: ajuste de inventario por diferencias</b> <span class="muted small">(salidas y entradas · para empresas que no usan el conteo físico de SIESA)</span></summary>
    <div class="filters" style="margin-top:12px"><label class="fld">Tipo<select id="p_tipo"><option value="">Salidas y entradas</option><option value="S">Solo salidas (faltantes)</option><option value="E">Solo entradas (sobrantes)</option></select></label><label class="fld">Subgrupo<select id="p_sub"></select></label><button class="btn" type="button" id="p_all">Marcar todo</button><button class="btn" type="button" id="p_none">Desmarcar</button>
      <div style="margin-left:auto;display:flex;gap:8px"><button class="btn" type="button" id="btnSal">Plano de SALIDAS</button><button class="btn" type="button" id="btnEnt">Plano de ENTRADAS</button></div></div>
    <div id="tblAj"></div>
  </details>
</section>

<!-- ============ DATOS ============ -->
<section class="view" id="v-datos" hidden>
  <div class="seg" id="d_tab" style="margin-bottom:12px"><button type="button" data-v="items" class="on">Existencias</button><button type="button" data-v="log">Bitácora de registros</button><button type="button" data-v="excl">Excluidos</button></div>
  <div class="filters"><label class="fld">Buscar<input type="search" id="d_q" placeholder="Ítem, referencia o descripción"></label><span class="muted small" id="d_info"></span><button class="btn" type="button" id="d_xls" style="margin-left:auto">Excel</button></div>
  <div class="panel"><div id="tblDatos"></div></div>
</section>

<!-- ============ PARÁMETROS ============ -->
<section class="view" id="v-params" hidden>
  <div class="grid g2">
    <div class="panel"><div class="hd"><h2 data-pi="gear">Reglas del conteo</h2></div><div class="form2" id="prForm"></div></div>
    <div class="panel"><div class="hd"><h2 data-pi="file">Plano SIESA</h2></div><div class="form2" id="prPlano"></div></div>
  </div>
  <div class="grid g2" style="margin-top:14px">
    <div class="panel"><div class="hd"><h2 data-pi="key">Acceso y firmas</h2></div><div class="form2" id="prAcc"></div></div>
  </div>
</section>

<footer class="sign" aria-label="Firmas del Área de Control">
  <div class="sign-hd"><img src="data:image/png;base64," alt="Arketops"><div><b>Área de Control</b><span>Arketops – Soluciones Contables y Empresariales</span></div></div>
  <div class="sigs" id="sigs"></div>
  <div class="foot"><span>Agrococorollo · Punto de venta PV001</span><span>Arketops – Soluciones Contables y Empresariales · Área de Control · Medellín</span></div>
</footer>
</main>
</div>
</div>

<!-- detalle lateral -->
<div class="drawer-bg" id="drawerBg" hidden></div>
<aside class="drawer" id="drawer" aria-hidden="true" aria-label="Detalle"><button class="drawer-x" type="button" id="drawerX" aria-label="Cerrar">✕</button><div id="drawerBody"></div></aside>

<div class="b3-modal" id="b3Modal" hidden></div>
<div class="b3-pared-full" id="b3Pared" hidden></div>
<div class="modal" id="modal" hidden role="dialog" aria-modal="true"><div class="box" id="modalBox"></div></div>
<div class="busy" id="busy" hidden><div><span class="spin"></span><span id="busyTxt">Procesando…</span></div></div>
<div class="toast" id="toast" hidden role="status"></div>
<script>
/* ---- core/js/utils.js ---- */
/* =====================================================================
   core/js/utils.js · Utilidades base (espacio de nombres window.ARK)
   Formatos es-CO, fechas ISO, almacenamiento seguro, avisos, íconos,
   tabla paginada y envoltura de Chart.js.
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK = G.ARK || {};

  /* ---- DOM ---- */
  ARK.$ = s => document.querySelector(s);
  ARK.$$ = s => Array.from(document.querySelectorAll(s));
  ARK.esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  /* ---- Texto ---- */
  ARK.clean = s => String(s ?? '').replace(/\s+/g, ' ').trim();
  /** Mayúsculas sin tildes: base para comparar nombres de productos, sedes, columnas. */
  ARK.norm = s => ARK.clean(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase();
  ARK.titleCase = s => String(s || '').toLowerCase().replace(/(^|\s)\S/g, m => m.toUpperCase()).replace(/\b(De|Del|Al|En|Y|La|El)\b/g, m => m.toLowerCase());
  /** Número desde texto colombiano: "1.234,5" → 1234.5 ; "1,234.50" → 1234.5 */
  ARK.num = v => {
    if (typeof v === 'number') return v;
    let s = ARK.clean(v).replace(/[^\d,.\-]/g, '');
    if (!s) return 0;
    if (s.includes(',') && s.includes('.')) s = s.lastIndexOf(',') > s.lastIndexOf('.') ? s.replace(/\./g, '').replace(',', '.') : s.replace(/,/g, '');
    else if (s.includes(',')) s = /,\d{3}$/.test(s) && !/,\d{1,2}$/.test(s) ? s.replace(/,/g, '') : s.replace(',', '.');
    const n = parseFloat(s); return isFinite(n) ? n : 0;
  };

  /* ---- Fechas (siempre ISO aaaa-mm-dd internamente) ---- */
  ARK.pad2 = n => String(n).padStart(2, '0');
  ARK.isoDate = d => d ? `${d.getFullYear()}-${ARK.pad2(d.getMonth() + 1)}-${ARK.pad2(d.getDate())}` : '';
  ARK.toD = v => { if (v instanceof Date) return v; if (!v) return null; const m = String(v).match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : new Date(v); };
  ARK.fmtDate = d => { d = ARK.toD(d); return d ? `${ARK.pad2(d.getDate())}/${ARK.pad2(d.getMonth() + 1)}/${d.getFullYear()}` : '—'; };
  ARK.addDays = (d, n) => { const x = new Date(ARK.toD(d)); x.setDate(x.getDate() + n); return x; };
  ARK.MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  /** Semana ISO "2026-S42" para agrupar. */
  ARK.semana = iso => { const d = ARK.toD(iso); if (!d) return ''; const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())); const dn = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - dn); const y0 = new Date(Date.UTC(t.getUTCFullYear(), 0, 1)); return t.getUTCFullYear() + '-S' + ARK.pad2(Math.ceil(((t - y0) / 864e5 + 1) / 7)); };

  /* ---- Números ---- */
  const ok = v => v != null && isFinite(v);
  ARK.fmtN = (v, d = 0) => ok(v) ? v.toLocaleString('es-CO', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—';
  ARK.fmtKg = v => ok(v) ? v.toLocaleString('es-CO', { maximumFractionDigits: 1 }) : '—';
  ARK.fmt$ = v => ok(v) ? (v < 0 ? '−$' : '$') + Math.abs(Math.round(v)).toLocaleString('es-CO') : '—';
  ARK.fmtM = v => { if (!ok(v)) return '—'; const a = Math.abs(v), s = v < 0 ? '−$' : '$'; if (a >= 1e9) return s + (a / 1e9).toLocaleString('es-CO', { maximumFractionDigits: 2 }) + ' mil M'; if (a >= 1e6) return s + (a / 1e6).toLocaleString('es-CO', { maximumFractionDigits: 1 }) + ' M'; return ARK.fmt$(v); };
  ARK.pct = (v, d = 1) => ok(v) ? (v * 100).toLocaleString('es-CO', { minimumFractionDigits: d, maximumFractionDigits: d }) + ' %' : '—';
  /* Unidades de cárnicos */
  ARK.LB_KG = 2.20462;            // libras por kilo
  ARK.KG_CANASTA = 20;            // kg por canasta
  ARK.CANASTAS_ARRUME = 9;        // canastas por arrume → 1 arrume = 180 kg

  /* ---- Almacenamiento local seguro (prefijo por app) ---- */
  ARK.store = (prefijo = 'ark_') => ({
    get(k, d) { try { const v = localStorage.getItem(prefijo + k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
    set(k, v) { try { localStorage.setItem(prefijo + k, JSON.stringify(v)); } catch (e) { ARK.toast('Sin espacio en el navegador: exporte y depure la base histórica.'); } },
    del(k) { try { localStorage.removeItem(prefijo + k); } catch (e) { } }
  });

  /* ---- Avisos ---- */
  ARK.toast = m => {
    let t = document.getElementById('toast');
    if (!t) { t = document.createElement('div'); t.id = 'toast'; t.className = 'toast'; t.setAttribute('role', 'status'); document.body.appendChild(t); }
    t.textContent = m; t.hidden = false; clearTimeout(ARK.toast._t); ARK.toast._t = setTimeout(() => t.hidden = true, 4000);
  };

  /* ---- Íconos (trazos 24×24 estilo Lucide) ---- */
  ARK.ICONS = {
    home: '<path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"/>',
    chart: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>',
    table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/>',
    cal: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    check: '<path d="M1 7h13v10H1z"/><path d="M14 11h4l3 3v3h-7"/><circle cx="5.5" cy="19" r="1.8"/><circle cx="17.5" cy="19" r="1.8"/><path d="M4.5 11.5l2 2 4-4"/>',
    coins: '<ellipse cx="9" cy="6" rx="6" ry="2.5"/><path d="M3 6v4c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V6"/><path d="M9 14.5c-3.3 0-6-1.1-6-2.5v4c0 1.4 2.7 2.5 6 2.5"/><ellipse cx="16" cy="14" rx="5" ry="2.2"/><path d="M11 14v4c0 1.2 2.2 2.2 5 2.2s5-1 5-2.2v-4"/>',
    upload: '<path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v4h16v-4"/>',
    download: '<path d="M12 4v12M7 11l5 5 5-5"/><path d="M4 20h16"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
    box: '<path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>'
  };
  ARK.svg = k => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ARK.ICONS[k] || ''}</svg>`;

  /* ---- Navegación por vistas: <button class="nav-item" data-v="x"> + <section class="view" id="v-x"> ---- */
  ARK.nav = (onShow) => {
    const items = ARK.$$('.nav-item[data-v]');
    items.forEach(b => { const ic = b.querySelector('.ic'); if (ic && b.dataset.ic) ic.innerHTML = ARK.svg(b.dataset.ic); });
    const show = v => {
      items.forEach(b => b.dataset.v === v ? b.setAttribute('aria-current', 'page') : b.removeAttribute('aria-current'));
      ARK.$$('section.view').forEach(s => s.hidden = s.id !== 'v-' + v);
      onShow && onShow(v);
    };
    items.forEach(b => b.addEventListener('click', () => show(b.dataset.v)));
    return show;
  };

  /* ---- Select con opciones ---- */
  ARK.selOpts = (el, vals, todo, keep) => {
    const cur = keep !== undefined ? keep : el.value;
    el.innerHTML = (todo ? `<option value="">${ARK.esc(todo)}</option>` : '') + vals.map(v => `<option>${ARK.esc(v)}</option>`).join('');
    if (vals.includes(cur)) el.value = cur;
  };

  /* ---- Tabla paginada ----
     cols: [{l:'Título', k:'campo', n:true (numérica), f:r=>html, cls:'' }]
     opt:  {size:100, empty:'texto', total:{campo:valor}, maxh:'560px', rowAttr:(r,i)=>'' } */
  const PAGES = {};
  ARK.table = function table(host, cols, rows, opt = {}) {
    const id = host.id, size = opt.size || 100, pages = Math.max(1, Math.ceil(rows.length / size));
    let p = PAGES[id] || 0; if (p >= pages) p = 0; PAGES[id] = p;
    const slice = rows.slice(p * size, p * size + size), esc = ARK.esc;
    const th = `<tr>${cols.map(c => `<th class="${c.n ? 'n' : ''}">${esc(c.l)}</th>`).join('')}</tr>`;
    const body = slice.map((r, i) => `<tr ${opt.rowAttr ? opt.rowAttr(r, i) : ''}>${cols.map(c => `<td class="${c.n ? 'n' : ''} ${c.cls || ''}">${(c.f ? c.f(r) : esc(r[c.k])) ?? ''}</td>`).join('')}</tr>`).join('');
    const foot = opt.total ? `<tr class="tot">${cols.map(c => `<td class="${c.n ? 'n' : ''}">${opt.total[c.k] ?? ''}</td>`).join('')}</tr>` : '';
    host.innerHTML = `<div class="tbl-wrap" style="${opt.maxh ? 'max-height:' + opt.maxh : ''}"><table><thead>${th}</thead><tbody>${body || `<tr><td colspan="${cols.length}" class="muted" style="padding:18px">${esc(opt.empty || 'Sin datos para mostrar.')}</td></tr>`}</tbody>${foot ? '<tfoot>' + foot + '</tfoot>' : ''}</table></div>` +
      (rows.length > size ? `<div class="pager"><span>${ARK.fmtN(p * size + 1)}–${ARK.fmtN(Math.min(rows.length, (p + 1) * size))} de ${ARK.fmtN(rows.length)}</span><button class="btn" data-pg="-1" ${p ? '' : 'disabled'}>Anterior</button><button class="btn" data-pg="1" ${p < pages - 1 ? '' : 'disabled'}>Siguiente</button></div>` : (rows.length ? `<div class="pager"><span>${ARK.fmtN(rows.length)} filas</span></div>` : ''));
    host.querySelectorAll('[data-pg]').forEach(b => b.onclick = () => { PAGES[id] = p + (+b.dataset.pg); table(host, cols, rows, opt); });
    opt.after && opt.after(host, slice);
  };
  ARK.resetPage = id => { PAGES[id] = 0; };
  ARK.pill = (t, mapa = {}) => t ? `<span class="pill ${mapa[t] || 'p-mute'}">${ARK.esc(t)}</span>` : '';

  /* ---- Chart.js con estilo de la marca; no falla si la librería no cargó ---- */
  const CH = {};
  ARK.cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || getComputedStyle(document.body).getPropertyValue(n).trim();
  ARK.chart = (id, cfg) => {
    if (typeof Chart === 'undefined') return null;
    if (CH[id]) CH[id].destroy();
    Chart.defaults.color = ARK.cssv('--muted'); Chart.defaults.borderColor = ARK.cssv('--line'); Chart.defaults.font.family = "'Nunito Sans','Segoe UI',Arial,sans-serif";
    const reduce = G.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    cfg.options = Object.assign({ responsive: true, maintainAspectRatio: false, animation: reduce ? false : { duration: 550, easing: 'easeOutQuart' }, plugins: { legend: { labels: { boxWidth: 12 } } } }, cfg.options || {});
    return CH[id] = new Chart(document.getElementById(id), cfg);
  };
  /** Paleta categórica para gráficos (marca primero, luego tonos de apoyo). */
  ARK.PALETA = ['#CE0E2D', '#002F86', '#F28C1E', '#C9A227', '#17824A', '#6B3FC8', '#0F8A8A', '#8A6E71', '#E6314E', '#2F74F0'];
})(window);

/* ---- core/js/datos.js ---- */
/* =====================================================================
   core/js/datos.js · Lectura estándar de archivos (Excel / CSV) por esquema
   Detecta la fila de encabezados aunque el archivo traiga títulos arriba,
   reconoce los nombres de columna por alias (sin tildes ni mayúsculas) y
   convierte fechas y números al formato interno.

   const ESQ = {
     fecha:    {alias:['FECHA','FECHA DESPACHO','DIA'], tipo:'fecha', req:true},
     sede:     {alias:['SEDE','PUNTO DE VENTA','DESTINO'], req:true},
     producto: {alias:['PRODUCTO','CORTE','DESCRIPCION','REFERENCIA'], req:true},
     kg:       {alias:['KG','KILOS','PESO','CANTIDAD KG'], tipo:'num'},
     valor:    {alias:['VALOR','TOTAL','COSTO TOTAL'], tipo:'num'}
   };
   const {filas, faltan, encabezado} = ARK.leerTabla(matriz, ESQ);
   const matriz = await ARK.leerArchivo(file);   // primera hoja como array de arrays
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK;

  /** Fecha desde serial de Excel, Date, "dd/mm/aaaa", "aaaa-mm-dd" o "dd-mm-aa" → "aaaa-mm-dd". */
  ARK.fechaISO = v => {
    if (v == null || v === '') return '';
    if (v instanceof Date && !isNaN(v)) return ARK.isoDate(v);
    if (typeof v === 'number' && v > 20000 && v < 80000) return ARK.isoDate(new Date(Math.round((v - 25569) * 864e5) + new Date().getTimezoneOffset() * 6e4));
    const s = ARK.clean(v); let m;
    if ((m = s.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/))) return `${m[1]}-${ARK.pad2(m[2])}-${ARK.pad2(m[3])}`;
    if ((m = s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{2,4})/))) { const y = m[3].length === 2 ? '20' + m[3] : m[3]; return `${y}-${ARK.pad2(m[2])}-${ARK.pad2(m[1])}`; }
    return '';
  };

  /** Busca la fila de encabezados (la que más alias reconoce en las primeras 30 filas). */
  ARK.leerTabla = function (matriz, esquema) {
    const N = ARK.norm, campos = Object.keys(esquema);
    const alias = Object.fromEntries(campos.map(c => [c, (esquema[c].alias || [c]).map(N)]));
    let mejor = { fila: -1, mapa: {}, n: 0 };
    for (let i = 0; i < Math.min(30, matriz.length); i++) {
      const fila = (matriz[i] || []).map(N), mapa = {};
      for (const c of campos) {
        let j = fila.findIndex(h => alias[c].includes(h));                         // coincidencia exacta
        if (j < 0) j = fila.findIndex(h => h && alias[c].some(a => h.startsWith(a)));  // o que empiece igual
        if (j >= 0 && !Object.values(mapa).includes(j)) mapa[c] = j;
      }
      const n = Object.keys(mapa).length; if (n > mejor.n) mejor = { fila: i, mapa, n };
    }
    const faltan = campos.filter(c => esquema[c].req && !(c in mejor.mapa));
    if (mejor.fila < 0 || faltan.length) return { filas: [], faltan, encabezado: mejor.fila };
    const filas = [];
    for (let i = mejor.fila + 1; i < matriz.length; i++) {
      const r = matriz[i] || []; if (!r.some(x => x !== '' && x != null)) continue;
      const o = {};
      for (const c of campos) {
        const v = c in mejor.mapa ? r[mejor.mapa[c]] : undefined, t = esquema[c].tipo;
        o[c] = t === 'num' ? ARK.num(v) : t === 'fecha' ? ARK.fechaISO(v) : ARK.clean(v ?? esquema[c].defecto ?? '');
      }
      if (campos.every(c => !esquema[c].req || o[c] !== '' )) filas.push(o);
    }
    return { filas, faltan: [], encabezado: mejor.fila, mapa: mejor.mapa };
  };

  /** Lee .xlsx/.xls/.csv/.txt y devuelve la primera hoja (o la indicada) como array de arrays. */
  ARK.leerArchivo = async function (file, hoja) {
    const nombre = (file.name || '').toLowerCase();
    if (/\.(csv|txt)$/.test(nombre)) {
      const txt = await file.text(), sep = (txt.split('\n')[0].match(/;/g) || []).length > (txt.split('\n')[0].match(/,/g) || []).length ? ';' : ',';
      return txt.split(/\r?\n/).map(l => l.split(sep).map(x => x.replace(/^"|"$/g, '')));
    }
    if (typeof XLSX === 'undefined') throw new Error('No cargó la librería de Excel (revise internet).');
    const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
    const ws = wb.Sheets[hoja && wb.Sheets[hoja] ? hoja : wb.SheetNames[0]];
    return XLSX.utils.sheet_to_json(ws, { header: 1, defval: '', raw: true });
  };

  /** Zona de carga: arrastrar y soltar o clic. ARK.zonaCarga('#slot', async file => {...}) */
  ARK.zonaCarga = function (sel, alCargar) {
    const el = typeof sel === 'string' ? document.querySelector(sel) : sel; if (!el) return;
    const inp = el.querySelector('input[type=file]');
    const ir = async f => { if (!f) return; try { await alCargar(f); el.classList.add('ok'); const st = el.querySelector('.st'); if (st) st.textContent = f.name; } catch (e) { ARK.toast(e.message || String(e)); } };
    if (inp) inp.addEventListener('change', e => { ir(e.target.files[0]); e.target.value = ''; });
    el.addEventListener('dragover', e => { e.preventDefault(); el.classList.add('over'); });
    el.addEventListener('dragleave', () => el.classList.remove('over'));
    el.addEventListener('drop', e => { e.preventDefault(); el.classList.remove('over'); ir(e.dataTransfer.files[0]); });
  };
})(window);

/* ---- core/js/daterange.js ---- */
/* =====================================================================
   core/js/daterange.js · Selector de periodo con calendario desplegable (naranja)
   Igual al de la app Criminal / Planta OR: atajos a la izquierda, dos meses,
   puntos en los días con datos, rango resaltado, "Todo" y "Aplicar".

   const R = ARK.createDateRange({
     clave: 'periodo',                 // se guarda en localStorage (opcional)
     store: ARK.store('miapp_'),       // opcional
     limites: () => ({min:'2026-06-26', max:'2026-10-15', dias:new Set([...])}),  // días con datos
     alCambiar: () => render()
   });
   R.montar(document.getElementById('drp'));   // pinta el botón
   R.en('2026-07-01')  → true/false   (¿la fecha está en el periodo?)
   R.etiqueta(), R.dias(), R.d, R.h, R.fijar(d,h)
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK;
  let ABIERTO = null;
  const cerrar = () => { if (!ABIERTO) return; const p = ABIERTO.querySelector('.drp-pop'); if (p) p.remove(); ABIERTO.classList.remove('open'); ABIERTO = null; };
  document.addEventListener('click', e => { if (ABIERTO && !ABIERTO.contains(e.target)) cerrar(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrar(); });

  ARK.createDateRange = function (o) {
    const st = o.store, key = o.clave;
    const R = Object.assign({ d: null, h: null }, (st && key && st.get(key, null)) || {});
    const { toD, isoDate, fmtDate, addDays, pad2, esc } = ARK;
    const B = () => { const b = o.limites && o.limites(); return b && b.min ? b : null; };
    const guardar = () => { if (st && key) st.set(key, { d: R.d, h: R.h }); };
    const hosts = [];

    R.en = f => !!f && (!R.d || f >= R.d) && (!R.h || f <= R.h);
    R.fijar = (d, h) => { const b = B(); R.d = d; R.h = h; if (b && (!d || d <= b.min) && (!h || h >= b.max)) { R.d = R.h = null; } guardar(); hosts.forEach(pintarBoton); o.alCambiar && o.alCambiar(); };
    R.etiqueta = () => { const b = B(); if (!R.d && !R.h) return b ? `Todo el periodo · ${fmtDate(b.min)} – ${fmtDate(b.max)}` : 'Todo el periodo'; return `${fmtDate(R.d || (b && b.min))} – ${fmtDate(R.h || (b && b.max))}`; };
    R.dias = () => { const b = B(); if (!b) return 1; const lo = toD(R.d && R.d > b.min ? R.d : b.min), hi = toD(R.h && R.h < b.max ? R.h : b.max); return Math.max(1, Math.round((hi - lo) / 864e5) + 1); };

    function pintarBoton(host) {
      host.classList.add('drp'); host.classList.remove('open');
      host.innerHTML = `<button type="button" class="drp-btn" aria-haspopup="dialog">${ARK.svg('cal')}<span>${esc(R.etiqueta())}</span><span class="cv">▾</span></button>`;
      host.querySelector('.drp-btn').onclick = e => { e.stopPropagation(); if (ABIERTO === host) { cerrar(); return; } abrir(host); };
    }
    R.montar = host => { if (!host) return; if (!hosts.includes(host)) hosts.push(host); pintarBoton(host); };

    function abrir(host) {
      cerrar(); const b = B(); if (!b) { ARK.toast('Cargue datos para elegir un periodo.'); return; }
      ABIERTO = host; host.classList.add('open');
      let s = R.d || b.min, e = R.h || b.max, vista = toD(e); vista = new Date(vista.getFullYear(), vista.getMonth() - 1, 1);
      const pop = document.createElement('div'); pop.className = 'drp-pop'; pop.setAttribute('role', 'dialog'); pop.setAttribute('aria-label', 'Seleccionar periodo');
      pop.onclick = ev => ev.stopPropagation(); host.appendChild(pop);
      const mx = toD(b.max), dias = b.dias || new Set();
      const ATAJOS = (o.atajos || [
        ['Todo el periodo', () => [b.min, b.max]],
        ['Última semana', () => [isoDate(addDays(mx, -6)), b.max]],
        ['Últimos 15 días', () => [isoDate(addDays(mx, -14)), b.max]],
        ['Últimos 30 días', () => [isoDate(addDays(mx, -29)), b.max]],
        ['Semana anterior', () => [isoDate(addDays(mx, -13)), isoDate(addDays(mx, -7))]],
        ['Este mes', () => [isoDate(new Date(mx.getFullYear(), mx.getMonth(), 1)), b.max]],
        ['Mes anterior', () => [isoDate(new Date(mx.getFullYear(), mx.getMonth() - 1, 1)), isoDate(new Date(mx.getFullYear(), mx.getMonth(), 0))]]
      ]);
      const mes = (y, m) => {
        const off = (new Date(y, m, 1).getDay() + 6) % 7, nd = new Date(y, m + 1, 0).getDate();
        let h = `<div class="drp-m"><div class="drp-mh"><button type="button" data-nav="-1" aria-label="Mes anterior">‹</button><span>${ARK.MESES[m]} ${y}</span><button type="button" data-nav="1" aria-label="Mes siguiente">›</button></div><div class="drp-g">` + ['L', 'M', 'X', 'J', 'V', 'S', 'D'].map(d => `<span class="dw">${d}</span>`).join('');
        for (let i = 0; i < off; i++) h += '<button class="drp-d out" tabindex="-1" type="button"></button>';
        for (let d = 1; d <= nd; d++) {
          const iso = `${y}-${pad2(m + 1)}-${pad2(d)}`, c = ['drp-d'];
          if (dias.has(iso)) c.push('has'); if (iso < b.min || iso > b.max) c.push('nodata');
          if (s && e && iso > s && iso < e) c.push('in'); if (iso === s) c.push('s'); if (iso === (e || s)) c.push('e');
          h += `<button type="button" class="${c.join(' ')}" data-d="${iso}">${d}</button>`;
        }
        return h + '</div></div>';
      };
      function pintar() {
        const pre = ATAJOS.map(([l, f]) => { const [a, z] = f(); return `<button type="button" class="${a === s && z === e ? 'on' : ''}" data-pre="${esc(l)}">${esc(l)}</button>`; }).join('');
        const m2 = new Date(vista.getFullYear(), vista.getMonth() + 1, 1);
        const n = s && e ? Math.round((toD(e) - toD(s)) / 864e5) + 1 : 1;
        pop.innerHTML = `<div class="drp-pre">${pre}</div><div class="drp-cal"><div class="drp-months">${mes(vista.getFullYear(), vista.getMonth())}${mes(m2.getFullYear(), m2.getMonth())}</div>
          <div class="drp-ft"><span>${s ? `Del <b>${fmtDate(s)}</b> al <b>${fmtDate(e || s)}</b> · ${n} día${n > 1 ? 's' : ''}` : 'Elija el día inicial'}</span><span style="display:flex;gap:8px"><button type="button" class="btn" data-x="todo">Todo</button><button type="button" class="btn or" data-x="ok">Aplicar</button></span></div></div>`;
        pop.querySelectorAll('[data-nav]').forEach(x => x.onclick = () => { vista = new Date(vista.getFullYear(), vista.getMonth() + (+x.dataset.nav), 1); pintar(); });
        // Primer clic = inicio; segundo clic = fin (si es anterior, se invierten); un tercer clic reinicia.
        pop.querySelectorAll('[data-d]').forEach(x => x.onclick = () => { const d = x.dataset.d; if (s && !e) { if (d < s) { e = s; s = d; } else e = d; } else { s = d; e = null; } pintar(); });
        pop.querySelectorAll('[data-pre]').forEach(x => x.onclick = () => { [s, e] = ATAJOS.find(p => p[0] === x.dataset.pre)[1](); const v = toD(e); vista = new Date(v.getFullYear(), v.getMonth() - 1, 1); pintar(); });
        pop.querySelector('[data-x="todo"]').onclick = () => { s = b.min; e = b.max; pintar(); };
        pop.querySelector('[data-x="ok"]').onclick = () => { if (!s) return; cerrar(); R.fijar(s, e || s); };
      }
      pintar();
    }
    return R;
  };
})(window);

/* ---- core/js/timeline.js ---- */
/* =====================================================================
   core/js/timeline.js · Barra de tiempo con selección arrastrable
   Barras diarias; se arrastran los extremos, se mueve la ventana o se
   dibuja una nueva. Al soltar actualiza el mismo periodo del selector.

   ARK.mountTimeline(host, {
     rango:   R,                         // objeto de ARK.createDateRange
     valores: new Map([['2026-07-01', 1234], ...]),   // día ISO → valor
     fmt:     v => ARK.fmtKg(v) + ' kg'  // formato del total (opcional)
   });
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK, REPINTAR = [];
  G.addEventListener('resize', () => REPINTAR.forEach(f => { try { f(); } catch (e) { } }));

  ARK.mountTimeline = function (host, o) {
    if (!host) return;
    const R = o.rango, vals = o.valores || new Map(), fmt = o.fmt || (v => ARK.fmtN(v));
    const claves = [...vals.keys()].filter(Boolean).sort();
    if (!claves.length) { host.innerHTML = ''; host.style.display = 'none'; return; }
    host.style.display = ''; host.classList.add('tl');
    const { toD, isoDate, addDays, fmtDate } = ARK, dias = [];
    for (let d = toD(claves[0]); d <= toD(claves[claves.length - 1]); d = addDays(d, 1)) dias.push(isoDate(d));
    const n = dias.length, vs = dias.map(d => vals.get(d) || 0), mx = Math.max(1e-9, ...vs);
    host.innerHTML = `<div class="tl-bars">${vs.map((v, i) => `<i title="${fmtDate(dias[i])}: ${ARK.esc(fmt(v))}" style="height:${Math.max(4, v / mx * 100)}%"></i>`).join('')}</div><div class="tl-sel"></div>` +
      `<span class="tl-h" data-h="s" role="slider" aria-label="Inicio del periodo"></span><span class="tl-h" data-h="e" role="slider" aria-label="Fin del periodo"></span>` +
      `<div class="tl-ax"><span>${fmtDate(dias[0])}</span><b class="tl-lab"></b><span>${fmtDate(dias[n - 1])}</span></div>`;
    const ix = (iso, def) => { if (!iso) return def; let i = dias.indexOf(iso); if (i < 0) { i = dias.findIndex(d => d >= iso); if (i < 0) i = n - 1; } return i; };
    let si = ix(R.d, 0), ei = ix(R.h, n - 1); if (ei < si) [si, ei] = [ei, si];
    const bars = host.querySelector('.tl-bars'), sel = host.querySelector('.tl-sel'), hs = host.querySelector('[data-h="s"]'), he = host.querySelector('[data-h="e"]'), lab = host.querySelector('.tl-lab'), bi = [...bars.children];
    function pintar() {
      const w = bars.clientWidth; if (!w) return; const cw = w / n;
      sel.style.left = (si * cw) + 'px'; sel.style.width = Math.max(cw, (ei - si + 1) * cw) + 'px'; hs.style.left = (si * cw) + 'px'; he.style.left = ((ei + 1) * cw) + 'px';
      bi.forEach((x, i) => x.classList.toggle('on', i >= si && i <= ei));
      let t = 0; for (let i = si; i <= ei; i++) t += vs[i];
      lab.textContent = `${fmtDate(dias[si])} – ${fmtDate(dias[ei])} · ${ei - si + 1} días · ${fmt(t)}`;
    }
    REPINTAR.push(pintar); requestAnimationFrame(pintar);
    let modo = null, x0 = 0, s0 = 0, e0 = 0;
    const idx = cx => { const r = bars.getBoundingClientRect(); return Math.max(0, Math.min(n - 1, Math.floor((cx - r.left) / (r.width / n)))); };
    host.onpointerdown = ev => { ev.preventDefault(); const i = idx(ev.clientX); modo = ev.target.dataset.h || (ev.target === sel ? 'mover' : 'nuevo'); x0 = i; s0 = si; e0 = ei; if (modo === 'nuevo') si = ei = i; try { host.setPointerCapture(ev.pointerId); } catch (e) { } pintar(); };
    host.onpointermove = ev => {
      if (!modo) return; const i = idx(ev.clientX);
      if (modo === 's') si = Math.min(i, ei); else if (modo === 'e') ei = Math.max(i, si);
      else if (modo === 'mover') { const len = e0 - s0; si = Math.max(0, Math.min(n - 1 - len, s0 + i - x0)); ei = si + len; }
      else { si = Math.min(x0, i); ei = Math.max(x0, i); }
      pintar();
    };
    host.onpointerup = () => { if (!modo) return; modo = null; R.fijar(si === 0 ? null : dias[si], ei === n - 1 ? null : dias[ei]); };
  };
})(window);

/* ---- core/js/pivot.js ---- */
/* =====================================================================
   core/js/pivot.js · Tabla dinámica genérica (arrastrar campos a filas/columnas)
   Arrastrar y soltar (HTML5) + botones F / C / ✕ para celular, selector de
   valor (kilos, libras, arrumes...), % del total y sombreado de calor.

   const PV = ARK.createPivot({
     zonas: '#pvZones', valores: '#pvVal', pct: '#pvPct', tabla: '#pvTbl',
     dims:  {sede:'Sede', prod:'Corte', fam:'Familia', sem:'Semana'},
     vals:  {kg:['Kilos',1], lb:['Libras',0], arr:['Arrumes',1]},   // [etiqueta, decimales]
     inicial: {rows:['prod'], cols:['sede'], val:'kg'},
     dimsOrdenadas: ['sem','dia','mes'],      // columnas que se ordenan alfabéticamente (tiempo)
     registros: () => [{sede:'Bello', prod:'Pulpa', kg:12, lb:26.4, arr:.07}, ...],
     store: ARK.store('app_'), clave: 'pivot'
   });
   PV.render();          // repinta con los registros actuales
   PV.aoa()              // matriz para exportar a Excel
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK;
  ARK.createPivot = function (o) {
    const $ = s => typeof s === 'string' ? document.querySelector(s) : s, esc = ARK.esc;
    const st = o.store, key = o.clave, D = o.dims, V = o.vals, TIEMPO = o.dimsOrdenadas || [];
    const P = Object.assign({ rows: [], cols: [], val: Object.keys(V)[0], pct: false }, o.inicial || {}, (st && key && st.get(key, {})) || {});
    const MAX_C = o.maxColumnas || 40, MAX_F = o.maxFilas || 300;
    let OUT = null;
    const guardar = () => st && key && st.set(key, P);

    function mover(d, a) {
      P.rows = P.rows.filter(x => x !== d); P.cols = P.cols.filter(x => x !== d);
      if (a === 'rows') P.rows.push(d); if (a === 'cols') P.cols.push(d);
      guardar(); render();
    }
    function zonas() {
      const z = $(o.zonas); if (!z) return;
      const usados = new Set([...P.rows, ...P.cols]);
      const chip = (d, zona) => `<span class="pv-c" draggable="true" data-dim="${d}">${esc(D[d])}${zona === 'av'
        ? `<button type="button" data-to="rows" title="Llevar a filas">F</button><button type="button" data-to="cols" title="Llevar a columnas">C</button>`
        : `<button type="button" data-to="av" title="Quitar">✕</button>`}</span>`;
      const zona = (id, t, lista, vacio) => `<div class="pv-z" data-z="${id}"><span>${t}</span><div class="pv-chips">${lista.map(d => chip(d, id)).join('') || `<small class="muted">${vacio}</small>`}</div></div>`;
      z.classList.add('pv-zones');
      z.innerHTML = zona('av', 'Campos disponibles', Object.keys(D).filter(d => !usados.has(d)), 'Todos en uso') + zona('rows', 'Filas', P.rows, 'Arrastre aquí') + zona('cols', 'Columnas', P.cols, 'Arrastre aquí (opcional)');
      z.querySelectorAll('.pv-c').forEach(c => {
        c.addEventListener('dragstart', e => { c.classList.add('drag'); e.dataTransfer.setData('text/pv', c.dataset.dim); e.dataTransfer.effectAllowed = 'move'; });
        c.addEventListener('dragend', () => c.classList.remove('drag'));
        c.querySelectorAll('[data-to]').forEach(b => b.onclick = ev => { ev.stopPropagation(); mover(c.dataset.dim, b.dataset.to); });
      });
      z.querySelectorAll('.pv-z').forEach(zz => {
        zz.addEventListener('dragover', e => { if ([...e.dataTransfer.types].includes('text/pv')) { e.preventDefault(); zz.classList.add('over'); } });
        zz.addEventListener('dragleave', () => zz.classList.remove('over'));
        zz.addEventListener('drop', e => { const d = e.dataTransfer.getData('text/pv'); if (!d) return; e.preventDefault(); zz.classList.remove('over'); mover(d, zz.dataset.z); });
      });
      const sv = $(o.valores);
      if (sv) { sv.classList.add('seg'); sv.innerHTML = Object.entries(V).map(([k, [l]]) => `<button type="button" class="${P.val === k ? 'on' : ''}" data-v="${k}">${esc(l)}</button>`).join('');
        sv.querySelectorAll('button').forEach(b => b.onclick = () => { P.val = b.dataset.v; guardar(); render(); }); }
      const cp = $(o.pct); if (cp) { cp.checked = !!P.pct; cp.onchange = e => { P.pct = e.target.checked; guardar(); render(); }; }
    }
    function render() {
      zonas();
      const host = $(o.tabla); if (!host) return;
      const recs = (o.registros && o.registros()) || [], val = P.val, dec = V[val][1];
      if (!recs.length) { host.innerHTML = '<div class="muted" style="padding:10px">Sin registros en el periodo.</div>'; OUT = null; return; }
      const rk = r => P.rows.map(d => r[d]).join(' · ') || 'Total', ck = r => P.cols.map(d => r[d]).join(' · ') || 'Valor';
      const M = new Map(), rT = new Map(), cT = new Map(); let gT = 0;
      for (const r of recs) { const a = rk(r), b = ck(r), v = +r[val] || 0, k = a + '\u0001' + b; M.set(k, (M.get(k) || 0) + v); rT.set(a, (rT.get(a) || 0) + v); cT.set(b, (cT.get(b) || 0) + v); gT += v; }
      const rKeys = [...rT.keys()].sort((a, b) => rT.get(b) - rT.get(a));
      const tiempo = P.cols.some(d => TIEMPO.includes(d));
      let cKeys = [...cT.keys()].sort((a, b) => tiempo ? a.localeCompare(b) : cT.get(b) - cT.get(a));
      const recorte = cKeys.length > MAX_C; if (recorte) cKeys = cKeys.slice(0, MAX_C);
      const mx = Math.max(1e-9, ...M.values()), f = v => P.pct ? ARK.pct(gT ? v / gT : 0, 1) : ARK.fmtN(v, dec);
      const lab = P.rows.map(d => D[d]).join(' · ') || '—', nomV = V[val][0].toLowerCase();
      host.innerHTML = `<div class="tbl-wrap pv" style="max-height:560px"><table><thead><tr><th>${esc(lab)}</th>${cKeys.map(c => `<th class="n">${esc(c)}</th>`).join('')}<th class="n">Total ${esc(nomV)}</th><th class="n">% del total</th></tr></thead><tbody>` +
        rKeys.slice(0, MAX_F).map(a => `<tr><td><b>${esc(a)}</b></td>${cKeys.map(c => { const v = M.get(a + '\u0001' + c) || 0; return `<td class="n" style="${v ? `background:rgba(242,140,30,${(0.06 + 0.5 * v / mx).toFixed(3)})` : ''}">${v ? f(v) : '·'}</td>`; }).join('')}<td class="n tc">${f(rT.get(a))}</td><td class="n tc">${ARK.pct(gT ? rT.get(a) / gT : 0, 1)}</td></tr>`).join('') +
        `<tr class="tot"><td>Total</td>${cKeys.map(c => `<td class="n">${f(cT.get(c))}</td>`).join('')}<td class="n">${f(gT)}</td><td class="n">100,0 %</td></tr></tbody></table></div>` +
        `<div class="pager"><span>${ARK.fmtN(rKeys.length)} filas${rKeys.length > MAX_F ? ` (se muestran ${MAX_F})` : ''}${recorte ? ` · se muestran ${MAX_C} columnas` : ''} · valor: ${esc(nomV)}${P.pct ? ' en % del total' : ''}</span></div>`;
      OUT = { lab, cKeys, rKeys, M, rT, cT, gT, val };
    }
    return {
      estado: P, render,
      aoa() { if (!OUT) return null; const x = OUT, a = [[x.lab, ...x.cKeys, 'TOTAL']];
        for (const r of x.rKeys) a.push([r, ...x.cKeys.map(c => +(x.M.get(r + '\u0001' + c) || 0).toFixed(2)), +x.rT.get(r).toFixed(2)]);
        a.push(['TOTAL', ...x.cKeys.map(c => +x.cT.get(c).toFixed(2)), +x.gT.toFixed(2)]); return a; },
      nombreValor: () => V[P.val][0]
    };
  };
})(window);

/* ---- core/js/rank.js ---- */
/* =====================================================================
   core/js/rank.js · Ranking con barras animadas y agregación genérica

   const filas = ARK.rankBy(items, {
     clave: it => it.sede,              // agrupa por…
     valor: it => it.kg,                // suma…
     fecha: it => it.fecha,             // opcional: cuenta días distintos
     detalle: it => it.prod             // opcional: top 3 por grupo
   });
   // → [{clave, val, share, n, dias, porDia, top:[...]}, ...] ordenado de mayor a menor

   host.innerHTML = ARK.rankHtml(filas.map(r => ({nm:r.clave, sb:r.top.join(' · '), val:r.val, vs:ARK.pct(r.share)})), r => ARK.fmtKg(r.val)+' kg');
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK;
  ARK.rankBy = function (items, o) {
    const m = new Map(); let tot = 0;
    for (const it of items) {
      const k = o.clave(it); if (k == null || k === '') continue;
      const g = m.get(k) || { clave: k, val: 0, n: 0, dias: new Set(), det: new Map() };
      const v = +o.valor(it) || 0; g.val += v; g.n++; tot += v;
      if (o.fecha) g.dias.add(o.fecha(it));
      if (o.detalle) { const d = o.detalle(it); g.det.set(d, (g.det.get(d) || 0) + v); }
      m.set(k, g);
    }
    return [...m.values()].map(g => ({
      clave: g.clave, val: g.val, n: g.n, share: tot ? g.val / tot : 0,
      dias: g.dias.size, porDia: g.val / Math.max(1, g.dias.size),
      top: [...g.det.entries()].sort((a, b) => b[1] - a[1]).slice(0, o.top || 3).map(x => x[0])
    })).sort((a, b) => b.val - a.val);
  };
  /** filas: [{nm, sb, val, vs}] ; fmtV(r) → texto del valor */
  ARK.rankHtml = function (filas, fmtV) {
    if (!filas.length) return '<div class="muted">Sin datos en el periodo.</div>';
    const mx = Math.max(...filas.map(r => r.val), 1e-9), esc = ARK.esc;
    return '<div class="rank">' + filas.map((r, i) => `<div class="rk"><span class="n">${i + 1}</span><div style="min-width:0"><div class="nm">${esc(r.nm)}</div><div class="sb">${esc(r.sb || '')}</div><div class="bar"><i style="width:${Math.max(2, 100 * r.val / mx)}%;animation-delay:${i * 0.06}s"></i></div></div><div class="v">${fmtV(r)}<small>${esc(r.vs || '')}</small></div></div>`).join('') + '</div>';
  };
  /** Clasificación ABC por participación acumulada (A ≤ 80 %, B ≤ 95 %, C resto). */
  ARK.abc = function (filas, val = r => r.val, cortes = [0.8, 0.95]) {
    const tot = filas.reduce((s, r) => s + val(r), 0) || 1; let acu = 0;
    return [...filas].sort((a, b) => val(b) - val(a)).map(r => { acu += val(r); const p = acu / tot; return Object.assign({}, r, { acum: p, abc: p <= cortes[0] ? 'A' : p <= cortes[1] ? 'B' : 'C' }); });
  };
  /** Indicador circular SVG (0..1). */
  ARK.gauge = function (v, color = 'var(--orange)') {
    const p = Math.max(0, Math.min(1, v || 0)), r = 38, c = 2 * Math.PI * r;
    return `<svg viewBox="0 0 92 92" role="img" aria-label="${ARK.pct(p, 0)}"><circle cx="46" cy="46" r="${r}" fill="none" stroke="var(--line)" stroke-width="9"/><circle cx="46" cy="46" r="${r}" fill="none" stroke="${color}" stroke-width="9" stroke-linecap="round" stroke-dasharray="${(c * p).toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 46 46)"/><text x="46" y="52" text-anchor="middle" font-size="18" font-weight="800" fill="currentColor">${Math.round(p * 100)}%</text></svg>`;
  };
})(window);

/* ---- core/js/export.js ---- */
/* =====================================================================
   core/js/export.js · Descargas: Excel (SheetJS) y PDF horizontal (jsPDF + autotable)
   Membrete: franja del color de la unidad + logo del cliente a la izquierda
   + triángulo blanco con franja dorada y logo Arketops a la derecha.

   ARK.saveWb(wb, 'ARCHIVO.xlsx')
   const doc = ARK.pdf.nuevo();
   ARK.pdf.membrete(doc, {titulo, sub, empresa:'MERCADOS Y CARNES OR S.A.S. · Nit …', rgb:[206,14,45], logo:dataUri, ark:dataUri});
   doc.autoTable({...ARK.pdf.estilo([206,14,45]), head:[[...]], body:[[...]]});
   ARK.pdf.pie(doc, {responsable:'Área de Control', rgb:[206,14,45]});
   ARK.pdf.guardar(doc, 'INFORME.pdf');
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK;
  ARK.saveBlob = function (blob, nombre) {
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = nombre; document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 2000); ARK.toast('Archivo generado: ' + nombre);
  };
  ARK.saveWb = function (wb, nombre) {
    if (typeof XLSX === 'undefined') return ARK.toast('No cargó la librería de Excel (revise internet).');
    const buf = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
    ARK.saveBlob(new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), nombre);
  };
  /** Exporta una matriz (array de arrays) o lista de objetos a una hoja. */
  ARK.exportXlsx = function (datos, hoja, nombre) {
    if (typeof XLSX === 'undefined') return ARK.toast('No cargó la librería de Excel (revise internet).');
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, Array.isArray(datos[0]) ? XLSX.utils.aoa_to_sheet(datos) : XLSX.utils.json_to_sheet(datos), hoja.slice(0, 31));
    ARK.saveWb(wb, nombre);
  };

  const RGB = { rojo: [206, 14, 45], azul: [0, 47, 134], amarillo: [255, 205, 0], blanco: [30, 36, 48] };
  ARK.rgbUnidad = () => RGB[document.body.dataset.unidad] || RGB.rojo;

  ARK.pdf = {
    nuevo(formato = 'letter') {
      if (!G.jspdf || !G.jspdf.jsPDF) throw new Error('No cargó la librería de PDF (revise internet).');
      return new G.jspdf.jsPDF({ orientation: 'landscape', unit: 'mm', format: formato });
    },
    membrete(doc, o) {
      const W = doc.internal.pageSize.getWidth(), rgb = o.rgb || ARK.rgbUnidad();
      const claro = rgb[0] * 0.299 + rgb[1] * 0.587 + rgb[2] * 0.114 > 160;   // amarillo/blanco → texto oscuro
      doc.setFillColor(...rgb); doc.rect(0, 0, W, 24, 'F');
      doc.setFillColor(255, 205, 0); doc.rect(0, 24, W, 1.6, 'F');
      try { if (o.logo) doc.addImage(o.logo, 'PNG', 5, 2, 38, 20.1); } catch (e) { }
      doc.setTextColor(...(claro ? [30, 30, 30] : [255, 255, 255]));
      doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.text(o.titulo || '', 48, 11);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5); doc.text(o.sub || '', 48, 17.5);
      if (o.empresa) { doc.setFontSize(7.5); doc.text(o.empresa, 48, 22); }
      try {   // triángulo dorado + blanco ajustado a la esquina, logo Arketops encima
        doc.setFillColor(227, 190, 69); doc.triangle(W - 84, 0, W - 96, 24, W - 84, 24, 'F'); doc.rect(W - 84, 0, 84, 24, 'F');
        doc.setFillColor(255, 255, 255); doc.triangle(W - 80, 0, W - 91, 24, W - 80, 24, 'F'); doc.rect(W - 80, 0, 80, 24, 'F');
        if (o.ark) doc.addImage(o.ark, 'PNG', W - 68, 4.5, 58, 14.8);
      } catch (e) { }
      doc.setTextColor(40, 26, 28);
    },
    pie(doc, o = {}) {
      const n = doc.getNumberOfPages(), W = doc.internal.pageSize.getWidth(), H = doc.internal.pageSize.getHeight(), rgb = o.rgb || ARK.rgbUnidad();
      for (let i = 1; i <= n; i++) {
        doc.setPage(i); doc.setDrawColor(...rgb); doc.setLineWidth(.4); doc.line(6, H - 10, W - 6, H - 10);
        doc.setFontSize(7.5); doc.setTextColor(120, 100, 102); doc.setFont('helvetica', 'normal');
        doc.text('Elaboró: ' + (o.responsable || 'Área de Control') + ' · ' + ARK.fmtDate(new Date()), 6, H - 6);
        doc.setFont('helvetica', 'bold'); doc.setTextColor(...rgb); doc.text('ARKETOPS', W - 6, H - 6.5, { align: 'right' });
        doc.setFont('helvetica', 'normal'); doc.setFontSize(6.3); doc.setTextColor(120, 100, 102);
        doc.text('Soluciones Contables y Empresariales · Área de Control', W - 6, H - 3.5, { align: 'right' });
        doc.setFontSize(7.5); doc.text('Página ' + i + ' de ' + n, W / 2, H - 6, { align: 'center' });
      }
    },
    estilo(rgb = ARK.rgbUnidad()) {
      return { styles: { font: 'helvetica', fontSize: 7.6, cellPadding: 1.3, textColor: [40, 26, 28] }, headStyles: { fillColor: rgb, textColor: 255, fontStyle: 'bold' }, alternateRowStyles: { fillColor: [248, 243, 242] }, margin: { left: 6, right: 6, top: 30, bottom: 14 } };
    },
    guardar(doc, nombre) { ARK.saveBlob(doc.output('blob'), nombre); }
  };
})(window);

/* ---- core/js/splash.js ---- */
/* =====================================================================
   core/js/splash.js · Retira la pantalla de carga Arketops (#splash)
   Se muestra mínimo 1,9 s para que la animación se aprecie y se retira
   a la fuerza a los 7 s aunque alguna librería externa no responda.
   ARK.splash({min:1900, max:7000})  — se ejecuta solo al cargar este archivo.
   ===================================================================== */
(function (G) {
  'use strict';
  const ARK = G.ARK = G.ARK || {}, t0 = Date.now();
  ARK.splash = function (o = {}) {
    const min = o.min ?? 1900, max = o.max ?? 7000;
    const fuera = () => { const s = document.getElementById('splash'); if (!s || s.classList.contains('out')) return; s.classList.add('out'); setTimeout(() => s.remove(), 750); };
    if (document.readyState === 'complete') setTimeout(fuera, Math.max(0, min - (Date.now() - t0)));
    else G.addEventListener('load', () => setTimeout(fuera, Math.max(0, min - (Date.now() - t0))));
    setTimeout(fuera, max);
    return fuera;
  };
  ARK.splash();
})(window);


</script>
<script>
/* Librerías (Excel, gráficas, PDF): se cargan bajo demanda, después de pintar la pantalla, y solo en el centro de control.
   La hoja de conteo del celular no las necesita y por eso no las descarga. Si alguna falla se avisa y la app sigue. */
window.LIBS = (function(){
  const L = [
    ['XLSX', ['https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js','https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js']],
    ['Chart', ['https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js','https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js']],
    ['jspdf', ['https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js','https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js']],
    ['autotable', ['https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js','https://cdn.jsdelivr.net/npm/jspdf-autotable@3.5.31/dist/jspdf.plugin.autotable.min.js']]
  ];
  const ok = n => n === 'autotable' ? !!(window.jspdf && window.jspdf.jsPDF && ((window.jspdf.jsPDF.API && window.jspdf.jsPDF.API.autoTable) || (window.jspdf.jsPDF.prototype && window.jspdf.jsPDF.prototype.autoTable))) : !!window[n];
  const one = (src) => new Promise(res => { const s = document.createElement('script'); s.src = src; s.async = true; s.onload = () => res(true); s.onerror = () => { s.remove(); res(false); }; document.head.appendChild(s); });
  async function unaLib([n, urls]) { if (ok(n)) return null; for (const u of urls) { if (await one(u) && (ok(n) || n === 'autotable')) return null; } return ok(n) ? null : n; }
  let prom = null, resolver; const listo = new Promise(r => resolver = r);
  function cargar(){
    if (prom) return prom;
    // Chart y XLSX en paralelo; jsPDF y luego autotable (depende de jsPDF)
    prom = Promise.race([(async () => { const [a, b, c] = await Promise.all([unaLib(L[0]), unaLib(L[1]), unaLib(L[2])]); const d = c ? 'autotable' : await unaLib(L[3]); return [a, b, c, d].filter(Boolean); })(),
      new Promise(r => setTimeout(() => r(L.map(x => x[0]).filter(n => !ok(n))), 20000))]);
    prom.then(resolver); return prom;
  }
  return { cargar, listo, ok };
})();

</script>
<script>
/* ---- src/js/01_estado.js ---- */
/* =====================================================================
   01 · Estado, parámetros, almacenamiento y capa de sincronización
   La app tiene una sola fuente de verdad (DB) y una capa SYNC con dos
   implementaciones: «local» (este equipo / varias pestañas) y «remota»
   (servidor compartido para varios celulares). Las vistas nunca tocan
   el almacenamiento directamente: siempre pasan por SYNC.
   ===================================================================== */
'use strict';
const { $, $$, esc, fmtN, fmt$, fmtM, pct, toast } = ARK;
const norm = ARK.norm, clean = ARK.clean, num = ARK.num;
const fmtQ = v => (v == null || !isFinite(v)) ? '—' : v.toLocaleString('es-CO', { maximumFractionDigits: 3 });
const fmtH = ts => { if (!ts) return '—'; const d = new Date(ts); return `${ARK.pad2(d.getDate())}/${ARK.pad2(d.getMonth() + 1)} ${ARK.pad2(d.getHours())}:${ARK.pad2(d.getMinutes())}`; };
const fmtHs = ts => { if (!ts) return '—'; const d = new Date(ts); return `${ARK.pad2(d.getHours())}:${ARK.pad2(d.getMinutes())}:${ARK.pad2(d.getSeconds())}`; };
const hace = ts => { if (!ts) return '—'; const m = Math.round((Date.now() - ts) / 60000); return m < 1 ? 'ahora' : m < 60 ? `hace ${m} min` : m < 1440 ? `hace ${Math.floor(m / 60)} h ${m % 60} min` : fmtH(ts); };
const sgn = v => v < 0 ? 'neg' : v > 0 ? 'pos' : '';
const r3 = v => Math.round(v * 1000) / 1000;
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const ARK_LOGO = ($('.ark img') || {}).src || '';
const subCorta = s => String(s || '').replace(/^\d+\s*-\s*/, '').trim() || 'SIN SUBGRUPO';
const SIN_SUB = 'SIN SUBGRUPO';
Object.assign(ARK.ICONS, {
  alert: '<path d="M12 3 2 20h20z"/><path d="M12 10v4M12 17.5v.5"/>',
  file: '<path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
  db: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
